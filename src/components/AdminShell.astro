---
import Base from '../layouts/Base.astro';
import AdminSidebar from './AdminSidebar.astro';

interface Props {
  title: string;
  current: string;
}
const { title, current } = Astro.props;

// The server-side admin gate (redirecting a non-admin session away before
// any of this renders) lives in each page's own frontmatter, not here —
// Astro.redirect() only actually redirects when returned from a top-level
// page component; called from a nested component like this one it silently
// produces an empty response instead (confirmed, not assumed). See
// requireAdminPage() in lib/auth.ts and every src/pages/admin/*.astro file.
---

<Base title={title}>
  <div class="admin-shell">
    <AdminSidebar current={current} />
    <div class="admin-content">
      <header class="admin-topbar">
        <div class="row" style="align-items: center; gap: 10px;">
          <button type="button" class="admin-sidebar-toggle" id="admin-sidebar-toggle-btn" aria-label="Open menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </button>
          <h1 class="admin-topbar-title">{title}</h1>
        </div>
        <div class="admin-topbar-actions">
          <slot name="actions" />
        </div>
      </header>
      <main class="admin-main">
        <slot />
      </main>
    </div>
  </div>
</Base>

<script>
  document.getElementById('admin-sidebar-toggle-btn')?.addEventListener('click', () => {
    (window as unknown as { __toggleAdminSidebar?: () => void }).__toggleAdminSidebar?.();
  });
</script>
