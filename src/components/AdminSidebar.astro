  users: '<circle cx="9" cy="8" r="3.2"></circle><path d="M3.5 20c0-3.3 2.5-6 5.5-6s5.5 2.7 5.5 6"></path><path d="M16 4.6a3.2 3.2 0 0 1 0 6"></path><path d="M15 14c2.6.3 4.5 2.8 4.5 6"></path>',
