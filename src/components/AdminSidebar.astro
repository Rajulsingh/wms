const groups: Array<{ label: string; links: Array<{ key: string; href: string; label: string }> }> = [
  {
    label: 'Overview',
    links: [{ key: 'today', href: '/dashboard', label: "Today's overview" }]
  },
  {
    label: 'Orders',
    links: [
      { key: 'orders', href: '/admin', label: 'Orders' },
      { key: 'pick-assign', href: '/admin/pick-assign', label: 'Assign picking' },
      { key: 'pick-list', href: '/admin/pick-list', label: 'Pick lists' },
      { key: 'exceptions', href: '/admin/exceptions', label: 'Exceptions' },
      { key: 'returns', href: '/admin/returns', label: 'Returns' }
    ]
  },
  {
    label: 'Inventory',
    links: [
      { key: 'inventory', href: '/admin/inventory', label: 'Inventory' },
      { key: 'inbound', href: '/admin/inbound', label: 'Receiving' }
    ]
  },
  {
    label: 'Fulfillment',
    links: [
      { key: 'ship', href: '/admin/ship', label: 'Ship' },
      { key: 'bulk-ship', href: '/admin/bulk-ship', label: 'Bulk ship' },
      { key: 'schedule-pickup', href: '/admin/schedule-pickup', label: 'Schedule pickup' }
    ]
  },
  {
    label: 'Reports',
    links: [{ key: 'reports', href: '/admin/reports', label: 'Reports' }]
  },
  {
    label: 'Setup',
    links: [
      { key: 'warehouse', href: '/admin/warehouse', label: 'Zones, racks & stations' },
      { key: 'users', href: '/admin/users', label: 'Users' },
      { key: 'settings', href: '/admin/settings', label: 'Settings' },
      { key: 'connect-amazon', href: '/onboarding/connect-amazon', label: 'Connect Amazon' },
      { key: 'leads', href: '/admin/leads', label: 'Signup requests' }
    ]
  }
];
---

<div class="admin-sidebar-backdrop" id="sidebar-backdrop"></div>
<nav class="admin-sidebar" id="admin-sidebar" aria-label="Admin navigation">
  <a class="admin-sidebar-brand" href="/admin" aria-label="Back to home">
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 8 12 3 3 8l9 5 9-5Z"></path>
        <path d="M3 8v8l9 5 9-5V8"></path>
        <path d="M12 13v8"></path>
      </svg>
    </span>
    <span class="brand-text">
      <span class="row" style="align-items: center; gap: 6px;">
        <span class="brand-name">ecomglider</span>
        <span class="pre-alpha-tag">Pre-Alpha</span>
      </span>
      <span class="brand-section">Admin</span>
    </span>
  </a>
  <div class="admin-sidebar-nav">
    {
      groups.map((group) => (
        <div class="admin-sidebar-section">
          <div class="admin-sidebar-section-label">{group.label}</div>
          <div class="admin-sidebar-links">
            {group.links.map((item) => (
              <a href={item.href} class:list={['admin-sidebar-link', { active: current === item.key }]}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[item.key]} />
                <span>{item.label}</span>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
  <div class="admin-sidebar-footer">
    <button type="button" class="admin-sidebar-link admin-sidebar-signout" id="admin-signout-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
      <span>Sign out</span>
    </button>
  </div>
</nav>

<script>
  const sidebar = document.getElementById('admin-sidebar');
  const backdrop = document.getElementById('sidebar-backdrop');

  function closeSidebar() {
    sidebar?.classList.remove('open');
    backdrop?.classList.remove('open');
  }

  function openSidebar() {
    sidebar?.classList.add('open');
    backdrop?.classList.add('open');
  }

  backdrop?.addEventListener('click', closeSidebar);
  sidebar?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeSidebar));

  document.getElementById('admin-signout-btn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.href = '/login';
  });

  document.addEventListener('admin-sidebar-toggle', openSidebar);
  (window as unknown as { __toggleAdminSidebar?: () => void }).__toggleAdminSidebar = () => {
    if (sidebar?.classList.contains('open')) closeSidebar();
    else openSidebar();
  };
</script>
