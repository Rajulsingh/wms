  ship: '<rect x="2" y="7" width="13" height="9" rx="1"></rect><path d="M15 10h3l3 3v3h-6"></path><circle cx="6.5" cy="18" r="1.6"></circle><circle cx="16.5" cy="18" r="1.6"></circle>',
  'bulk-ship': '<rect x="2" y="7" width="13" height="9" rx="1"></rect><path d="M15 10h3l3 3v3h-6"></path><circle cx="6.5" cy="18" r="1.6"></circle><circle cx="16.5" cy="18" r="1.6"></circle><path d="M5 4h7"></path>',
