  orders: '<rect x="3" y="4" width="18" height="4" rx="1"></rect><path d="M4 8v11a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V8"></path><path d="M10 13h4"></path>',
  'pick-list': '<path d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1Z"></path><rect x="5" y="5" width="14" height="16" rx="2"></rect><path d="m9 12 2 2 4-4"></path>',
  'pick-assign': '<circle cx="9" cy="7" r="3"></circle><path d="M2.5 20c0-3.3 2.9-6 6.5-6s6.5 2.7 6.5 6"></path><path d="M17 10.5 19 12.5 23 8.5"></path>',
  exceptions: '<path d="M12 9v4"></path><path d="M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h16a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"></path><circle cx="12" cy="16.2" r="0.1" fill="currentColor" stroke-width="2.5"></circle>',
  inbound: '<path d="M21 12v7a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-7"></path><path d="M3 12h5l2 3h4l2-3h5"></path><path d="M3 12 6 4h12l3 8"></path>',
