---
interface Props {
  section: string;
  class?: string;
  homeHref?: string;
}
const { section, class: extraClass, homeHref = '/packer/home' } = Astro.props;
---

<div class:list={['top-nav', extraClass]}>
  <div class="row" style="align-items: center; gap: 10px;">
    <button type="button" class="packer-sidebar-toggle" id="packer-sidebar-toggle-btn" aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
    <a class="brand" href={homeHref} aria-label="Back to home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 8 12 3 3 8l9 5 9-5Z"></path>
          <path d="M3 8v8l9 5 9-5V8"></path>
          <path d="M12 13v8"></path>
        </svg>
      </span>
      <span class="brand-text">
        <span class="row" style="align-items: center; gap: 6px;">
          <span class="brand-name">ecomglider</span>
          <span class="pre-alpha-tag">Pre-Alpha</span>
        </span>
        <span class="brand-section">{section}</span>
      </span>
    </a>
  </div>
  <div class="row" style="gap: 8px; align-items: center; flex-wrap: wrap;">
    <slot />
  </div>
</div>

<script>
  document.getElementById('packer-sidebar-toggle-btn')?.addEventListener('click', () => {
    (window as unknown as { __togglePackerSidebar?: () => void }).__togglePackerSidebar?.();
  });
</script>
