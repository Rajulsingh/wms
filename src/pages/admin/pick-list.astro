---
import AdminShell from '../../components/AdminShell.astro';
import { getDb } from '../../lib/db';
import { requireAdminPage } from '../../lib/auth';

const redirectTo = await requireAdminPage(Astro, getDb());
if (redirectTo) return Astro.redirect(redirectTo);
---

<AdminShell title="Pick lists" current="pick-list">
  <style>
    @media print {
      .no-print {
        display: none !important;
      }
      body {
        background: #fff;
        color: #000;
      }
    }
  </style>

  <div class="no-print card stack">
    <div class="row" style="flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between;">
      <select id="batch-select" style="width: auto; flex: 1; min-width: 220px;"></select>
      <div class="row" style="width: auto; gap: 8px;">
        <button class="btn" id="print-btn" style="width: auto;">Print pick list</button>
        <button class="btn" id="download-btn" style="width: auto;">Download pick list</button>
      </div>
    </div>
    <div class="scan-row">
      <input type="text" id="scan-input" placeholder="Scan or type a pick list barcode…" />
      <button class="btn" id="scan-btn" type="button" style="width: auto;">Scan</button>
      <video class="scanner" id="scan-video" style="display:none; width: 220px; max-height: 140px;"></video>
    </div>
    <p id="scan-error" style="display:none; color: var(--danger); margin: 0; font-size: 0.85rem;"></p>
  </div>

  <div id="app" class="stack">
    <p>Loading…</p>
  </div>

  <script>
    import { scanOnce, stopScanning } from '../../lib/scanner-client';
    import JsBarcode from 'jsbarcode';
    import { escapeHtml } from '../../lib/ui';

    interface Row {
      pick_task_id: string;
      zone_name: string | null;
      location_code: string;
      sku_code: string;
      sku_name: string;
      msku: string | null;
      image_url: string | null;
      external_order_id: string;
      order_source: string;
      quantity_required: number;
      quantity_picked: number;
      status: string;
    }

    interface Batch {
      id: string;
      status: string;
      created_at: string;
      activated_at: string | null;
      completed_at: string | null;
      assigned_picker_id: string | null;
      assigned_picker_name: string | null;
    }

    // One order is always exactly one pick_batches row (see lib/orders.ts) —
    // when a picker activates several at once (one tap, see activateBatches
    // in lib/picker.ts), they all get the exact same `activated_at` (SQLite
    // fixes datetime('now') for the whole UPDATE statement). Grouping on
    // (picker, activated_at) turns what would otherwise be one dropdown row
    // per order back into one row per actual picking trip — the printed/
    // downloaded list, barcode, and stepper all now represent the whole
    // group, not a single order. `orderCount` is just `batchIds.length`
    // since that one-batch-per-order invariant means no separate query is
    // needed to know how many orders are in a group.
    interface Session {
      key: string;
      primaryBatchId: string; // barcode/scan/URL identity for the whole group — first batch, deterministically
      batchIds: string[];
      pickerName: string | null;
      activatedAt: string;
      createdAt: string; // earliest member's created_at
      completedAt: string | null; // latest member's completed_at, only set once every member is completed
      status: 'in_progress' | 'completed';
      orderCount: number;
    }

    const app = document.getElementById('app')!;
    const select = document.getElementById('batch-select') as unknown as HTMLSelectElement;
    const scanInput = document.getElementById('scan-input') as HTMLInputElement;
    const scanError = document.getElementById('scan-error') as HTMLParagraphElement;
    let warehouseId = '';
    let batches: Batch[] = [];
    let sessions: Session[] = [];
    let currentRows: Row[] = [];
    let currentSession: Session | null = null;

    // A batch created before the activated_at column existed (or never
    // re-activated since) has no shared timestamp to group on — treated as
    // its own single-order session rather than lumping every such legacy row
    // with a null key into one giant fake group.
    function computeSessions(source: Batch[]): Session[] {
      const groups = new Map<string, Batch[]>();
      for (const b of source) {
        const key = `${b.assigned_picker_id ?? 'unassigned'}__${b.activated_at ?? b.id}`;
        const list = groups.get(key);
        if (list) list.push(b);
        else groups.set(key, [b]);
      }
      return Array.from(groups.values())
        .map((members): Session => {
          const sorted = [...members].sort((a, b) => a.created_at.localeCompare(b.created_at) || a.id.localeCompare(b.id));
          const primary = sorted[0];
          const allCompleted = members.every((m) => m.status === 'completed');
          const completedAts = members.map((m) => m.completed_at).filter((v): v is string => !!v).sort();
          return {
            key: `${primary.assigned_picker_id ?? 'unassigned'}__${primary.activated_at ?? primary.id}`,
            primaryBatchId: primary.id,
            batchIds: sorted.map((m) => m.id),
            pickerName: primary.assigned_picker_name,
            activatedAt: primary.activated_at ?? primary.created_at,
            createdAt: sorted[0].created_at,
            completedAt: allCompleted && completedAts.length ? completedAts[completedAts.length - 1] : null,
            status: allCompleted ? 'completed' : 'in_progress',
            orderCount: members.length
          };
        })
        .sort((a, b) => b.activatedAt.localeCompare(a.activatedAt));
    }

    async function api(path: string, body?: unknown) {
      const res = await fetch(path, {
        method: body === undefined ? 'GET' : 'POST',
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    const STATUS_STYLE: Record<string, string> = {
      pending: 'status-neutral',
      picked: 'status-success',
      damaged: 'status-warning',
      short: 'status-warning'
    };
    function statusPill(status: string): string {
      const cls = STATUS_STYLE[status] ?? 'status-neutral';
      return `<span class="status-pill ${cls}">${status}</span>`;
    }

    interface SkuLocationGroup {
      key: string;
      zone_name: string | null;
      location_code: string;
      sku_code: string;
      sku_name: string;
      msku: string | null;
      image_url: string | null;
      quantity_required: number;
      quantity_picked: number;
      status: string;
      orderBreakdown: string;
    }

    // Same grouping the picker's own app screen uses — same SKU at the same
    // bin collapses into one line across every order that needs it, so the
    // printed sheet matches what a picker actually works from instead of
    // showing four separate rows for one bin visit. See HANDOFF.md.
    function groupRowsBySkuLocation(rows: Row[]): SkuLocationGroup[] {
      const byKey = new Map<string, Row[]>();
      for (const r of rows) {
        const key = `${r.location_code}__${r.sku_code}`;
        const existing = byKey.get(key);
        if (existing) existing.push(r);
        else byKey.set(key, [r]);
      }

      return Array.from(byKey.entries()).map(([key, memberRows]) => {
        const first = memberRows[0];
        const status = memberRows.every((r) => r.status === 'picked')
          ? 'picked'
          : memberRows.some((r) => r.status === 'pending')
            ? 'pending'
            : memberRows.some((r) => r.status === 'damaged')
              ? 'damaged'
              : 'short';
        return {
          key,
          zone_name: first.zone_name,
          location_code: first.location_code,
          sku_code: first.sku_code,
          sku_name: first.sku_name,
          msku: first.msku,
          image_url: first.image_url,
          quantity_required: memberRows.reduce((sum, r) => sum + r.quantity_required, 0),
          quantity_picked: memberRows.reduce((sum, r) => sum + r.quantity_picked, 0),
          status,
          orderBreakdown: memberRows.map((r) => `${r.external_order_id} ×${r.quantity_required}`).join(', ')
        };
      });
    }

    const CHECK_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"></path></svg>';

    // Lifecycle for the whole group (in_progress -> completed once every
    // member order is done) — packing and shipping happen per order/
    // shipment in this schema, not per batch, so a literal Create/Pack/Ship
    // stepper would claim a stage that isn't true for every order in the
    // group yet.
    function renderStepper(session: Session): string {
      const created = new Date(session.createdAt).toLocaleString();
      const pickingDone = session.status === 'completed';

      const step = (label: string, meta: string, done: boolean, current: boolean, first = false) => `
        <div class="stepper-step ${done ? 'done' : current ? 'current' : ''}">
          ${!first ? '<div class="stepper-step-line"></div>' : ''}
          <div class="stepper-step-node">${done ? CHECK_ICON : ''}</div>
          <span class="stepper-step-label">${label}</span>
          <span class="stepper-step-meta">${meta}</span>
        </div>`;

      return `<div class="stepper-bar">
        ${step('Create', created, true, false, true)}
        ${step('Picking', pickingDone ? 'Complete' : 'In progress', pickingDone, !pickingDone)}
        ${step('Picked', pickingDone ? new Date(session.completedAt ?? session.createdAt).toLocaleString() : 'Not yet', pickingDone, false)}
      </div>`;
    }

    function renderBarcode(batchId: string): string {
      return `<div class="barcode-wrap">
        <svg id="batch-barcode"></svg>
        <span class="barcode-id">${batchId}</span>
      </div>`;
    }

    async function boot() {
      const me = await api('/api/auth/me');
      if (!me.user) {
        window.location.href = '/login';
        return;
      }
      if (me.user.role !== 'admin') {
        app.innerHTML = `<p>This account is a "${me.user.role}", not an admin.</p>`;
        return;
      }
      warehouseId = me.user.warehouseId;

      batches = await api(`/api/admin/batches?warehouseId=${warehouseId}`);
      sessions = computeSessions(batches);
      const params = new URLSearchParams(window.location.search);
      // Kept as `batchId` for backward compatibility with anything that might
      // still link here by a single order's batch id — resolved to whichever
      // session that batch now belongs to.
      const preselectBatchId = params.get('batchId');
      const preselect = preselectBatchId ? sessions.find((s) => s.batchIds.includes(preselectBatchId))?.key : null;

      select.innerHTML = sessions
        .map((s) => `<option value="${s.key}">${s.activatedAt} · ${escapeHtml(s.pickerName ?? '—')} · ${s.orderCount} order${s.orderCount === 1 ? '' : 's'} · ${s.status}</option>`)
        .join('');
      if (preselect) select.value = preselect;
      select.addEventListener('change', () => loadSession(select.value));

      if (sessions.length) await loadSession(select.value);
      else app.innerHTML = '<p>No pick lists yet — one appears here as soon as a picker activates it.</p>';
    }

    async function loadSession(sessionKey: string) {
      if (!sessionKey) return;
      const session = sessions.find((s) => s.key === sessionKey);
      if (!session) return;
      currentSession = session;
      const rows: Row[] = await api(`/api/picker/pick-list?batchIds=${session.batchIds.join(',')}`);
      currentRows = rows;
      const orders = new Set(rows.map((r) => r.external_order_id));
      const skus = new Set(rows.map((r) => r.sku_code));
      const units = rows.reduce((sum, r) => sum + r.quantity_required, 0);

      app.innerHTML = `
        <div class="card">
          <div class="row" style="justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
            <div class="stack" style="gap: 4px;">
              <span class="eyebrow">Pick list ID</span>
              <span class="big-label" style="font-size: 1.4rem;">${session.primaryBatchId}</span>
            </div>
            ${renderBarcode(session.primaryBatchId)}
          </div>
          ${renderStepper(session)}
          <div class="no-print row" style="margin-top: 14px; gap: 10px; align-items: center; flex-wrap: wrap;">
            <span class="eyebrow" style="flex: 0 0 auto;">Picked by</span>
            <span class="pill">${escapeHtml(session.pickerName ?? '—')}</span>
          </div>
        </div>
        <div class="row no-print" style="gap: 16px;">
          <span class="pill">Orders: ${orders.size}</span>
          <span class="pill">SKUs: ${skus.size}</span>
          <span class="pill">Units: ${units}</span>
        </div>
        <div class="table-scroll"><table>
          <thead>
            <tr><th>Zone</th><th>Bin</th><th>Product</th><th>MSKU</th><th>Units</th><th>Orders</th><th>Status</th></tr>
          </thead>
          <tbody>
            ${groupRowsBySkuLocation(rows)
              .map(
                (g) => `<tr>
                  <td>${escapeHtml(g.zone_name ?? '—')}</td>
                  <td>${escapeHtml(g.location_code)}</td>
                  <td>
                    <div class="row" style="align-items:center; gap:10px;">
                      ${g.image_url ? `<img class="table-thumb" src="${escapeHtml(g.image_url)}" alt="" />` : ''}
                      <span>${escapeHtml(g.sku_name)}</span>
                    </div>
                  </td>
                  <td>${g.msku ? `<strong>${escapeHtml(g.msku)}</strong>` : escapeHtml(g.sku_code)}${g.msku ? `<br><span style="font-size: 0.75rem; color: var(--muted);">${escapeHtml(g.sku_code)}</span>` : ''}</td>
                  <td>${g.quantity_picked}/${g.quantity_required}</td>
                  <td style="font-size: 0.82rem; color: var(--muted);">${escapeHtml(g.orderBreakdown)}</td>
                  <td>${statusPill(g.status)}</td>
                </tr>`
              )
              .join('')}
          </tbody>
        </table></div>`;

      const svg = document.getElementById('batch-barcode');
      if (svg) {
        try {
          JsBarcode(svg, session.primaryBatchId, { format: 'CODE128', displayValue: false, height: 40, margin: 0 });
        } catch {
          // Batch IDs are UUIDs (any ASCII), Code128 handles them fine — this is just a defensive no-op if it ever can't.
        }
      }
    }

    // A scanned/typed barcode is always one specific order's raw batch id
    // (that's what's printed/encoded — see renderBarcode above), so this
    // resolves it to whichever session that order ended up grouped into,
    // not a session key directly.
    function openBatch(rawId: string) {
      const id = rawId.trim();
      const session = sessions.find((s) => s.batchIds.includes(id));
      if (!session) {
        scanError.textContent = `No pick list found for "${id}".`;
        scanError.style.display = 'block';
        return;
      }
      scanError.style.display = 'none';
      select.value = session.key;
      loadSession(session.key);
    }

    scanInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && scanInput.value.trim()) {
        openBatch(scanInput.value);
        scanInput.value = '';
      }
    });

    document.getElementById('scan-btn')?.addEventListener('click', async () => {
      const video = document.getElementById('scan-video') as HTMLVideoElement;
      video.style.display = 'block';
      try {
        const text = await scanOnce(video);
        video.style.display = 'none';
        openBatch(text);
      } catch {
        video.style.display = 'none';
        stopScanning();
        scanError.textContent = 'Could not open camera — type the ID instead.';
        scanError.style.display = 'block';
      }
    });

    document.getElementById('print-btn')?.addEventListener('click', () => window.print());

    document.getElementById('download-btn')?.addEventListener('click', () => {
      if (!currentRows.length) return;
      const header = ['Zone', 'Bin', 'Product', 'MSKU', 'SKU', 'Order', 'Units', 'Status'];
      const csvEscape = (v: string) => `"${v.replace(/"/g, '""')}"`;
      const lines = [
        header.join(','),
        ...currentRows.map((r) =>
          [r.zone_name ?? '', r.location_code, r.sku_name, r.msku ?? '', r.sku_code, r.external_order_id, String(r.quantity_required), r.status].map(csvEscape).join(',')
        )
      ];
      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `pick-list-${currentSession?.primaryBatchId ?? 'session'}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    boot();
  </script>
</AdminShell>
