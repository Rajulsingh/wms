---
import AdminShell from '../../components/AdminShell.astro';
---

<AdminShell title="Orders" current="orders">
  <span class="pill" id="user-pill" slot="actions">…</span>

  <div class="row">
    <button class="btn btn-primary" id="import-btn" style="width: auto;">Import from Amazon</button>
    <button class="btn" id="batch-btn" style="width: auto;">Create pick batch</button>
  </div>
  <div id="action-result" class="banner" style="display:none;"></div>

  <div class="stat-grid" id="stat-grid"></div>

  <div class="card stack">
    <h2>Orders</h2>
    <div class="row" id="status-tabs" style="flex-wrap: wrap; gap: 6px;"></div>
    <div id="orders-table">Loading…</div>
  </div>

  <script>
    interface OrderRow {
      id: string;
      external_order_id: string;
      source: string;
      status: string;
      customer_name: string | null;
      created_at: string;
      first_item_name: string | null;
      first_item_image: string | null;
      item_count: number;
      order_value: number | null;
    }

    function productSummary(o: OrderRow): string {
      if (!o.first_item_name) return 'No items';
      return o.item_count > 1 ? `${o.first_item_name} <span style="color: var(--muted);">+${o.item_count - 1} more</span>` : o.first_item_name;
    }

    function orderValue(o: OrderRow): string {
      return o.order_value ? `₹${o.order_value.toFixed(2)}` : '—';
    }

    // Amazon's Merchant Fulfillment label can be bought any time once the order exists — matches the "labels purchased upfront" workflow, not gated on picking/packing being done first.
    function shipAction(o: OrderRow): string {
      if (o.source !== 'amazon') return '';
      if (o.status === 'ready_to_ship' || o.status === 'shipped') return '<span style="color: var(--success); font-weight: 700;">Shipped</span>';
      return `<a href="/admin/ship?orderId=${o.id}" class="order-card-ship">Ship →</a>`;
    }

    const STATUS_STYLE: Record<string, string> = {
      pending: 'status-neutral',
      batched: 'status-progress',
      picking: 'status-progress',
      packing: 'status-progress',
      ready_to_ship: 'status-warning',
      shipped: 'status-success'
    };

    function statusPill(status: string): string {
      const cls = STATUS_STYLE[status] ?? 'status-neutral';
      return `<span class="status-pill ${cls}">${status.replace(/_/g, ' ')}</span>`;
    }

    const userPill = document.getElementById('user-pill')!;
    const actionResult = document.getElementById('action-result') as HTMLDivElement;
    const ordersTable = document.getElementById('orders-table')!;
    const statusTabs = document.getElementById('status-tabs')!;
    const statGrid = document.getElementById('stat-grid')!;
    let warehouseId = '';
    let cartId = '';
    let allOrders: OrderRow[] = [];
    let skuCount: number | null = null;
    let activeTab = 'all';

    // Standard-WMS-style status buckets — our internal status column has more
    // granularity (picking/picked/packing/packed) than a floor manager needs
    // to filter by day-to-day, so these group several statuses under one tab.
    const STATUS_GROUPS: Record<string, string[]> = {
      all: [],
      new: ['pending', 'allocated'],
      processing: ['batched', 'picking', 'picked', 'packing', 'packed', 'partial'],
      ready: ['ready_to_ship'],
      shipped: ['shipped'],
      cancelled: ['cancelled']
    };
    const TAB_LABELS: Record<string, string> = {
      all: 'All',
      new: 'New',
      processing: 'Processing',
      ready: 'Ready to ship',
      shipped: 'Shipped',
      cancelled: 'Cancelled'
    };

    async function api(path: string, body?: unknown) {
      const res = await fetch(path, {
        method: body === undefined ? 'GET' : 'POST',
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    function showResult(msg: string, kind: 'success' | 'danger' = 'success') {
      actionResult.className = `banner banner-${kind}`;
      actionResult.innerHTML = msg;
      actionResult.style.display = 'block';
    }

    function renderStats() {
      const count = (key: string) => allOrders.filter((o) => STATUS_GROUPS[key].includes(o.status)).length;
      const cards: Array<{ label: string; value: number | string; accent: string }> = [
        { label: 'New orders', value: count('new'), accent: 'stat-card-accent-neutral' },
        { label: 'Processing', value: count('processing'), accent: 'stat-card-accent-progress' },
        { label: 'Ready to ship', value: count('ready'), accent: 'stat-card-accent-warning' },
        { label: 'Shipped', value: count('shipped'), accent: 'stat-card-accent-success' },
        { label: 'Current SKUs', value: skuCount ?? '—', accent: 'stat-card-accent-neutral' }
      ];
      statGrid.innerHTML = cards
        .map(
          (c) => `<div class="stat-card ${c.accent}">
            <span class="stat-card-value">${c.value}</span>
            <span class="stat-card-label">${c.label}</span>
          </div>`
        )
        .join('');
    }

    function renderTabs() {
      statusTabs.innerHTML = Object.keys(STATUS_GROUPS)
        .map((key) => {
          const count = key === 'all' ? allOrders.length : allOrders.filter((o) => STATUS_GROUPS[key].includes(o.status)).length;
          return `<button type="button" class="pill tab-pill${key === activeTab ? ' active' : ''}" data-tab="${key}">${TAB_LABELS[key]}${count ? ` (${count})` : ''}</button>`;
        })
        .join('');

      statusTabs.querySelectorAll('button[data-tab]').forEach((btn) => {
        btn.addEventListener('click', () => {
          activeTab = (btn as HTMLButtonElement).dataset.tab!;
          renderTabs();
          renderOrders();
        });
      });
    }

    function renderOrders() {
      const filtered = activeTab === 'all' ? allOrders : allOrders.filter((o) => STATUS_GROUPS[activeTab].includes(o.status));

      if (!filtered.length) {
        ordersTable.innerHTML = `<p>No ${activeTab === 'all' ? '' : TAB_LABELS[activeTab].toLowerCase() + ' '}orders${activeTab === 'all' ? ' yet' : ''}.</p>`;
        return;
      }
      ordersTable.innerHTML = `
        <div class="table-scroll"><table>
          <thead>
            <tr><th>Order ID</th><th>Product</th><th>Status</th><th>Source</th><th>Value</th><th></th></tr>
          </thead>
          <tbody>
            ${filtered
              .map(
                (o) => `<tr>
                  <td style="font-weight:700; font-variant-numeric: tabular-nums; white-space: nowrap;">${o.external_order_id}</td>
                  <td>
                    <div class="row" style="align-items:center; gap:10px;">
                      ${o.first_item_image ? `<img class="table-thumb" src="${o.first_item_image}" alt="" />` : ''}
                      <span class="truncate-cell" title="${(o.first_item_name ?? '').replace(/"/g, '&quot;')}">${productSummary(o)}</span>
                    </div>
                  </td>
                  <td>${statusPill(o.status)}</td>
                  <td style="white-space: nowrap;">${o.source}${o.customer_name ? ' · ' + o.customer_name : ''}</td>
                  <td style="font-weight:700; white-space: nowrap;">${orderValue(o)}</td>
                  <td style="white-space: nowrap;">${shipAction(o)}</td>
                </tr>`
              )
              .join('')}
          </tbody>
        </table></div>`;
    }

    async function loadOrders() {
      allOrders = await api(`/api/admin/orders?warehouseId=${warehouseId}`);
      renderStats();
      renderTabs();
      renderOrders();
    }

    async function loadSkuCount() {
      try {
        const report = await api(`/api/admin/reports?warehouseId=${warehouseId}`);
        skuCount = Array.isArray(report.stock) ? report.stock.length : null;
      } catch {
        skuCount = null;
      }
      renderStats();
    }

    async function boot() {
      const me = await api('/api/auth/me');
      if (!me.user) {
        window.location.href = '/login';
        return;
      }
      if (me.user.role !== 'admin') {
        document.body.innerHTML = `<div class="screen"><p>This account is a "${me.user.role}", not an admin.</p></div>`;
        return;
      }
      userPill.textContent = me.user.name;
      warehouseId = me.user.warehouseId;

      const carts = await api(`/api/admin/carts?warehouseId=${warehouseId}`);
      cartId = carts[0]?.id ?? '';

      await loadOrders();
      loadSkuCount();

      // Orders keep arriving (Amazon imports, manual entry) and their status
      // keeps changing as picking/packing happens — refresh automatically so
      // admin doesn't have to keep reloading to see what needs a label next.
      setInterval(() => {
        if (!document.hidden) loadOrders();
      }, 12000);
    }

    document.getElementById('import-btn')?.addEventListener('click', async () => {
      try {
        const summary = await api('/api/admin/import-amazon-orders', { warehouseId, sinceHours: 72 });
        let msg = `Imported ${summary.imported}, skipped ${summary.skipped}${summary.newSkusCreated.length ? `, ${summary.newSkusCreated.length} new SKUs pulled from Amazon's catalog` : ''}.`;
        if (summary.batch?.batchId) {
          msg += ` Auto-batched: ${summary.batch.orderCount} orders, ${summary.batch.taskCount} pick tasks. <a href="/admin/pick-list?batchId=${summary.batch.batchId}">View pick list</a>`;
        } else if (summary.batch?.shortOrders?.length) {
          msg += ` Couldn't auto-batch — short on stock:<br>${summary.batch.shortOrders.map((s: { reason: string }) => s.reason).join('<br>')}`;
        }
        showResult(msg);
        await loadOrders();
      } catch (err) {
        showResult((err as Error).message, 'danger');
      }
    });

    document.getElementById('batch-btn')?.addEventListener('click', async () => {
      if (!cartId) {
        showResult('No cart configured for this warehouse yet.', 'danger');
        return;
      }
      try {
        const result = await api('/api/admin/batches', { warehouseId, cartId, maxOrders: 8 });
        if (!result.batchId) {
          if (result.shortOrders?.length) {
            showResult(
              `No orders could be fully reserved — short on stock:<br>${result.shortOrders.map((s: { reason: string }) => s.reason).join('<br>')}<br><a href="/admin/inbound">Receive stock</a> to fix this.`,
              'danger'
            );
          } else {
            showResult('No open orders waiting to be batched right now.', 'danger');
          }
        } else {
          showResult(`Batch created: ${result.orderCount} orders, ${result.taskCount} pick tasks. <a href="/admin/pick-list?batchId=${result.batchId}">View / print pick list</a>`);
        }
        await loadOrders();
      } catch (err) {
        showResult((err as Error).message, 'danger');
      }
    });

    boot();
  </script>
</AdminShell>
