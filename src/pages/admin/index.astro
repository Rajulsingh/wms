---
import AdminShell from '../../components/AdminShell.astro';
import { getDb } from '../../lib/db';
import { requireAdminPage } from '../../lib/auth';

const redirectTo = await requireAdminPage(Astro, getDb());
if (redirectTo) return Astro.redirect(redirectTo);
---

<AdminShell title="Orders" current="orders">
  <span class="pill" id="user-pill" slot="actions">…</span>

  <div class="row" style="flex-wrap: wrap;">
    <button class="btn btn-primary" id="sync-now-btn" style="width: auto;">Sync with Amazon</button>
    <button class="btn" id="retry-btn" style="width: auto;">Assign orders to pick list</button>
    <div class="row" style="width: auto; margin-left: auto; align-items: center; gap: 10px;">
      <label class="row" style="width: auto; align-items: center; gap: 6px; font-size: 0.82rem; color: var(--muted);">
        <input type="checkbox" id="reset-include-shipped" style="width: 18px; height: 18px;" />
        Also reset ready-to-ship orders
      </label>
      <button class="btn btn-ghost" id="reset-btn" style="width: auto;">Reset picking &amp; packing</button>
    </div>
  </div>
  <div id="action-result" class="banner" style="display:none;"></div>

  <div class="stat-grid" id="stat-grid"></div>

  <div class="card stack">
    <h2>Orders</h2>
    <div class="row" id="status-tabs" style="flex-wrap: wrap; gap: 6px;"></div>
    <div id="orders-table">Loading…</div>
  </div>

  <script>
    import { withLoading, escapeHtml, confirmDangerousAction } from '../../lib/ui';

    interface OrderRow {
      id: string;
      external_order_id: string;
      source: string;
      status: string;
      customer_name: string | null;
      created_at: string;
      first_item_name: string | null;
      first_item_image: string | null;
      item_count: number;
      order_value: number | null;
      notes: string | null;
    }

    function productSummary(o: OrderRow): string {
      if (!o.first_item_name) return 'No items';
      return o.item_count > 1 ? `${o.first_item_name} <span style="color: var(--muted);">+${o.item_count - 1} more</span>` : o.first_item_name;
    }

    function orderValue(o: OrderRow): string {
      return o.order_value ? `₹${o.order_value.toFixed(2)}` : '—';
    }

    // Amazon's Merchant Fulfillment label can be bought any time once the order exists — matches the "labels purchased upfront" workflow, not gated on picking/packing being done first.
    function shipAction(o: OrderRow): string {
      if (o.source !== 'amazon') return '';
      if (o.status === 'ready_to_ship' || o.status === 'shipped') return '<span style="color: var(--success); font-weight: 700;">Shipped</span>';
      return `<a href="/admin/ship?orderId=${o.id}" class="order-card-ship">Ship →</a>`;
    }

    // Compact by design — a table row per order, not an input box per row,
    // since this table can run to 100 rows and an always-visible text input
    // in every row would be both visually heavy and (on a narrow phone,
    // learned the hard way elsewhere this session) a real overflow risk.
    // Click to reveal a real input just for that cell; see bindNoteCells().
    function noteCell(o: OrderRow): string {
      const escaped = escapeHtml(o.notes ?? '');
      return `<button type="button" class="btn-ghost note-btn" data-order-id="${o.id}" style="text-align:left; padding:4px 6px; min-height:auto; font-weight:400;">
        ${o.notes ? `<span class="truncate-cell" style="max-width:140px;" title="${escaped}">${escaped}</span>` : '<span style="color: var(--muted);">+ Add note</span>'}
      </button>`;
    }

    const STATUS_STYLE: Record<string, string> = {
      pending: 'status-neutral',
      batched: 'status-progress',
      picking: 'status-progress',
      packing: 'status-progress',
      ready_to_ship: 'status-warning',
      shipped: 'status-success'
    };

    function statusPill(status: string): string {
      const cls = STATUS_STYLE[status] ?? 'status-neutral';
      return `<span class="status-pill ${cls}">${status.replace(/_/g, ' ')}</span>`;
    }

    const userPill = document.getElementById('user-pill')!;
    const actionResult = document.getElementById('action-result') as HTMLDivElement;
    const ordersTable = document.getElementById('orders-table')!;
    const statusTabs = document.getElementById('status-tabs')!;
    const statGrid = document.getElementById('stat-grid')!;
    let warehouseId = '';
    let allOrders: OrderRow[] = [];
    let skuCount: number | null = null;
    let activeTab = 'all';

    // Standard-WMS-style status buckets — our internal status column has more
    // granularity (picking/picked/packing/packed) than a floor manager needs
    // to filter by day-to-day, so these group several statuses under one tab.
    const STATUS_GROUPS: Record<string, string[]> = {
      all: [],
      new: ['pending', 'allocated'],
      processing: ['batched', 'picking', 'picked', 'packing', 'packed', 'partial'],
      ready: ['ready_to_ship'],
      shipped: ['shipped'],
      cancelled: ['cancelled']
    };
    const TAB_LABELS: Record<string, string> = {
      all: 'All',
      new: 'New',
      processing: 'Processing',
      ready: 'Ready to ship',
      shipped: 'Shipped',
      cancelled: 'Cancelled'
    };

    async function api(path: string, body?: unknown, method?: string) {
      const res = await fetch(path, {
        method: method ?? (body === undefined ? 'GET' : 'POST'),
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    function showResult(msg: string, kind: 'success' | 'danger' = 'success') {
      actionResult.className = `banner banner-${kind}`;
      actionResult.innerHTML = msg;
      actionResult.style.display = 'block';
    }

    function renderStats() {
      const count = (key: string) => allOrders.filter((o) => STATUS_GROUPS[key].includes(o.status)).length;
      const cards: Array<{ label: string; value: number | string; accent: string }> = [
        { label: 'New orders', value: count('new'), accent: 'stat-card-accent-neutral' },
        { label: 'Processing', value: count('processing'), accent: 'stat-card-accent-progress' },
        { label: 'Ready to ship', value: count('ready'), accent: 'stat-card-accent-warning' },
        { label: 'Shipped', value: count('shipped'), accent: 'stat-card-accent-success' },
        { label: 'Current SKUs', value: skuCount ?? '—', accent: 'stat-card-accent-neutral' }
      ];
      statGrid.innerHTML = cards
        .map(
          (c) => `<div class="stat-card ${c.accent}">
            <span class="stat-card-value">${c.value}</span>
            <span class="stat-card-label">${c.label}</span>
          </div>`
        )
        .join('');
    }

    function renderTabs() {
      statusTabs.innerHTML = Object.keys(STATUS_GROUPS)
        .map((key) => {
          const count = key === 'all' ? allOrders.length : allOrders.filter((o) => STATUS_GROUPS[key].includes(o.status)).length;
          return `<button type="button" class="pill tab-pill${key === activeTab ? ' active' : ''}" data-tab="${key}">${TAB_LABELS[key]}${count ? ` (${count})` : ''}</button>`;
        })
        .join('');

      statusTabs.querySelectorAll('button[data-tab]').forEach((btn) => {
        btn.addEventListener('click', () => {
          activeTab = (btn as HTMLButtonElement).dataset.tab!;
          renderTabs();
          renderOrders();
        });
      });
    }

    function renderOrders() {
      const filtered = activeTab === 'all' ? allOrders : allOrders.filter((o) => STATUS_GROUPS[activeTab].includes(o.status));

      if (!filtered.length) {
        ordersTable.innerHTML = `<p>No ${activeTab === 'all' ? '' : TAB_LABELS[activeTab].toLowerCase() + ' '}orders${activeTab === 'all' ? ' yet' : ''}.</p>`;
        return;
      }
      ordersTable.innerHTML = `
        <div class="table-scroll"><table>
          <thead>
            <tr><th>Order ID</th><th>Product</th><th>Status</th><th>Source</th><th>Value</th><th>Notes</th><th></th></tr>
          </thead>
          <tbody>
            ${filtered
              .map(
                (o) => `<tr data-order-id="${o.id}">
                  <td style="font-weight:700; font-variant-numeric: tabular-nums; white-space: nowrap;">${o.external_order_id}</td>
                  <td>
                    <div class="row" style="align-items:center; gap:10px;">
                      ${o.first_item_image ? `<img class="table-thumb" src="${o.first_item_image}" alt="" />` : ''}
                      <span class="truncate-cell" title="${(o.first_item_name ?? '').replace(/"/g, '&quot;')}">${productSummary(o)}</span>
                    </div>
                  </td>
                  <td>${statusPill(o.status)}</td>
                  <td style="white-space: nowrap;">${o.source}${o.customer_name ? ' · ' + o.customer_name : ''}</td>
                  <td style="font-weight:700; white-space: nowrap;">${orderValue(o)}</td>
                  <td>${noteCell(o)}</td>
                  <td style="white-space: nowrap;">${shipAction(o)}</td>
                </tr>`
              )
              .join('')}
          </tbody>
        </table></div>`;
      bindNoteCells();
    }

    function bindNoteCells() {
      ordersTable.querySelectorAll<HTMLButtonElement>('.note-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const orderId = btn.dataset.orderId!;
          const order = allOrders.find((o) => o.id === orderId);
          const td = btn.closest('td')!;
          td.innerHTML = `
            <div class="row" style="gap:6px; align-items:center; min-width:230px;">
              <input type="text" class="note-input" value="${escapeHtml(order?.notes ?? '')}" placeholder="e.g. free gift included" style="min-height:36px; padding:6px 8px; font-size:0.8rem;" />
              <button type="button" class="btn btn-primary note-save" style="width:auto; min-height:36px; padding:0 10px;">Save</button>
              <button type="button" class="btn btn-ghost note-cancel" style="width:auto; min-height:36px; padding:0 10px;">Cancel</button>
            </div>`;
          const input = td.querySelector('.note-input') as HTMLInputElement;
          input.focus();
          const save = async (e: Event) => {
            const saveBtn = e.currentTarget as HTMLButtonElement;
            const notes = input.value.trim() || null;
            try {
              await withLoading(saveBtn, 'Saving…', () => api('/api/admin/orders', { orderId, notes }, 'PATCH'));
              if (order) order.notes = notes;
              renderOrders();
            } catch (err) {
              alert((err as Error).message);
            }
          };
          td.querySelector('.note-save')?.addEventListener('click', save);
          td.querySelector('.note-cancel')?.addEventListener('click', () => renderOrders());
          input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
              e.preventDefault();
              save({ currentTarget: td.querySelector('.note-save') } as unknown as Event);
            } else if (e.key === 'Escape') {
              renderOrders();
            }
          });
        });
      });
    }

    async function loadOrders() {
      allOrders = await api(`/api/admin/orders?warehouseId=${warehouseId}`);
      renderStats();
      renderTabs();
      renderOrders();
    }

    async function loadSkuCount() {
      try {
        const report = await api(`/api/admin/reports?warehouseId=${warehouseId}`);
        skuCount = Array.isArray(report.stock) ? report.stock.length : null;
      } catch {
        skuCount = null;
      }
      renderStats();
    }

    async function boot() {
      const me = await api('/api/auth/me');
      if (!me.user) {
        window.location.href = '/login';
        return;
      }
      if (me.user.role !== 'admin') {
        document.body.innerHTML = `<div class="screen"><p>This account is a "${me.user.role}", not an admin.</p></div>`;
        return;
      }
      userPill.textContent = me.user.name;
      warehouseId = me.user.warehouseId;

      await loadOrders();
      loadSkuCount();

      // Orders keep arriving (Amazon imports, manual entry) and their status
      // keeps changing as picking/packing happens — refresh automatically so
      // admin doesn't have to keep reloading to see what needs a label next.
      // Skipped while a note editor is open — a full table rebuild would
      // wipe out whatever was being typed before it could be saved (found
      // while testing the notes feature: the refresh clobbered an in-
      // progress edit within the ~12s window).
      setInterval(() => {
        if (!document.hidden && !ordersTable.querySelector('.note-input')) loadOrders();
      }, 12000);
    }

    document.getElementById('retry-btn')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        const result = await withLoading(btn, 'Assigning…', () => api('/api/admin/batches', { warehouseId }));
        if (!result.retried) {
          showResult('Nothing to assign right now — every order already has a pick list.');
        } else if (result.shortOrders?.length) {
          // Not always a stock shortage — "No items to reserve" here means
          // this order's items aren't actually sitting pending (a data
          // state issue, not something Receive Stock fixes), so the reasons
          // are shown as-is rather than all being labeled "short on stock".
          showResult(
            `Assigned ${result.succeeded} of ${result.retried} to a pick list. Still blocked:<br>${result.shortOrders.map((s: { reason: string }) => s.reason).join('<br>')}<br>If a reason mentions stock, <a href="/admin/inbound">receive stock</a> to fix it — otherwise check <a href="/admin/exceptions">Exceptions</a> or ask for help.`,
            result.succeeded > 0 ? 'success' : 'danger'
          );
        } else {
          showResult(`Assigned all ${result.succeeded} order${result.succeeded === 1 ? '' : 's'} to a pick list — packers will see it automatically.`);
        }
        await loadOrders();
      } catch (err) {
        showResult((err as Error).message, 'danger');
      }
    });

    interface SyncJobResult {
      warehouseId: string;
      imported: number;
      skipped: number;
      newSkusCreated: number;
      statusChecked: number;
      statusShipped: number;
      statusCancelled: number;
      retried: number;
      retrySucceeded: number;
      shortOrders: Array<{ orderId: string; reason: string }>;
    }

    // Replaces what used to be two separate buttons ("Import from Amazon"
    // and this one) — they genuinely overlapped (both pulled new orders) and
    // just confused which one to click. This does everything: pull new
    // orders, check Amazon's current status on existing ones, and retry
    // anything still blocked, all in one action.
    document.getElementById('sync-now-btn')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        const { results } = await withLoading(btn, 'Syncing…', () => api('/api/admin/sync-now', {}));
        const totals = (results as SyncJobResult[]).reduce(
          (acc, r) => ({
            imported: acc.imported + r.imported,
            newSkusCreated: acc.newSkusCreated + r.newSkusCreated,
            statusShipped: acc.statusShipped + r.statusShipped,
            statusCancelled: acc.statusCancelled + r.statusCancelled,
            retrySucceeded: acc.retrySucceeded + r.retrySucceeded,
            shortOrders: acc.shortOrders.concat(r.shortOrders)
          }),
          { imported: 0, newSkusCreated: 0, statusShipped: 0, statusCancelled: 0, retrySucceeded: 0, shortOrders: [] as Array<{ orderId: string; reason: string }> }
        );
        let msg =
          `Synced with Amazon: ${totals.imported} new order${totals.imported === 1 ? '' : 's'} imported` +
          `${totals.newSkusCreated ? ` (${totals.newSkusCreated} new SKU${totals.newSkusCreated === 1 ? '' : 's'} pulled from Amazon's catalog)` : ''}, ` +
          `${totals.statusShipped} marked shipped, ${totals.statusCancelled} cancelled, ` +
          `${totals.retrySucceeded} blocked order${totals.retrySucceeded === 1 ? '' : 's'} resolved.`;
        if (totals.shortOrders.length) {
          msg += `<br>${totals.shortOrders.length} still blocked:<br>${totals.shortOrders.map((s) => s.reason).join('<br>')}<br>If a reason mentions stock, <a href="/admin/inbound">receive stock</a> to fix it.`;
        }
        showResult(msg);
        await loadOrders();
      } catch (err) {
        showResult((err as Error).message, 'danger');
      }
    });

    document.getElementById('reset-btn')?.addEventListener('click', async (e) => {
      // Capture the button (and checkbox state) before the confirm modal's
      // await — `e.currentTarget` goes null once the click event finishes
      // dispatching, so reading it after an `await` (found the hard way:
      // withLoading threw reading `.textContent` off null, silently
      // skipping the actual reset call).
      const btn = e.currentTarget as HTMLButtonElement;
      const includeReadyToShip = (document.getElementById('reset-include-shipped') as HTMLInputElement).checked;
      const ok = await confirmDangerousAction({
        title: 'Reset picking & packing',
        message: includeReadyToShip
          ? 'This puts every order currently batched/picking/packing/ready-to-ship back to "pending" — deleting its pick batch, pick tasks, pack sessions, and any label/AWB already applied — and restores the inventory it had reserved or consumed. This also resets orders that may carry a REAL Amazon-scheduled pickup or label — resetting those will desync us from that commitment. Only proceed if you mean to include them.'
          : 'This puts every order currently batched/picking/packing back to "pending" — deleting its pick batch, pick tasks, and pack sessions — and restores the inventory it had reserved or consumed. Orders already ready to ship or shipped are left alone. Use this to retest the same orders from scratch.',
        continueLabel: 'Reset'
      });
      if (!ok) return;
      try {
        const result = await withLoading(btn, 'Resetting…', () => api('/api/admin/reset-pick-pack', { warehouseId, includeReadyToShip }));
        showResult(
          result.orderCount
            ? `Reset ${result.orderCount} order${result.orderCount > 1 ? 's' : ''} across ${result.batchCount} batch${result.batchCount > 1 ? 'es' : ''} back to pending.`
            : 'Nothing to reset — no matching orders right now.'
        );
        await loadOrders();
      } catch (err) {
        showResult((err as Error).message, 'danger');
      }
    });

    boot();
  </script>
</AdminShell>
