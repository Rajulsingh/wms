---
import AdminShell from '../../components/AdminShell.astro';
import { getDb } from '../../lib/db';
import { requireAdminPage } from '../../lib/auth';

const redirectTo = await requireAdminPage(Astro, getDb());
if (redirectTo) return Astro.redirect(redirectTo);
---

<AdminShell title="Inventory" current="inventory">
  <div class="card stack">
    <h2>Merge duplicate SKUs</h2>
    <p>
      When the same physical product ends up under two SKU codes — typically because Amazon sent a SellerSKU that
      doesn't match the code you already stock it under — merge the duplicate into the one you actually use.
      Inventory, pending order lines, and future orders under the old code all redirect to the surviving SKU.
      Nothing is deleted.
    </p>
    <div class="row" style="flex-wrap: wrap; gap: 10px;">
      <input type="text" id="merge-source" placeholder="Duplicate SKU code to retire" style="flex: 1; min-width: 180px;" />
      <input type="text" id="merge-target" placeholder="SKU code to keep" style="flex: 1; min-width: 180px;" />
      <button class="btn" id="merge-preview-btn" style="width: auto;">Preview merge</button>
    </div>
    <div id="merge-progress" class="progress-bar indeterminate"><div class="progress-bar-fill"></div></div>
    <div id="merge-result"></div>
  </div>

  <div class="card stack">
    <h2>Unmerge a SKU</h2>
    <p>
      If two SKUs turn out to be genuinely different products (or variants you want to track separately)
      after all, undo a merge here. This only stops the retired code from redirecting to the other SKU going
      forward — it does <strong>not</strong> automatically move any inventory or orders back, since once merged
      there's no reliable way to tell which of the surviving SKU's inventory or orders were always its own vs.
      genuinely came from the retired code. If real stock or orders need separating out, check them manually first.
    </p>
    <div class="row" style="flex-wrap: wrap; gap: 10px;">
      <input type="text" id="unmerge-source" placeholder="Merged (retired) SKU code to restore" style="flex: 1; min-width: 220px;" />
      <button class="btn" id="unmerge-preview-btn" style="width: auto;">Look up</button>
    </div>
    <div id="unmerge-result"></div>
    <div class="row" style="justify-content: flex-end; margin-top: 4px;">
      <button class="btn btn-ghost" id="unmerge-all-btn" style="width: auto; color: var(--danger);">Unmerge all listings</button>
    </div>
    <div id="unmerge-all-result"></div>
  </div>

  <div class="card stack">
    <h2>Possible duplicate SKUs</h2>
    <p>
      Matches on ASIN and product photo first — the same Amazon product identity, or the same real photo, is far
      more reliable than title text, which can look identical for two genuinely different colors or sizes. Title
      is only used as a last resort for SKUs with no ASIN or photo on file yet (try "Sync Amazon catalog" on
      <a href="/admin/inbound">Receiving</a> first to fill those in). Same title alone is not proof of a
      duplicate — check the group's confidence label and the photos before merging.
    </p>
    <button class="btn" id="scan-duplicates-btn" style="width: auto;">Scan for duplicates</button>
    <div id="scan-progress" class="progress-bar indeterminate"><div class="progress-bar-fill"></div></div>
    <div id="duplicates-result"></div>
  </div>

  <div class="card stack">
    <h2>Stock by location</h2>
    <p>On-hand and reserved units per SKU per bin. Edit on-hand directly to correct a miscount or write off damage — this doesn't go through the reservation flow.</p>
    <div class="table-scroll">
      <table id="inventory-table">
        <thead>
          <tr><th>SKU</th><th>MSKU</th><th>Location</th><th>On hand</th><th>Reserved</th><th>Price</th><th></th></tr>
        </thead>
        <tbody id="inventory-rows">
          <tr><td colspan="7">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { withLoading, escapeHtml, confirmDangerousAction } from '../../lib/ui';

    interface Row {
      id: string;
      sku_id: string;
      sku_code: string;
      sku_name: string;
      price: number | null;
      msku: string | null;
      location_id: string;
      location_code: string;
      zone_name: string | null;
      quantity_on_hand: number;
      quantity_reserved: number;
    }

    let warehouseId = '';

    async function api(path: string, body?: unknown, method?: string) {
      const res = await fetch(path, {
        method: method ?? (body === undefined ? 'GET' : 'POST'),
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    async function loadInventory() {
      const rows: Row[] = await api(`/api/admin/inventory?warehouseId=${warehouseId}`);
      const tbody = document.getElementById('inventory-rows')!;
      tbody.innerHTML = rows.length
        ? rows
            .map(
              (r) => `
        <tr data-inv-id="${r.id}" data-sku-id="${r.sku_id}">
          <td>${r.sku_code}<br><span style="font-size: 0.75rem; color: var(--muted);">${r.sku_name}</span></td>
          <td>${r.msku ? `<strong>${escapeHtml(r.msku)}</strong>` : '<span style="color: var(--muted);">—</span>'}</td>
          <td>${r.zone_name ? r.zone_name + ' · ' : ''}${r.location_code}</td>
          <td><input type="number" class="onhand-input" value="${r.quantity_on_hand}" min="0" style="width: 90px; min-height: 40px; padding: 6px 8px;" /></td>
          <td>${r.quantity_reserved}</td>
          <td><input type="number" class="price-input" value="${r.price ?? ''}" min="0" step="0.01" placeholder="—" style="width: 90px; min-height: 40px; padding: 6px 8px;" /></td>
          <td><button class="btn btn-ghost save-btn" style="width: auto; min-height: 36px;">Save</button></td>
        </tr>`
            )
            .join('')
        : '<tr><td colspan="7">No inventory yet — <a href="/admin/inbound">receive some stock</a> to get started.</td></tr>';

      tbody.querySelectorAll('tr[data-inv-id]').forEach((tr) => {
        const row = tr as HTMLTableRowElement;
        const invId = row.dataset.invId!;
        const skuId = row.dataset.skuId!;
        row.querySelector('.save-btn')?.addEventListener('click', async () => {
          const onHand = Number((row.querySelector('.onhand-input') as HTMLInputElement).value);
          const priceRaw = (row.querySelector('.price-input') as HTMLInputElement).value;
          const price = priceRaw === '' ? null : Number(priceRaw);
          try {
            await Promise.all([
              api('/api/admin/inventory', { inventoryId: invId, quantityOnHand: onHand }, 'PATCH'),
              api('/api/admin/skus', { skuId, price, warehouseId }, 'PATCH')
            ]);
          } catch (err) {
            alert((err as Error).message);
          }
        });
      });
    }

    const mergeResult = document.getElementById('merge-result')!;
    const mergeSourceInput = document.getElementById('merge-source') as HTMLInputElement;
    const mergeTargetInput = document.getElementById('merge-target') as HTMLInputElement;

    interface MergeSide { id: string; code: string; name: string; imageUrl: string | null; asin: string | null; msku: string | null }
    interface MergePreview {
      source: MergeSide;
      target: MergeSide;
      inventoryLines: number;
      inventoryUnits: number;
      orderItemCount: number;
      pickTaskCount: number;
      asinMismatch: boolean;
      mskuMismatch: boolean;
    }

    function mergeSideCardHtml(label: string, side: MergeSide): string {
      return `
        <div class="stack" style="gap: 4px; align-items: center; text-align: center; flex: 1; min-width: 140px;">
          <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted);">${label}</span>
          ${side.imageUrl ? `<img class="thumb thumb-lg" src="${side.imageUrl}" alt="" />` : '<div class="thumb thumb-lg"></div>'}
          <strong>${escapeHtml(side.code)}</strong>
          <span style="font-size: 0.78rem; color: var(--muted);">${escapeHtml(side.name)}</span>
          <span style="font-size: 0.72rem; color: var(--muted);">ASIN: ${side.asin ? escapeHtml(side.asin) : 'unknown'}</span>
          ${side.msku ? `<span class="status-pill status-success" style="font-size: 0.68rem;">${escapeHtml(side.msku)}</span>` : ''}
        </div>`;
    }

    const mergeProgress = document.getElementById('merge-progress')!;

    document.getElementById('merge-preview-btn')?.addEventListener('click', async (e) => {
      const sourceCode = mergeSourceInput.value.trim();
      const targetCode = mergeTargetInput.value.trim();
      mergeResult.innerHTML = '';
      if (!sourceCode || !targetCode) {
        mergeResult.innerHTML = `<p style="color: var(--danger);">Enter both SKU codes.</p>`;
        return;
      }
      const btn = e.currentTarget as HTMLButtonElement;
      mergeProgress.classList.add('active');
      try {
        const preview: MergePreview = await withLoading(btn, 'Checking…', () =>
          api(`/api/admin/sku-merge?sourceCode=${encodeURIComponent(sourceCode)}&targetCode=${encodeURIComponent(targetCode)}&warehouseId=${warehouseId}`)
        );
        mergeResult.innerHTML = `
          <div class="banner ${preview.mskuMismatch || preview.asinMismatch ? 'banner-danger' : 'banner-warning'}" style="margin-top: 10px;">
            ${
              preview.mskuMismatch
                ? `<p style="margin: 0 0 10px; font-weight: 700;">⚠ These already have different MSKUs (${escapeHtml(preview.source.msku!)} vs ${escapeHtml(preview.target.msku!)}) — a human already confirmed at receiving that these are two different products. Merging overrides that deliberate call; only proceed if that was a mistake.</p>`
                : preview.asinMismatch
                  ? `<p style="margin: 0 0 10px; font-weight: 700;">⚠ These have different Amazon ASINs (${escapeHtml(preview.source.asin!)} vs ${escapeHtml(preview.target.asin!)}) despite the same title — they're likely different products or variations (e.g. color/size), not duplicates. Compare the photos below carefully before merging.</p>`
                  : ''
            }
            <div class="row" style="gap: 12px; align-items: flex-start; flex-wrap: wrap; margin-bottom: 10px;">
              ${mergeSideCardHtml('Retire', preview.source)}
              <div style="align-self: center; font-size: 1.2rem; color: var(--muted);">→</div>
              ${mergeSideCardHtml('Keep', preview.target)}
            </div>
            <p style="margin: 0 0 8px;">Merging will move:</p>
            <ul style="margin: 0 0 10px; padding-left: 20px;">
              <li>${preview.inventoryLines} inventory location${preview.inventoryLines === 1 ? '' : 's'} (${preview.inventoryUnits} unit${preview.inventoryUnits === 1 ? '' : 's'})</li>
              <li>${preview.orderItemCount} order line${preview.orderItemCount === 1 ? '' : 's'}</li>
              <li>${preview.pickTaskCount} pick task${preview.pickTaskCount === 1 ? '' : 's'}</li>
            </ul>
            <p style="margin: 0 0 10px; font-size: 0.85rem;">
              "${escapeHtml(preview.source.code)}" isn't deleted — it stays as a redirect, so a future order under that
              code lands on "${escapeHtml(preview.target.code)}" automatically instead of creating a new duplicate.
            </p>
            <button class="btn btn-primary" id="merge-confirm-btn" style="width: auto;">Confirm merge</button>
          </div>`;
        document.getElementById('merge-confirm-btn')?.addEventListener('click', async (ce) => {
          const confirmBtn = ce.currentTarget as HTMLButtonElement;
          try {
            await withLoading(confirmBtn, 'Merging…', () => api('/api/admin/sku-merge', { sourceCode, targetCode, warehouseId }, 'POST'));
            mergeResult.innerHTML = `<div class="banner banner-success" style="margin-top: 10px;">Merged. Reloading inventory…</div>`;
            mergeSourceInput.value = '';
            mergeTargetInput.value = '';
            await loadInventory();
          } catch (err) {
            mergeResult.innerHTML = `<p style="color: var(--danger); margin-top: 10px;">${escapeHtml((err as Error).message)}</p>`;
          }
        });
      } catch (err) {
        mergeResult.innerHTML = `<p style="color: var(--danger); margin-top: 10px;">${escapeHtml((err as Error).message)}</p>`;
      } finally {
        mergeProgress.classList.remove('active');
      }
    });

    interface UnmergePreview {
      source: MergeSide;
      target: MergeSide;
      targetInventoryLines: number;
      targetInventoryUnits: number;
      targetOrderItemCount: number;
    }

    const unmergeResult = document.getElementById('unmerge-result')!;
    const unmergeSourceInput = document.getElementById('unmerge-source') as HTMLInputElement;

    document.getElementById('unmerge-preview-btn')?.addEventListener('click', async (e) => {
      const sourceCode = unmergeSourceInput.value.trim();
      unmergeResult.innerHTML = '';
      if (!sourceCode) {
        unmergeResult.innerHTML = `<p style="color: var(--danger);">Enter a SKU code.</p>`;
        return;
      }
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        const preview: UnmergePreview = await withLoading(btn, 'Checking…', () =>
          api(`/api/admin/sku-unmerge?sourceCode=${encodeURIComponent(sourceCode)}&warehouseId=${warehouseId}`)
        );
        unmergeResult.innerHTML = `
          <div class="banner banner-warning" style="margin-top: 10px;">
            <p style="margin: 0 0 10px;">
              <strong>${escapeHtml(preview.source.code)}</strong> is currently merged into
              <strong>${escapeHtml(preview.target.code)}</strong>.
            </p>
            <div class="row" style="gap: 12px; align-items: flex-start; flex-wrap: wrap; margin-bottom: 10px;">
              ${mergeSideCardHtml('Currently merged (' + preview.source.code + ')', preview.source)}
              <div style="align-self: center; font-size: 1.2rem; color: var(--muted);">→</div>
              ${mergeSideCardHtml('Merged into', preview.target)}
            </div>
            <p style="margin: 0 0 8px; font-size: 0.85rem;">
              ${escapeHtml(preview.target.code)} currently has ${preview.targetInventoryLines} inventory location${preview.targetInventoryLines === 1 ? '' : 's'}
              (${preview.targetInventoryUnits} unit${preview.targetInventoryUnits === 1 ? '' : 's'}) and ${preview.targetOrderItemCount} order line${preview.targetOrderItemCount === 1 ? '' : 's'} —
              shown for context only. Unmerging won't move any of it; if some of it genuinely belongs to
              ${escapeHtml(preview.source.code)}, that needs checking and moving manually.
            </p>
            <button class="btn btn-primary" id="unmerge-confirm-btn" style="width: auto;">Confirm unmerge</button>
          </div>`;
        document.getElementById('unmerge-confirm-btn')?.addEventListener('click', async (ce) => {
          const confirmBtn = ce.currentTarget as HTMLButtonElement;
          try {
            await withLoading(confirmBtn, 'Unmerging…', () => api('/api/admin/sku-unmerge', { sourceCode, warehouseId }, 'POST'));
            unmergeResult.innerHTML = `<div class="banner banner-success" style="margin-top: 10px;">Unmerged — "${escapeHtml(sourceCode)}" is independent again.</div>`;
            unmergeSourceInput.value = '';
          } catch (err) {
            unmergeResult.innerHTML = `<p style="color: var(--danger); margin-top: 10px;">${escapeHtml((err as Error).message)}</p>`;
          }
        });
      } catch (err) {
        unmergeResult.innerHTML = `<p style="color: var(--danger); margin-top: 10px;">${escapeHtml((err as Error).message)}</p>`;
      }
    });

    const unmergeAllResult = document.getElementById('unmerge-all-result')!;
    document.getElementById('unmerge-all-btn')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const ok = await confirmDangerousAction({
        title: 'Unmerge every listing',
        message:
          'This clears every merge relationship in the catalog at once, restoring the SKU list to exactly what it would be with no merges at all. It does not move any inventory or orders — those stay exactly where they are. Only the "these codes are the same product" links are removed, so future Amazon orders under a previously-merged code will land on that code\'s own (currently empty) SKU again instead of the SKU it used to redirect to.',
        continueLabel: 'Unmerge all'
      });
      if (!ok) return;
      try {
        const result = await withLoading(btn, 'Unmerging…', () => api('/api/admin/sku-unmerge-all', { warehouseId }, 'POST'));
        unmergeAllResult.innerHTML = result.count
          ? `<div class="banner banner-success" style="margin-top: 10px;">Unmerged ${result.count} listing${result.count === 1 ? '' : 's'}.</div>`
          : `<p style="margin-top: 10px;">Nothing was merged — no change made.</p>`;
      } catch (err) {
        unmergeAllResult.innerHTML = `<p style="color: var(--danger); margin-top: 10px;">${escapeHtml((err as Error).message)}</p>`;
      }
    });

    interface DuplicateCandidate {
      id: string;
      code: string;
      imageUrl: string | null;
      asin: string | null;
      msku: string | null;
      inventoryUnits: number;
      orderItemCount: number;
      createdAt: string;
    }
    type DuplicateMatchType = 'same_asin' | 'same_image' | 'same_title';
    interface DuplicateGroup {
      matchType: DuplicateMatchType;
      matchValue: string;
      name: string;
      candidates: DuplicateCandidate[];
      suggestedKeepId: string;
      hasAsinMismatch: boolean;
      hasMskuMismatch: boolean;
    }

    const MATCH_TYPE_LABEL: Record<DuplicateMatchType, { pill: string; pillClass: string; note: string | null }> = {
      same_asin: { pill: 'Certain — same ASIN', pillClass: 'status-success', note: null },
      same_image: {
        pill: 'Likely — same photo',
        pillClass: 'status-progress',
        note: 'Different ASINs but the exact same product photo — usually the same listing relisted under a new ASIN, but confirm before merging.'
      },
      same_title: {
        pill: 'Weak — title only',
        pillClass: 'status-warning',
        note: 'Matched on title text only — their ASIN and/or photo are either missing or disagree with each other, so there\'s no stronger signal confirming these are the same product. Compare manually before merging.'
      }
    };

    const duplicatesResult = document.getElementById('duplicates-result')!;
    const scanProgress = document.getElementById('scan-progress')!;

    function candidateCardHtml(c: DuplicateCandidate, isKeep: boolean): string {
      return `
        <div class="stack" style="gap: 2px; align-items: center; text-align: center; width: 96px;">
          ${c.imageUrl ? `<img class="thumb thumb-lg" src="${c.imageUrl}" alt="" />` : '<div class="thumb thumb-lg"></div>'}
          <strong style="font-size: 0.8rem;">${escapeHtml(c.code)}</strong>
          <span style="font-size: 0.7rem; color: var(--muted);">${c.asin ? escapeHtml(c.asin) : 'no ASIN'}</span>
          ${c.msku ? `<span style="font-size: 0.68rem; font-weight: 700;">${escapeHtml(c.msku)}</span>` : ''}
          <span class="status-pill ${isKeep ? 'status-success' : 'status-neutral'}" style="font-size: 0.68rem;">${isKeep ? 'Keep' : `${c.inventoryUnits}u`}</span>
        </div>`;
    }

    // Reuses the exact same preview-then-confirm merge flow above instead
    // of a separate one-click merge path — every single merge, whether
    // typed manually or picked from this scan, goes through the same
    // human-reviewed preview step. No exceptions, even for a bulk cleanup.
    function fillAndPreviewMerge(sourceCode: string, targetCode: string) {
      mergeSourceInput.value = sourceCode;
      mergeTargetInput.value = targetCode;
      document.getElementById('merge-preview-btn')?.dispatchEvent(new MouseEvent('click', { bubbles: true }));
      mergeSourceInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    document.getElementById('scan-duplicates-btn')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      duplicatesResult.innerHTML = '';
      scanProgress.classList.add('active');
      try {
        const groups: DuplicateGroup[] = await withLoading(btn, 'Scanning…', () => api(`/api/admin/sku-duplicates?warehouseId=${warehouseId}`));
        if (!groups.length) {
          duplicatesResult.innerHTML = `<p>No possible duplicates found.</p>`;
          return;
        }
        const counts = groups.reduce(
          (acc, g) => ({ ...acc, [g.matchType]: (acc[g.matchType as DuplicateMatchType] ?? 0) + 1 }),
          {} as Record<DuplicateMatchType, number>
        );
        duplicatesResult.innerHTML = `
          <p style="margin-top: 10px;">
            ${groups.length} possible duplicate group${groups.length === 1 ? '' : 's'} found —
            ${counts.same_asin ?? 0} certain (same ASIN), ${counts.same_image ?? 0} likely (same photo), ${counts.same_title ?? 0} weak (title only).
          </p>
          <div class="stack" id="duplicate-groups" style="gap: 10px;"></div>`;
        const list = document.getElementById('duplicate-groups')!;
        for (const g of groups) {
          const keep = g.candidates.find((c) => c.id === g.suggestedKeepId)!;
          const others = g.candidates.filter((c) => c.id !== g.suggestedKeepId);
          const label = MATCH_TYPE_LABEL[g.matchType];
          const row = document.createElement('div');
          row.className = 'card';
          row.innerHTML = `
            <div class="row" style="justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 8px;">
              <span class="truncate-cell" style="max-width: 100%; font-weight: 600;" title="${escapeHtml(g.name)}">${escapeHtml(g.name)}</span>
              <span class="status-pill ${label.pillClass}" style="flex-shrink: 0;">${label.pill}</span>
            </div>
            ${label.note ? `<p style="margin: 6px 0 0; font-size: 0.8rem; color: var(--muted);">${escapeHtml(label.note)}</p>` : ''}
            ${
              g.hasMskuMismatch
                ? `<div class="banner banner-danger" style="margin-top: 8px;">⚠ These already have different MSKUs — a human already confirmed at receiving that these are different products. Merging overrides that call.</div>`
                : g.hasAsinMismatch
                  ? `<div class="banner banner-warning" style="margin-top: 8px;">⚠ These candidates carry different Amazon ASINs — could be a genuine color/size variation you intentionally treat as one SKU, or could be a real mismatch. Check the photos below before deciding.</div>`
                  : ''
            }
            <div class="row" style="flex-wrap: wrap; gap: 16px; align-items: flex-start; margin-top: 10px;">
              ${candidateCardHtml(keep, true)}
              ${others.map((c) => candidateCardHtml(c, false)).join('')}
            </div>
            <div class="row" style="width: auto; flex-wrap: wrap; gap: 6px; margin-top: 10px;">
              ${others
                .map(
                  (c) =>
                    `<button type="button" class="btn btn-ghost dup-merge-btn" data-source="${escapeHtml(c.code)}" data-target="${escapeHtml(keep.code)}" style="width: auto; min-height: 36px;">Merge ${escapeHtml(c.code)} → ${escapeHtml(keep.code)}</button>`
                )
                .join('')}
            </div>`;
          list.appendChild(row);
        }
        list.querySelectorAll<HTMLButtonElement>('.dup-merge-btn').forEach((b) => {
          b.addEventListener('click', () => fillAndPreviewMerge(b.dataset.source!, b.dataset.target!));
        });
      } catch (err) {
        duplicatesResult.innerHTML = `<p style="color: var(--danger); margin-top: 10px;">${escapeHtml((err as Error).message)}</p>`;
      } finally {
        scanProgress.classList.remove('active');
      }
    });

    async function boot() {
      const me = await api('/api/auth/me');
      if (!me.user) {
        window.location.href = '/login';
        return;
      }
      if (me.user.role !== 'admin') {
        document.body.innerHTML = `<div class="screen"><p>This account is a "${me.user.role}", not an admin.</p></div>`;
        return;
      }
      warehouseId = me.user.warehouseId;
      await loadInventory();
    }

    boot();
  </script>
</AdminShell>
