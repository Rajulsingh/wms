---
import AdminShell from '../../components/AdminShell.astro';
import { getDb } from '../../lib/db';
import { requireAdminPage } from '../../lib/auth';

const redirectTo = await requireAdminPage(Astro, getDb());
if (redirectTo) return Astro.redirect(redirectTo);
---

<AdminShell title="Returns" current="returns">
  <div id="app" class="stack">
    <p>Loading…</p>
  </div>

  <script>
    import { escapeHtml, withLoading } from '../../lib/ui';

    interface ReturnRow {
      id: string;
      externalOrderId: string;
      amazonRmaId: string | null;
      merchantSku: string | null;
      asin: string | null;
      itemName: string | null;
      returnReason: string | null;
      trackingId: string | null;
      returnRequestDate: string | null;
      status: string;
      skuCode: string | null;
      skuName: string | null;
      imageUrl: string | null;
      labelImageKey: string | null;
      productImageKey: string | null;
    }

    interface ReceiptRow {
      receiptDate: string;
      expectedCount: number;
      receivedCount: number;
      confirmedAt: string;
      confirmedByName: string | null;
    }

    const STATUS_LABELS: Record<string, string> = {
      expected: 'Awaiting receipt',
      received: 'Received, awaiting inspection',
      ready_to_repack: 'Ready to repack',
      unsellable: 'Unsellable',
      safe_to_claim: 'Safe to claim',
      claim_filed: 'Claim filed'
    };

    const app = document.getElementById('app')!;
    let warehouseId = '';
    // Two views on the same underlying data — what Amazon says (synced
    // as-is, every status, every field their report gave us) vs what the
    // floor has actually reported back (headcount confirmations +
    // inspection outcomes). Conflating them into one list was the original
    // version of this page; splitting them is what the seller actually
    // asked for.
    let activeTab: 'amazon' | 'packer' = 'amazon';
    let amazonRows: ReturnRow[] = [];
    let packerStatusFilter = 'safe_to_claim';
    let packerRows: ReturnRow[] = [];
    let receipts: ReceiptRow[] = [];
    let otp: { otp: string; setAt: string; validForCount: number | null } | null = null;

    async function api(path: string, body?: unknown, method?: string) {
      const res = await fetch(path, {
        method: method ?? (body === undefined ? 'GET' : 'POST'),
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    async function boot() {
      const me = await api('/api/auth/me');
      if (!me.user || me.user.role !== 'admin') {
        app.innerHTML = '<p>Admin access required.</p>';
        return;
      }
      warehouseId = me.user.warehouseId;
      await Promise.all([loadAmazonRows(), loadPackerRows(), loadReceipts(), loadOtp()]);
      render();
    }

    async function loadAmazonRows() {
      const data = await api(`/api/admin/returns?warehouseId=${warehouseId}`);
      amazonRows = data.returns ?? [];
    }

    async function loadPackerRows() {
      const data = await api(`/api/admin/returns?warehouseId=${warehouseId}&status=${packerStatusFilter}`);
      packerRows = data.returns ?? [];
    }

    async function loadReceipts() {
      const data = await api(`/api/admin/returns/receipts?warehouseId=${warehouseId}`);
      receipts = data.receipts ?? [];
    }

    async function loadOtp() {
      const data = await api(`/api/admin/returns/otp?warehouseId=${warehouseId}`);
      otp = data.otp ?? null;
    }

    function render() {
      app.innerHTML = `
        <div class="card stack" style="gap: 10px;">
          <span class="eyebrow">Today's return OTP</span>
          <p style="margin: 0; font-size: 0.85rem; color: var(--muted);">
            Not available via Amazon's API — read it off Seller Central's Manage Returns page each morning and enter it here. Packers see whatever is saved for today.
          </p>
          <div class="row" style="gap: 8px; align-items: center; flex-wrap: wrap;">
            <input type="text" id="otp-input" placeholder="Today's OTP" value="${otp ? escapeHtml(otp.otp) : ''}" style="max-width: 180px;" />
            <input type="number" min="0" id="otp-valid-count-input" placeholder="Valid for how many returns" value="${otp?.validForCount ?? ''}" style="max-width: 190px;" />
            <button class="btn btn-primary" id="save-otp" style="width: auto;">Save</button>
            ${otp ? `<span style="font-size: 0.78rem; color: var(--muted);">Last set ${new Date(otp.setAt).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' })}</span>` : ''}
          </div>
        </div>

        <div class="row" style="gap: 8px; margin-top: 18px;">
          <button class="pill tab-pill ${activeTab === 'amazon' ? 'active' : ''}" id="tab-amazon" style="border: none; cursor: pointer;">From Amazon (${amazonRows.length})</button>
          <button class="pill tab-pill ${activeTab === 'packer' ? 'active' : ''}" id="tab-packer" style="border: none; cursor: pointer;">Reported by packers</button>
        </div>

        <div style="margin-top: 14px;" data-tab-content></div>`;

      document.getElementById('save-otp')?.addEventListener('click', (e) => saveOtp(e.currentTarget as HTMLButtonElement));
      document.getElementById('tab-amazon')?.addEventListener('click', () => {
        activeTab = 'amazon';
        render();
      });
      document.getElementById('tab-packer')?.addEventListener('click', () => {
        activeTab = 'packer';
        render();
      });

      const content = document.querySelector('[data-tab-content]') as HTMLElement;
      if (activeTab === 'amazon') renderAmazonTab(content);
      else renderPackerTab(content);
    }

    // The raw sync — every return Amazon has told us about, whatever its
    // status, with the fields their report actually gives (order id, MSKU/
    // ASIN, reason, request date, tracking id). A dense table rather than
    // cards, since this is a reference/lookup list, not an action queue.
    function renderAmazonTab(container: HTMLElement) {
      container.innerHTML = amazonRows.length
        ? `<div class="table-scroll">
             <table>
               <thead><tr><th>Order ID</th><th>Item</th><th>MSKU / ASIN</th><th>Reason</th><th>Request date</th><th>Tracking</th><th>Status</th></tr></thead>
               <tbody>${amazonRows.map((r) => amazonRowHtml(r)).join('')}</tbody>
             </table>
           </div>`
        : `<p>No returns synced from Amazon yet.</p>`;
    }

    function amazonRowHtml(r: ReturnRow): string {
      return `<tr>
        <td style="font-weight: 700;">${escapeHtml(r.externalOrderId)}</td>
        <td>${escapeHtml(r.itemName || r.skuName || '—')}</td>
        <td style="font-size: 0.82rem; color: var(--muted);">${escapeHtml(r.merchantSku || r.asin || '—')}</td>
        <td>${escapeHtml(r.returnReason || '—')}</td>
        <td>${r.returnRequestDate ? escapeHtml(r.returnRequestDate.slice(0, 10)) : '—'}</td>
        <td style="font-size: 0.82rem; color: var(--muted);">${escapeHtml(r.trackingId || '—')}</td>
        <td><span class="pill">${STATUS_LABELS[r.status] ?? r.status}</span></td>
      </tr>`;
    }

    // What the floor has actually reported: daily headcount confirmations
    // (see confirmTodayReceipt in lib/returns.ts) plus the inspection
    // outcome queue, still with the claim-filing action for safe_to_claim.
    function renderPackerTab(container: HTMLElement) {
      container.innerHTML = `
        <span class="eyebrow">Daily receiving confirmations</span>
        ${
          receipts.length
            ? `<div class="table-scroll" style="margin-top: 8px;">
                 <table>
                   <thead><tr><th>Date</th><th>Expected</th><th>Received</th><th>Confirmed by</th><th>Confirmed at</th></tr></thead>
                   <tbody>${receipts.map((r) => receiptRowHtml(r)).join('')}</tbody>
                 </table>
               </div>`
            : `<p style="margin: 8px 0 0;">No receiving counts confirmed yet.</p>`
        }

        <div class="row" style="justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 22px;">
          <span class="eyebrow">Inspection outcomes</span>
          <select id="status-filter" style="max-width: 220px;">
            ${Object.entries(STATUS_LABELS)
              .filter(([value]) => value !== 'expected' && value !== 'received')
              .map(([value, label]) => `<option value="${value}" ${value === packerStatusFilter ? 'selected' : ''}>${label}</option>`)
              .join('')}
          </select>
        </div>
        <div class="stack" style="gap: 10px; margin-top: 10px;" data-packer-list></div>`;

      const list = container.querySelector('[data-packer-list]') as HTMLElement;
      list.innerHTML = packerRows.length ? packerRows.map((r) => packerRowHtml(r)).join('') : '<p>No returns in this status.</p>';

      container.querySelector('#status-filter')?.addEventListener('change', async (e) => {
        packerStatusFilter = (e.currentTarget as HTMLSelectElement).value;
        await loadPackerRows();
        render();
      });
      packerRows.forEach((r) => {
        if (r.status === 'safe_to_claim') {
          container.querySelector(`#file-claim-${r.id}`)?.addEventListener('click', (e) => fileClaim(r, e.currentTarget as HTMLButtonElement));
        }
      });
    }

    function receiptRowHtml(r: ReceiptRow): string {
      const short = r.receivedCount < r.expectedCount;
      return `<tr>
        <td>${escapeHtml(r.receiptDate)}</td>
        <td>${r.expectedCount}</td>
        <td style="${short ? 'color: var(--warning-fg); font-weight: 700;' : ''}">${r.receivedCount}</td>
        <td>${escapeHtml(r.confirmedByName || '—')}</td>
        <td style="font-size: 0.82rem; color: var(--muted);">${new Date(r.confirmedAt).toLocaleString(undefined, { day: '2-digit', month: 'short', hour: 'numeric', minute: '2-digit' })}</td>
      </tr>`;
    }

    function packerRowHtml(r: ReturnRow): string {
      return `<div class="card row" style="gap: 12px; align-items: flex-start; flex-wrap: wrap;">
        ${r.imageUrl ? `<img class="thumb" src="${r.imageUrl}" alt="" />` : '<div class="thumb"></div>'}
        <div class="stack" style="gap: 2px; flex: 1; min-width: 180px;">
          <span style="font-weight: 700;">${escapeHtml(r.itemName || r.skuName || 'Unknown item')}</span>
          <span style="font-size: 0.8rem; color: var(--muted);">Order ${escapeHtml(r.externalOrderId)}${r.skuCode ? ` · SKU ${escapeHtml(r.skuCode)}` : ''}</span>
          <span style="font-size: 0.8rem; color: var(--muted);">Reason: ${escapeHtml(r.returnReason || 'Not given')}</span>
          ${r.trackingId ? `<span style="font-size: 0.78rem; color: var(--muted);">AWB ${escapeHtml(r.trackingId)}</span>` : ''}
        </div>
        ${
          r.status === 'safe_to_claim'
            ? `<div class="row" style="gap: 8px; align-items: center;">
                 ${r.labelImageKey ? `<a href="/api/returns/image?returnId=${r.id}&type=label" target="_blank" class="pill" style="text-decoration: none;">Label photo</a>` : ''}
                 ${r.productImageKey ? `<a href="/api/returns/image?returnId=${r.id}&type=product" target="_blank" class="pill" style="text-decoration: none;">Product photo</a>` : ''}
                 <button class="btn btn-primary" id="file-claim-${r.id}" style="width: auto;">Mark claim filed</button>
               </div>`
            : `<span class="pill">${STATUS_LABELS[r.status] ?? r.status}</span>`
        }
      </div>`;
    }

    async function saveOtp(btn: HTMLButtonElement) {
      const value = (document.getElementById('otp-input') as HTMLInputElement).value.trim();
      if (!value) return;
      const countRaw = (document.getElementById('otp-valid-count-input') as HTMLInputElement).value.trim();
      const validForCount = countRaw === '' ? null : Number(countRaw);
      await withLoading(btn, 'Saving…', async () => {
        await api('/api/admin/returns/otp', { warehouseId, otp: value, validForCount });
        await loadOtp();
        render();
      });
    }

    async function fileClaim(r: ReturnRow, btn: HTMLButtonElement) {
      await withLoading(btn, 'Saving…', async () => {
        await api('/api/admin/returns', { returnId: r.id }, 'PATCH');
        await loadPackerRows();
        render();
      });
    }

    boot();
  </script>
</AdminShell>
