---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import PackerSidebar from '../../components/PackerSidebar.astro';
import { getDb } from '../../lib/db';
import { getCurrentUser, toClientUser } from '../../lib/auth';
import { getExpectedReturns, getReceivedReturns, getTodayOtp, getTodayReceipt } from '../../lib/returns';

const db = getDb();
const user = await getCurrentUser(Astro, db);
if (!user) return Astro.redirect('/login');
const serverUser = toClientUser(user);

const initialData =
  user.role === 'packer' && user.warehouse_id
    ? {
        expected: await getExpectedReturns(db, user.warehouse_id),
        received: await getReceivedReturns(db, user.warehouse_id),
        otp: await getTodayOtp(db, user.warehouse_id),
        receipt: await getTodayReceipt(db, user.warehouse_id)
      }
    : null;
---

<Base title="Returns">
  <div class="screen">
    <PackerSidebar current="returns" />
    <TopBar section="Returns" homeHref="/packer/home">
      <a href="/picker" class="pill tab-pill" style="text-decoration: none;">Pick<span class="badge-dot" id="badge-pick"></span></a>
      <a href="/packer" class="pill tab-pill" style="text-decoration: none;">Pack<span class="badge-dot" id="badge-pack"></span></a>
      <a href="/packer/scan" class="pill tab-pill" style="text-decoration: none;">Scan</a>
      <a href="/dashboard" class="pill tab-pill" style="text-decoration: none;">Today</a>
    </TopBar>

    <div id="app" class="stack" style="flex: 1;">
      <p>Loading…</p>
    </div>
  </div>

  <script define:vars={{ serverUser, initialData }}>
    window.__serverUser = serverUser;
    window.__initialData = initialData;
  </script>
  <script>
    import { startContinuousScan, stopScanning } from '../../lib/scanner-client';
    import { escapeHtml, withLoading } from '../../lib/ui';

    interface ReturnRow {
      id: string;
      externalOrderId: string;
      amazonRmaId: string | null;
      asin: string | null;
      merchantSku: string | null;
      itemName: string | null;
      returnReason: string | null;
      trackingId: string | null;
      returnRequestDate: string | null;
      status: string;
      skuCode: string | null;
      skuName: string | null;
      imageUrl: string | null;
      customerName: string | null;
    }

    // Which scan session (if either) currently owns the camera — the
    // receiving stage and the inspect stage each get their own scan area
    // (different match target: 'expected' vs 'received'), but only one can
    // reasonably be open at a time. scanner-client's own startContinuousScan
    // stops whichever was running first, so this is just for knowing which
    // UI to tear down/rebuild.
    type ScanMode = 'receiving' | 'inspect' | null;

    interface Receipt {
      expectedCount: number;
      receivedCount: number;
      confirmedAt: string;
    }

    const app = document.getElementById('app')!;
    let expected: ReturnRow[] = [];
    let received: ReturnRow[] = [];
    let otp: { otp: string; setAt: string; validForCount: number | null } | null = null;
    let receipt: Receipt | null = null;
    let scanning: ScanMode = null;
    let active: ReturnRow | null = null; // the return currently being inspected
    let flash: { kind: 'success' | 'danger'; message: string } | null = null;

    async function api(path: string, body?: unknown, method?: string) {
      const res = await fetch(path, {
        method: method ?? (body === undefined ? 'GET' : 'POST'),
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    async function boot() {
      const user = (window as any).__serverUser;
      if (user.role !== 'packer') {
        app.innerHTML = `<p>This account is a "${user.role}", not a packer.</p>`;
        return;
      }
      const initial = (window as any).__initialData;
      if (initial) {
        expected = initial.expected ?? [];
        received = initial.received ?? [];
        otp = initial.otp ?? null;
        receipt = initial.receipt ?? null;
      } else {
        await refresh();
      }
      render();
      setInterval(async () => {
        if (document.hidden || scanning || active) return;
        await refresh();
        render();
      }, 15000);
    }

    async function refresh() {
      try {
        const data = await api(`/api/packer/returns`);
        expected = data.expected ?? [];
        received = data.received ?? [];
        otp = data.otp ?? null;
        receipt = data.receipt ?? null;
      } catch {
        // Transient — keep whatever we already had.
      }
    }

    function flashHtml(): string {
      return flash ? `<div class="banner banner-${flash.kind}" id="flash">${escapeHtml(flash.message)}</div>` : '<div id="flash"></div>';
    }

    // Updates just the banner in place, without touching the rest of the
    // form — a full render() on a save error would reset the packer's
    // in-progress status pick and any chosen photos back to the defaults,
    // which is exactly the moment they most need those to stick around.
    function showFlash(kind: 'success' | 'danger', message: string) {
      flash = { kind, message };
      const existing = document.getElementById('flash');
      if (existing) existing.outerHTML = flashHtml();
    }

    function render() {
      if (active) return renderInspect(active);
      return renderQueue();
    }

    // The sequence is deliberate, per how the floor actually works: know
    // what's still awaiting receipt before asking for the OTP (so you can
    // sanity-check what the courier hands over), get the OTP, set a target
    // count, then scan (or manually mark) each specific box as it's handed
    // over — which is what actually moves that one return from "awaiting
    // receipt" into "received" (see markReturnReceived in lib/returns.ts) —
    // and only *received* returns can be inspected. The receive step is
    // repeatable all day, not a one-time gate: a second courier drop later
    // just adds to today's target.
    function renderQueue() {
      app.innerHTML = `
        ${flashHtml()}
        <div class="card stack" style="gap: 8px;">
          <span class="eyebrow">Awaiting receipt</span>
          <p style="margin: 0; font-size: 1.3rem; font-weight: 800;">${expected.length}</p>
          <p style="margin: 0; font-size: 0.78rem; color: var(--muted);">Synced from Amazon, not yet confirmed received — may include returns from previous days still in transit.</p>
          <div class="stack" style="gap: 10px; margin-top: 4px;" data-expected-list></div>
        </div>

        <div class="card stack" style="gap: 10px; margin-top: 14px;">
          <span class="eyebrow">Today's return OTP</span>
          ${
            otp
              ? `<div class="row" style="align-items: baseline; gap: 10px; flex-wrap: wrap;">
                   <span style="font-size: 1.6rem; font-weight: 800; letter-spacing: 0.06em; font-variant-numeric: tabular-nums;">${escapeHtml(otp.otp)}</span>
                   <span style="font-size: 0.78rem; color: var(--muted);">Give this to the courier/agent at hand-off</span>
                   ${
                     otp.validForCount !== null
                       ? `<span class="pill" style="font-weight: 700;">Valid for ${otp.validForCount} return${otp.validForCount === 1 ? '' : 's'}</span>`
                       : ''
                   }
                 </div>`
              : `<p style="margin: 0;">No OTP set for today yet — ask an admin to add it (Admin → Returns).</p>`
          }
        </div>

        <div class="card stack" style="gap: 10px; margin-top: 14px;" data-receipt></div>

        <div class="row" style="justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 18px;">
          <span class="eyebrow">Inspect &amp; update status (${received.length})</span>
          ${received.length ? `<button class="btn btn-primary" id="start-inspect-scan" style="width: auto;">Scan a return</button>` : ''}
        </div>
        <div id="inspect-scan-area"></div>
        <div class="stack" style="gap: 10px; margin-top: 10px;">
          ${received.length ? received.map((r) => queueRowHtml(r)).join('') : `<p>Nothing confirmed received yet — receive some above first.</p>`}
        </div>`;

      renderExpectedList();
      renderReceiptCard();

      document.getElementById('start-inspect-scan')?.addEventListener('click', beginInspectScanning);
      received.forEach((r) => {
        document.getElementById(`open-${r.id}`)?.addEventListener('click', () => {
          active = r;
          flash = null;
          render();
        });
      });
    }

    // Each row gets its own "Mark received" fallback for a label a scanner
    // can't read — a deliberate per-return action the packer takes on the
    // specific box in front of them, not a way to bulk-skip scanning
    // everything (that's exactly the blind-guess behavior this replaced).
    function renderExpectedList() {
      const container = document.querySelector('[data-expected-list]') as HTMLElement | null;
      if (!container) return;
      container.innerHTML = expected.length
        ? expected.map((r) => expectedRowHtml(r)).join('')
        : `<p style="margin: 0; font-size: 0.85rem; color: var(--muted);">Nothing awaiting receipt.</p>`;
      expected.forEach((r) => {
        document.getElementById(`mark-received-${r.id}`)?.addEventListener('click', (e) => markReceivedManually(r, e.currentTarget as HTMLButtonElement));
      });
    }

    function expectedRowHtml(r: ReturnRow): string {
      return `<div class="item-row">
        ${r.imageUrl ? `<img class="thumb" src="${r.imageUrl}" alt="" />` : '<div class="thumb"></div>'}
        <div class="stack" style="gap: 2px; flex: 1; min-width: 0;">
          <span style="font-weight: 700;">${escapeHtml(r.itemName || r.skuName || r.merchantSku || 'Unknown item')}</span>
          <span style="font-size: 0.78rem; color: var(--muted);">${escapeHtml(r.externalOrderId)} · ${escapeHtml(r.returnReason || 'No reason given')}</span>
          <span style="font-size: 0.72rem; color: var(--muted);">Requested ${r.returnRequestDate ? escapeHtml(r.returnRequestDate) : 'unknown date'}${r.trackingId ? ` · AWB ${escapeHtml(r.trackingId)}` : ''}</span>
        </div>
        <button class="btn btn-ghost" id="mark-received-${r.id}" style="width: auto; padding: 6px 12px; font-size: 0.78rem;">Mark received</button>
      </div>`;
    }

    // Scanning is the primary path (see beginReceivingScanning below); the
    // count here is a target to scan up to, not an action on any return —
    // see setReceivingTarget in lib/returns.ts for why confirmTodayReceipt's
    // blind FIFO assignment was replaced. receivedCount always reflects the
    // real, scan/manually-verified count, shown next to the courier's own
    // claimed number so a mismatch is visible instead of hidden.
    function renderReceiptCard() {
      const container = document.querySelector('[data-receipt]') as HTMLElement | null;
      if (!container) return;

      const target = receipt?.expectedCount ?? 0;
      const actual = receipt?.receivedCount ?? 0;
      const short = receipt && actual < target;

      container.innerHTML = `
        <span class="eyebrow">Confirm returns received</span>
        <p style="margin: 0; font-size: 0.85rem; color: var(--muted);">How many did the courier say they handed over just now? (${expected.length} awaiting receipt)</p>
        <div class="row" style="gap: 8px; align-items: center;">
          <input type="number" id="received-count" min="0" value="" placeholder="e.g. 3" style="width: 90px;" />
          <button class="btn btn-primary" id="confirm-receipt" style="width: auto;">Set target</button>
        </div>
        ${
          receipt
            ? `<div class="row" style="align-items: baseline; gap: 10px; margin-top: 6px;">
                 <span style="font-size: 1.3rem; font-weight: 800; ${short ? 'color: var(--warning-fg);' : ''}">${actual} of ${target} scanned</span>
                 ${short ? `<span class="pill" style="color: var(--warning-fg);">${target - actual} short</span>` : ''}
               </div>
               <p style="margin: 0; font-size: 0.78rem; color: var(--muted);">Last update ${new Date(receipt.confirmedAt).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' })}</p>
               <button class="btn btn-primary" id="start-receiving-scan" style="margin-top: 8px;">Scan returns</button>
               <div id="receiving-scan-area"></div>`
            : ''
        }`;
      document.getElementById('confirm-receipt')?.addEventListener('click', (e) => confirmReceiptTarget(e.currentTarget as HTMLButtonElement));
      document.getElementById('start-receiving-scan')?.addEventListener('click', beginReceivingScanning);
    }

    async function confirmReceiptTarget(btn: HTMLButtonElement) {
      const input = document.getElementById('received-count') as HTMLInputElement;
      const receivedCount = Number(input.value || 0);
      await withLoading(btn, 'Saving…', async () => {
        try {
          await api('/api/packer/returns/confirm-receipt', { receivedCount });
          await refresh();
          render();
        } catch (err) {
          showFlash('danger', (err as Error).message);
        }
      });
    }

    async function markReceivedManually(r: ReturnRow, btn: HTMLButtonElement) {
      await withLoading(btn, '…', async () => {
        try {
          await api('/api/packer/returns/receive-manual', { returnId: r.id });
          flash = { kind: 'success', message: `${r.externalOrderId} marked received.` };
          await refresh();
          render();
        } catch (err) {
          showFlash('danger', (err as Error).message);
        }
      });
    }

    function queueRowHtml(r: ReturnRow): string {
      return `<div class="item-row" id="open-${r.id}" style="cursor: pointer;">
        ${r.imageUrl ? `<img class="thumb" src="${r.imageUrl}" alt="" />` : '<div class="thumb"></div>'}
        <div class="stack" style="gap: 2px; flex: 1; min-width: 0;">
          <span style="font-weight: 700;">${escapeHtml(r.itemName || r.skuName || r.merchantSku || 'Unknown item')}</span>
          <span style="font-size: 0.78rem; color: var(--muted);">${escapeHtml(r.externalOrderId)} · ${escapeHtml(r.returnReason || 'No reason given')}</span>
          ${r.trackingId ? `<span style="font-size: 0.75rem; color: var(--muted);">AWB ${escapeHtml(r.trackingId)}</span>` : ''}
        </div>
      </div>`;
    }

    // Generic scan-UI mount shared by both stages — receiving (matches
    // 'expected') and inspect (matches 'received') each pass their own
    // container/ids and code handler, since scanner-client's own
    // startContinuousScan already stops whichever session was running
    // first if both somehow get opened.
    function mountScanUI(opts: {
      containerId: string;
      videoId: string;
      wrapId: string;
      inputId: string;
      stopId: string | null;
      placeholder: string;
      onCode: (code: string) => void;
      onStop?: () => void;
    }) {
      const container = document.getElementById(opts.containerId)!;
      container.innerHTML = `
        <video class="scanner" id="${opts.videoId}" style="margin-top: 10px;"></video>
        <div class="stack" id="${opts.wrapId}" style="margin-top: 10px; gap: 4px; cursor: text;">
          <span style="font-size: 0.72rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.02em;">Handheld scanner input — tap here first</span>
          <div class="row" style="gap: 8px;">
            <input type="text" id="${opts.inputId}" placeholder="${opts.placeholder}" autocomplete="off" autocapitalize="off" />
            ${opts.stopId ? `<button class="btn btn-ghost" id="${opts.stopId}" style="width: auto;">Cancel</button>` : ''}
          </div>
        </div>`;
      if (opts.stopId && opts.onStop) document.getElementById(opts.stopId)?.addEventListener('click', opts.onStop);
      const manualInput = document.getElementById(opts.inputId) as HTMLInputElement;
      manualInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const code = manualInput.value.trim();
          if (code) {
            manualInput.value = '';
            opts.onCode(code);
          }
        }
      });
      // A handheld/Bluetooth scanner is a keyboard wedge — it types into
      // whatever already has focus, no click possible mid-scan. Focusing
      // this the moment scan mode opens means it just works without a
      // packer having to first tap the tiny text field by hand; clicking
      // anywhere in the labeled row re-focuses it too, in case focus ever
      // lands elsewhere (e.g. the camera permission prompt).
      document.getElementById(opts.wrapId)?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).id !== opts.stopId) manualInput.focus();
      });
      manualInput.focus();
      const video = document.getElementById(opts.videoId) as HTMLVideoElement;
      startContinuousScan(video, opts.onCode, () => {
        // No camera/permission — swap just the video element for an inline
        // notice and keep going in manual mode, same fix as the Scan/Pack
        // pages: tearing the whole UI down here would destroy the exact
        // text field the message points the packer to.
        video.outerHTML = '<div class="banner banner-danger" style="margin-top: 10px;">Could not open camera — use the text field below to enter codes instead.</div>';
        manualInput.focus();
      });
    }

    function beginReceivingScanning() {
      scanning = 'receiving';
      mountScanUI({
        containerId: 'receiving-scan-area',
        videoId: 'receiving-video',
        wrapId: 'receiving-manual-code-wrap',
        inputId: 'receiving-manual-code',
        stopId: 'stop-receiving-scan',
        placeholder: 'Or type the AWB or order id and press Enter',
        onCode: handleReceivingScannedCode,
        onStop: endReceivingScanning
      });
    }

    function endReceivingScanning() {
      stopScanning();
      scanning = null;
      render();
    }

    async function handleReceivingScannedCode(code: string) {
      try {
        await api('/api/packer/returns/receive-scan', { code });
        flash = null;
        await refresh();
        render();
        // Re-open the scanner immediately after a re-render — receiving is
        // continuous (one box after another), not a single-shot action like
        // inspect's "open this one return" handoff.
        if (receipt && receipt.receivedCount < receipt.expectedCount) beginReceivingScanning();
      } catch (err) {
        showFlash('danger', (err as Error).message);
      }
    }

    function beginInspectScanning() {
      scanning = 'inspect';
      mountScanUI({
        containerId: 'inspect-scan-area',
        videoId: 'inspect-video',
        wrapId: 'inspect-manual-code-wrap',
        inputId: 'inspect-manual-code',
        stopId: 'stop-inspect-scan',
        placeholder: 'Or type the AWB or order id and press Enter',
        onCode: handleInspectScannedCode,
        onStop: endInspectScanning
      });
    }

    function endInspectScanning() {
      stopScanning();
      scanning = null;
      render();
    }

    async function handleInspectScannedCode(code: string) {
      try {
        const found = await api('/api/packer/returns/scan', { code });
        stopScanning();
        scanning = null;
        active = found;
        flash = null;
        render();
      } catch (err) {
        flash = { kind: 'danger', message: (err as Error).message };
      }
    }

    function renderInspect(r: ReturnRow) {
      app.innerHTML = `
        ${flashHtml()}
        <button class="btn btn-ghost" id="back-to-queue" style="width: auto;">&larr; Back</button>
        <div class="card stack" style="gap: 10px; margin-top: 10px;">
          <div class="row" style="gap: 12px; align-items: flex-start;">
            ${r.imageUrl ? `<img class="thumb" src="${r.imageUrl}" alt="" style="width: 64px; height: 64px;" />` : '<div class="thumb" style="width: 64px; height: 64px;"></div>'}
            <div class="stack" style="gap: 2px;">
              <span style="font-weight: 700; font-size: 1.05rem;">${escapeHtml(r.itemName || r.skuName || r.merchantSku || 'Unknown item')}</span>
              <span style="font-size: 0.85rem; color: var(--muted);">Order ${escapeHtml(r.externalOrderId)}${r.customerName ? ` · ${escapeHtml(r.customerName)}` : ''}</span>
              ${r.skuCode ? `<span style="font-size: 0.8rem; color: var(--muted);">SKU ${escapeHtml(r.skuCode)}</span>` : ''}
              <span style="font-size: 0.8rem; color: var(--muted);">Reason: ${escapeHtml(r.returnReason || 'Not given')}</span>
              ${r.trackingId ? `<span style="font-size: 0.8rem; color: var(--muted);">AWB ${escapeHtml(r.trackingId)}</span>` : ''}
            </div>
          </div>

          <label class="stack" style="gap: 4px;">
            <span class="eyebrow">Inspection result</span>
            <select id="status-select">
              <option value="ready_to_repack">Ready to repack</option>
              <option value="unsellable">Unsellable</option>
              <option value="safe_to_claim">Safe to claim (SAFE-T)</option>
            </select>
          </label>

          <div id="claim-fields" class="stack" style="gap: 10px; display: none;">
            <label class="stack" style="gap: 4px;">
              <span class="eyebrow">Label photo</span>
              <input type="file" id="label-photo" accept="image/jpeg,image/png,image/webp" capture="environment" />
            </label>
            <label class="stack" style="gap: 4px;">
              <span class="eyebrow">Product photo</span>
              <input type="file" id="product-photo" accept="image/jpeg,image/png,image/webp" capture="environment" />
            </label>
          </div>

          <button class="btn btn-primary" id="save-inspection">Save</button>
        </div>`;

      document.getElementById('back-to-queue')?.addEventListener('click', () => {
        active = null;
        render();
      });
      const statusSelect = document.getElementById('status-select') as unknown as HTMLSelectElement;
      const claimFields = document.getElementById('claim-fields')!;
      statusSelect.addEventListener('change', () => {
        claimFields.style.display = statusSelect.value === 'safe_to_claim' ? 'flex' : 'none';
      });
      document.getElementById('save-inspection')?.addEventListener('click', (e) => saveInspection(r, e.currentTarget as HTMLButtonElement));
    }

    async function uploadImage(returnId: string, kind: 'label' | 'product', file: File): Promise<string> {
      const form = new FormData();
      form.append('returnId', returnId);
      form.append('type', kind);
      form.append('file', file);
      const res = await fetch('/api/packer/returns/upload-image', { method: 'POST', body: form });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Upload failed (${res.status})`);
      return data.key;
    }

    async function saveInspection(r: ReturnRow, btn: HTMLButtonElement) {
      const status = (document.getElementById('status-select') as unknown as HTMLSelectElement).value;
      const labelInput = document.getElementById('label-photo') as HTMLInputElement;
      const productInput = document.getElementById('product-photo') as HTMLInputElement;

      await withLoading(btn, 'Saving…', async () => {
        try {
          let labelImageKey: string | undefined;
          let productImageKey: string | undefined;
          if (status === 'safe_to_claim') {
            if (!labelInput.files?.[0] || !productInput.files?.[0]) {
              throw new Error('Safe-to-claim needs both a label photo and a product photo');
            }
            labelImageKey = await uploadImage(r.id, 'label', labelInput.files[0]);
            productImageKey = await uploadImage(r.id, 'product', productInput.files[0]);
          }
          await api('/api/packer/returns/inspect', { returnId: r.id, status, labelImageKey, productImageKey });
          active = null;
          flash = { kind: 'success', message: `Saved — ${r.externalOrderId} marked ${status.replace(/_/g, ' ')}.` };
          await refresh();
          render();
        } catch (err) {
          showFlash('danger', (err as Error).message);
        }
      });
    }

    boot();
  </script>
</Base>
