---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
---

<Base title="Dashboard">
  <div class="screen">
    <TopBar section="Dashboard" homeHref="/packer/home">
      <a href="/picker" class="pill tab-pill" style="text-decoration: none;">Pick<span class="badge-dot" id="badge-pick"></span></a>
      <a href="/packer" class="pill tab-pill" style="text-decoration: none;">Pack<span class="badge-dot" id="badge-pack"></span></a>
      <a href="/packer/scan" class="pill tab-pill" style="text-decoration: none;">Scan</a>
      <a href="/dashboard" class="pill tab-pill" style="text-decoration: none;">Today</a>
    </TopBar>

    <div id="app" class="stack" style="flex: 1;">
      <p>Loading…</p>
    </div>
  </div>

  <script>
    import { escapeHtml } from '../../lib/ui';

    interface MyBatch {
      batchId: string;
      orderCount: number;
      skuCount: number;
      remaining: number;
    }
    interface SkuDemandRow {
      skuId: string;
      skuCode: string;
      skuName: string;
      imageUrl: string | null;
      orderCount: number;
      unitsNeeded: number;
    }
    interface UnbatchedSummary {
      orderCount: number;
      skuCount: number;
      unitCount: number;
    }
    interface DailyOrder {
      orderId: string;
      externalOrderId: string;
      outcome: 'completed' | 'partial';
      completedAt: string;
      unitsPacked: number;
      imageUrl: string | null;
    }
    interface DailySummary {
      orderCount: number;
      unitsPacked: number;
      orders: DailyOrder[];
    }

    const app = document.getElementById('app')!;
    let warehouseId = '';

    async function api(path: string, body?: unknown) {
      const res = await fetch(path, {
        method: body === undefined ? 'GET' : 'POST',
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    function pollWorkBadge() {
      setInterval(async () => {
        if (document.hidden) return;
        try {
          const summary = await api(`/api/packer/work-summary?warehouseId=${warehouseId}`);
          document.getElementById('badge-pick')?.classList.toggle('show', summary.pickable > 0);
          document.getElementById('badge-pack')?.classList.toggle('show', summary.packable > 0);
        } catch {
          // Badge is a convenience, not load-bearing — ignore transient failures.
        }
      }, 10000);
    }

    async function boot() {
      const me = await api('/api/auth/me');
      if (!me.user) {
        window.location.href = '/login';
        return;
      }
      if (me.user.role !== 'packer') {
        app.innerHTML = `<p>This account is a "${me.user.role}" — the packer dashboard needs a packer login.</p>`;
        return;
      }
      warehouseId = me.user.warehouseId;
      pollWorkBadge();

      await load();
      setInterval(() => {
        if (!document.hidden) load();
      }, 15000);
    }

    async function load() {
      try {
        const [data, demand] = await Promise.all([
          api(`/api/packer/dashboard?warehouseId=${warehouseId}`),
          api(`/api/picker/sku-demand?warehouseId=${warehouseId}`)
        ]);
        render(data.myBatches ?? [], demand ?? [], data.unbatched ?? null, data.today ?? null);
      } catch (err) {
        app.innerHTML = `<div class="banner banner-danger">${(err as Error).message}</div>`;
      }
    }

    function formatTime(iso: string): string {
      return new Date(iso).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
    }

    function render(myBatches: MyBatch[], demand: SkuDemandRow[], unbatched: UnbatchedSummary | null, today: DailySummary | null) {
      app.innerHTML = `
        <div class="stat-grid">
          <div class="stat-card stat-card-accent-success">
            <span class="stat-card-value">${today?.orderCount ?? 0}</span>
            <span class="stat-card-label">Orders packed today</span>
          </div>
          <div class="stat-card stat-card-accent-neutral">
            <span class="stat-card-value">${today?.unitsPacked ?? 0}</span>
            <span class="stat-card-label">Units packed today</span>
          </div>
        </div>

        <div class="stack" style="gap: 10px; margin-top: 8px;">
          <span class="eyebrow">Assigned to you</span>
          ${
            myBatches.length
              ? (() => {
                  const totalOrders = myBatches.reduce((sum, b) => sum + b.orderCount, 0);
                  const remaining = myBatches.reduce((sum, b) => sum + b.remaining, 0);
                  return `
                <div class="card">
                  <div class="row" style="justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                    <div class="stack" style="gap: 2px;">
                      <span style="font-weight: 600;">${totalOrders} order${totalOrders > 1 ? 's' : ''} in progress</span>
                      <span style="font-size: 0.8rem; color: var(--muted);">${remaining > 0 ? `${remaining} line${remaining > 1 ? 's' : ''} still to pick` : 'Picking complete — ready to pack'}</span>
                    </div>
                    <a class="btn btn-primary" style="width: auto; text-decoration: none;" href="${remaining > 0 ? '/picker' : '/packer'}">${remaining > 0 ? 'Go to picking' : 'Go to packing'}</a>
                  </div>
                </div>`;
                })()
              : `<p>Nothing assigned to you right now — head to <a href="/picker">Pick</a> and one will be swept up automatically.</p>`
          }
        </div>

        <div class="stack" style="gap: 10px; margin-top: 8px;">
          <span class="eyebrow">Upcoming — pulled, not yet assigned</span>
          ${
            // Not always a real stock shortage — this order just hasn't been
            // retried yet. The sync job now retries automatically every
            // ~5 minutes (sync-job.ts), so this should self-clear on its own
            // shortly; it only needs stock if it's still here after a while.
            unbatched && unbatched.orderCount > 0
              ? `<div class="banner banner-danger">${unbatched.orderCount} order${unbatched.orderCount > 1 ? 's' : ''} waiting to be assigned (${unbatched.unitCount} unit${unbatched.unitCount > 1 ? 's' : ''} needed) — rechecks automatically every few minutes. Still here a while? <a href="/admin/inbound">Receive stock</a> if it's genuinely short.</div>`
              : ''
          }
          ${
            demand.length
              ? `<div class="stack" style="gap: 8px;">
                  ${demand
                    .map(
                      (d) => `
                    <div class="item-row">
                      ${d.imageUrl ? `<img class="thumb" src="${d.imageUrl}" alt="" />` : '<div class="thumb"></div>'}
                      <div class="stack" style="gap: 2px; flex: 1; min-width: 0;">
                        <span style="font-weight: 700;">${escapeHtml(d.skuCode)}</span>
                        <span style="font-size: 0.78rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${escapeHtml(d.skuName)}</span>
                      </div>
                      <span class="status-pill status-neutral">${d.unitsNeeded} unit${d.unitsNeeded > 1 ? 's' : ''} · ${d.orderCount} order${d.orderCount > 1 ? 's' : ''}</span>
                    </div>`
                    )
                    .join('')}
                </div>`
              : !unbatched || unbatched.orderCount === 0
                ? `<p>Nothing waiting — every pulled order is already assigned.</p>`
                : ''
          }
        </div>

        <div class="stack" style="gap: 10px; margin-top: 8px;">
          <span class="eyebrow">Today — what you've packed</span>
          ${
            today && today.orders.length
              ? `<div class="table-scroll"><table>
                  <thead><tr><th></th><th>Order ID</th><th>Time</th><th>Units</th><th>Outcome</th></tr></thead>
                  <tbody>
                    ${today.orders
                      .map(
                        (o) => `<tr>
                          <td>${o.imageUrl ? `<img class="table-thumb" src="${o.imageUrl}" alt="" />` : ''}</td>
                          <td style="font-weight:700; font-variant-numeric: tabular-nums;">${escapeHtml(o.externalOrderId)}</td>
                          <td>${formatTime(o.completedAt)}</td>
                          <td>${o.unitsPacked}</td>
                          <td><span class="status-pill ${o.outcome === 'completed' ? 'status-success' : 'status-warning'}">${o.outcome}</span></td>
                        </tr>`
                      )
                      .join('')}
                  </tbody>
                </table></div>`
              : `<p>Nothing packed yet today.</p>`
          }
        </div>`;
    }

    boot();
  </script>
</Base>
