---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import { getDb } from '../../lib/db';
import { getCurrentUser, toClientUser } from '../../lib/auth';
import { getMyActiveBatches, getPickListView, getUnassignedSkuDemand } from '../../lib/picker';
import { getUnbatchedOrderSummary } from '../../lib/orders';
import { getPackerDailySummary } from '../../lib/packer';

// Resolved server-side now instead of the client fetching /api/auth/me after
// the page loads — see toClientUser in lib/auth.ts for why. Not logged in
// still redirects the same way requireAdminPage does for /admin pages.
const db = getDb();
const user = await getCurrentUser(Astro, db);
if (!user) return Astro.redirect('/login');
const serverUser = toClientUser(user);

// Same idea, one step further: this page's own boot() used to always fetch
// /api/packer/dashboard + /api/picker/sku-demand after the page loaded,
// leaving "Loading…" on screen for a full extra round trip on every tab
// switch (found live: full-page nav between Pick/Pack/Scan/Today is a real
// MPA navigation, not a client-side route change, so that round trip stacks
// on top of the navigation itself). Mirroring the exact queries
// /api/packer/dashboard and /api/picker/sku-demand run, so the first paint
// already has real content — the client script still re-fetches on its own
// poll interval for anything that changes after load.
let initialData: { myBatches: unknown[]; unbatched: unknown; today: unknown; demand: unknown } | null = null;
if (user.role === 'packer' && user.warehouse_id) {
  const myBatchIds = await getMyActiveBatches(db, user.warehouse_id, user.id);
  const myBatches = [];
  for (const batchId of myBatchIds) {
    const rows = await getPickListView(db, batchId);
    myBatches.push({
      batchId,
      orderCount: new Set(rows.map((r) => r.external_order_id)).size,
      skuCount: new Set(rows.map((r) => r.sku_code)).size,
      remaining: rows.filter((r) => r.status === 'pending').length
    });
  }
  const unbatched = await getUnbatchedOrderSummary(db, user.warehouse_id);
  const today = await getPackerDailySummary(db, user.warehouse_id, user.id);
  const demand = await getUnassignedSkuDemand(db, user.warehouse_id);
  initialData = { myBatches, unbatched, today, demand };
}
---

<Base title="Dashboard">
  <div class="screen">
    <TopBar section="Dashboard" homeHref="/packer/home">
      <a href="/picker" class="pill tab-pill" style="text-decoration: none;">Pick<span class="badge-dot" id="badge-pick"></span></a>
      <a href="/packer" class="pill tab-pill" style="text-decoration: none;">Pack<span class="badge-dot" id="badge-pack"></span></a>
      <a href="/packer/scan" class="pill tab-pill" style="text-decoration: none;">Scan</a>
      <a href="/dashboard" class="pill tab-pill" style="text-decoration: none;">Today</a>
    </TopBar>

    <div id="app" class="stack" style="flex: 1;">
      <p>Loading…</p>
    </div>
  </div>

  <script define:vars={{ serverUser, initialData }}>
    window.__serverUser = serverUser;
    window.__initialData = initialData;
  </script>
  <script>
    import { escapeHtml, withLoading } from '../../lib/ui';

    interface MyBatch {
      batchId: string;
      orderCount: number;
      skuCount: number;
      remaining: number;
    }
    interface SkuDemandRow {
      skuId: string;
      skuCode: string;
      skuName: string;
      imageUrl: string | null;
      orderCount: number;
      unitsNeeded: number;
    }
    interface UnbatchedSummary {
      orderCount: number;
      skuCount: number;
      unitCount: number;
    }
    interface DailyOrder {
      orderId: string;
      externalOrderId: string;
      outcome: 'completed' | 'partial';
      completedAt: string;
      unitsPacked: number;
      imageUrl: string | null;
    }
    interface DailySummary {
      orderCount: number;
      unitsPacked: number;
      orders: DailyOrder[];
    }

    const app = document.getElementById('app')!;
    let warehouseId = '';

    async function api(path: string, body?: unknown) {
      const res = await fetch(path, {
        method: body === undefined ? 'GET' : 'POST',
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    function pollWorkBadge() {
      setInterval(async () => {
        if (document.hidden) return;
        try {
          const summary = await api(`/api/packer/work-summary?warehouseId=${warehouseId}`);
          document.getElementById('badge-pick')?.classList.toggle('show', summary.pickable > 0);
          document.getElementById('badge-pack')?.classList.toggle('show', summary.packable > 0);
        } catch {
          // Badge is a convenience, not load-bearing — ignore transient failures.
        }
      }, 10000);
    }

    async function boot() {
      const user = (window as any).__serverUser;
      if (user.role !== 'packer') {
        app.innerHTML = `<p>This account is a "${user.role}" — the packer dashboard needs a packer login.</p>`;
        return;
      }
      warehouseId = user.warehouseId;
      pollWorkBadge();

      const initial = (window as any).__initialData;
      if (initial) {
        render(initial.myBatches ?? [], initial.demand ?? [], initial.unbatched ?? null, initial.today ?? null);
      } else {
        await load();
      }
      setInterval(() => {
        if (!document.hidden) load();
      }, 15000);
    }

    async function load() {
      try {
        const [data, demand] = await Promise.all([
          api(`/api/packer/dashboard?warehouseId=${warehouseId}`),
          api(`/api/picker/sku-demand?warehouseId=${warehouseId}`)
        ]);
        render(data.myBatches ?? [], demand ?? [], data.unbatched ?? null, data.today ?? null);
      } catch (err) {
        app.innerHTML = `<div class="banner banner-danger">${(err as Error).message}</div>`;
      }
    }

    function formatTime(iso: string): string {
      return new Date(iso).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
    }

    function render(myBatches: MyBatch[], demand: SkuDemandRow[], unbatched: UnbatchedSummary | null, today: DailySummary | null) {
      app.innerHTML = `
        <div class="stat-grid">
          <div class="stat-card stat-card-accent-success">
            <span class="stat-card-value">${today?.orderCount ?? 0}</span>
            <span class="stat-card-label">Orders packed today</span>
          </div>
          <div class="stat-card stat-card-accent-neutral">
            <span class="stat-card-value">${today?.unitsPacked ?? 0}</span>
            <span class="stat-card-label">Units packed today</span>
          </div>
        </div>

        <div class="stack" style="gap: 10px; margin-top: 8px;">
          <span class="eyebrow">Assigned to you</span>
          ${
            myBatches.length
              ? (() => {
                  const totalOrders = myBatches.reduce((sum, b) => sum + b.orderCount, 0);
                  const remaining = myBatches.reduce((sum, b) => sum + b.remaining, 0);
                  return `
                <div class="card">
                  <div class="row" style="justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                    <div class="stack" style="gap: 2px;">
                      <span style="font-weight: 600;">${totalOrders} order${totalOrders > 1 ? 's' : ''} in progress</span>
                      <span style="font-size: 0.8rem; color: var(--muted);">${remaining > 0 ? `${remaining} line${remaining > 1 ? 's' : ''} still to pick` : 'Picking complete — ready to pack'}</span>
                    </div>
                    <a class="btn btn-primary" style="width: auto; text-decoration: none;" href="${remaining > 0 ? '/picker' : '/packer'}">${remaining > 0 ? 'Go to picking' : 'Go to packing'}</a>
                  </div>
                </div>`;
                })()
              : `<p>Nothing assigned to you right now — head to <a href="/picker">Pick</a> and one will be swept up automatically.</p>`
          }
        </div>

        <div class="stack" style="gap: 10px; margin-top: 8px;">
          <div class="row" style="justify-content: space-between; align-items: center;">
            <span class="eyebrow">Upcoming — pulled, not yet assigned</span>
            <button class="btn btn-ghost" id="sync-now-btn" style="width: auto; min-height: 32px; padding: 0 10px; font-size: 0.78rem;">Sync now</button>
          </div>
          <div id="sync-result"></div>
          ${
            // Not always a real stock shortage — this order just hasn't been
            // retried yet. The sync job now retries automatically every
            // ~5 minutes (sync-job.ts), so this should self-clear on its own
            // shortly; it only needs stock if it's still here after a while.
            unbatched && unbatched.orderCount > 0
              ? `<div class="banner banner-danger">${unbatched.orderCount} order${unbatched.orderCount > 1 ? 's' : ''} waiting to be assigned (${unbatched.unitCount} unit${unbatched.unitCount > 1 ? 's' : ''} needed) — rechecks automatically every few minutes. Still here a while? <a href="/admin/inbound">Receive stock</a> if it's genuinely short.</div>`
              : ''
          }
          ${
            demand.length
              ? `<div class="stack" style="gap: 8px;">
                  ${demand
                    .map(
                      (d) => `
                    <div class="item-row">
                      ${d.imageUrl ? `<img class="thumb" src="${d.imageUrl}" alt="" />` : '<div class="thumb"></div>'}
                      <div class="stack" style="gap: 2px; flex: 1; min-width: 0;">
                        <span style="font-weight: 700;">${escapeHtml(d.skuCode)}</span>
                        <span style="font-size: 0.78rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${escapeHtml(d.skuName)}</span>
                      </div>
                      <span class="status-pill status-neutral">${d.unitsNeeded} unit${d.unitsNeeded > 1 ? 's' : ''} · ${d.orderCount} order${d.orderCount > 1 ? 's' : ''}</span>
                    </div>`
                    )
                    .join('')}
                </div>`
              : !unbatched || unbatched.orderCount === 0
                ? `<p>Nothing waiting — every pulled order is already assigned.</p>`
                : ''
          }
        </div>

        <div class="stack" style="gap: 10px; margin-top: 8px;">
          <span class="eyebrow">Today — what you've packed</span>
          ${
            today && today.orders.length
              ? `<div class="table-scroll"><table>
                  <thead><tr><th></th><th>Order ID</th><th>Time</th><th>Units</th><th>Outcome</th></tr></thead>
                  <tbody>
                    ${today.orders
                      .map(
                        (o) => `<tr>
                          <td>${o.imageUrl ? `<img class="table-thumb" src="${o.imageUrl}" alt="" />` : ''}</td>
                          <td style="font-weight:700; font-variant-numeric: tabular-nums;">${escapeHtml(o.externalOrderId)}</td>
                          <td>${formatTime(o.completedAt)}</td>
                          <td>${o.unitsPacked}</td>
                          <td><span class="status-pill ${o.outcome === 'completed' ? 'status-success' : 'status-warning'}">${o.outcome}</span></td>
                        </tr>`
                      )
                      .join('')}
                  </tbody>
                </table></div>`
              : `<p>Nothing packed yet today.</p>`
          }
        </div>`;

      // The stock-arriving retry already runs automatically on receiving
      // (retryBlockedOrdersForSku) and the full pull+status+retry cycle runs
      // on a cron every ~5min, but only during warehouse hours (8:30am-2:30pm
      // IST — see wrangler.jsonc) to stay under the account's cron trigger
      // limit. Outside that window (or if something on Amazon's side just
      // needs checking right now) this is the manual escape hatch, so a
      // packer doesn't have to go find an admin or wait for the next tick.
      document.getElementById('sync-now-btn')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        try {
          const { results } = await withLoading(btn, 'Syncing…', () => api('/api/picker/sync-now', {}));
          const totals = (results as Array<{ imported: number; statusShipped: number; statusCancelled: number; retrySucceeded: number }>).reduce(
            (acc, r) => ({
              imported: acc.imported + r.imported,
              statusShipped: acc.statusShipped + r.statusShipped,
              statusCancelled: acc.statusCancelled + r.statusCancelled,
              retrySucceeded: acc.retrySucceeded + r.retrySucceeded
            }),
            { imported: 0, statusShipped: 0, statusCancelled: 0, retrySucceeded: 0 }
          );
          // load() rebuilds #app (and with it #sync-result) via render(), so
          // the message has to be set on the *new* element afterward — set
          // before the await, it would just get wiped out by that rebuild.
          await load();
          const resultEl = document.getElementById('sync-result');
          if (resultEl) {
            resultEl.innerHTML = `<div class="banner banner-success" style="margin-top: 6px; padding: 6px 10px; font-size: 0.78rem;">Synced — ${totals.imported} new, ${totals.statusShipped} shipped, ${totals.statusCancelled} cancelled, ${totals.retrySucceeded} unblocked.</div>`;
          }
        } catch (err) {
          const resultEl = document.getElementById('sync-result');
          if (resultEl) resultEl.innerHTML = `<div class="banner banner-danger" style="margin-top: 6px; padding: 6px 10px; font-size: 0.78rem;">${(err as Error).message}</div>`;
        }
      });
    }

    boot();
  </script>
</Base>
