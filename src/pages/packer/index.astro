---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
---

<Base title="Packer">
  <div class="screen">
    <TopBar section="Packing" homeHref="/packer/home">
      <a href="/picker" class="pill tab-pill" style="text-decoration: none;">Pick<span class="badge-dot" id="badge-pick"></span></a>
      <a href="/packer" class="pill tab-pill active" style="text-decoration: none;">Pack<span class="badge-dot" id="badge-pack"></span></a>
      <span class="pill" id="user-pill">…</span>
    </TopBar>
    <div id="app" class="stack" style="flex: 1;">
      <p>Loading…</p>
    </div>
  </div>

  <script>
    import { scanOnce, stopScanning } from '../../lib/scanner-client';
    import { withLoading, escapeHtml } from '../../lib/ui';

    interface PackBatchItem {
      order_item_id: string;
      order_id: string;
      external_order_id: string;
      order_notes: string | null;
      sku_code: string;
      sku_name: string;
      image_url: string | null;
      quantity_required: number;
      quantity_packed: number;
    }
    interface PackBatchOrder {
      orderId: string;
      externalOrderId: string;
      packSessionId: string;
      allPacked: boolean;
      notes: string | null;
    }
    interface PackBatchState {
      pickBatchId: string;
      items: PackBatchItem[];
      orders: PackBatchOrder[];
      allPacked: boolean;
    }
    interface SkuGroup {
      sku_code: string;
      sku_name: string;
      image_url: string | null;
      rows: PackBatchItem[];
    }

    // Each batch is its own self-contained unit that moves through
    // pack -> label -> done in place, on the same continuous page — matches
    // the real floor workflow (pack this batch's boxes, label this batch's
    // boxes, then move to the next) more closely than a single shared
    // label queue across every batch would. See HANDOFF.md.
    type BatchPhase = 'packing' | 'labeling' | 'done';
    interface BatchEntry {
      pack: PackBatchState;
      phase: BatchPhase;
      labelQueue: PackBatchOrder[];
    }

    const app = document.getElementById('app')!;
    const userPill = document.getElementById('user-pill')!;
    let warehouseId = '';
    let currentStationToken = '';
    let batchList: BatchEntry[] = [];
    let lastError = '';
    let pollTimer: ReturnType<typeof setInterval> | null = null;

    function stopPolling() {
      if (pollTimer !== null) {
        clearInterval(pollTimer);
        pollTimer = null;
      }
    }

    async function api(path: string, body?: unknown) {
      const res = await fetch(path, {
        method: body === undefined ? 'GET' : 'POST',
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    // Badge on the "Pick" tab so a packer knows work is waiting there without
    // switching over to check.
    function pollWorkBadge() {
      setInterval(async () => {
        if (document.hidden) return;
        try {
          const summary = await api(`/api/packer/work-summary?warehouseId=${warehouseId}`);
          document.getElementById('badge-pick')?.classList.toggle('show', summary.pickable > 0);
        } catch {
          // Badge is a convenience, not load-bearing — ignore transient failures.
        }
      }, 10000);
    }

    async function boot() {
      const me = await api('/api/auth/me');
      if (!me.user) {
        window.location.href = '/login';
        return;
      }
      if (me.user.role !== 'packer') {
        app.innerHTML = `<p>This account is a "${me.user.role}", not a packer.</p>`;
        return;
      }
      userPill.textContent = me.user.name;
      warehouseId = me.user.warehouseId;
      pollWorkBadge();
      renderStationPrompt();
    }

    async function renderStationPrompt() {
      stopPolling();
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center; text-align:center;">
          <span class="eyebrow">Packing station</span>
          <div class="big-label">Tap in</div>
          ${errorBanner()}
          <video class="scanner" id="video" style="display:none;"></video>
          <button class="btn btn-primary" id="scan-station">Scan station label</button>
          <div class="stack" id="station-list"></div>
          <button class="btn btn-ghost" id="manual-station">Enter station code</button>
        </div>`;
      document.getElementById('scan-station')?.addEventListener('click', async () => {
        const video = document.getElementById('video') as HTMLVideoElement;
        video.style.display = 'block';
        try {
          const text = await scanOnce(video);
          await startSession(text);
        } catch {
          showError('Could not open camera — use manual entry.');
          renderStationPrompt();
        }
      });
      document.getElementById('manual-station')?.addEventListener('click', () => {
        renderManualEntry('Station code', (code) => startSession(code), renderStationPrompt);
      });

      // Real fallback, not just a test shortcut — pick from the warehouse's own short list of stations instead of typing a code.
      try {
        const stations: Array<{ id: string; code: string; qr_token: string }> = await api(`/api/packer/stations?warehouseId=${warehouseId}`);
        const list = document.getElementById('station-list');
        if (list && stations.length) {
          list.innerHTML = stations.map((s) => `<button class="btn" data-token="${s.qr_token}">${s.code}</button>`).join('');
          list.querySelectorAll('button').forEach((btn) => {
            const button = btn as HTMLButtonElement;
            button.addEventListener('click', () => startSession(button.dataset.token!, button));
          });
        }
      } catch {
        // Station list is a convenience, not a requirement — scan/manual entry still work if this fails.
      }
    }

    function toEntry(pack: PackBatchState): BatchEntry {
      return { pack, phase: 'packing', labelQueue: [] };
    }

    async function startSession(stationQrToken: string, btn?: HTMLButtonElement) {
      stopScanning();
      currentStationToken = stationQrToken;
      try {
        const result = btn
          ? await withLoading(btn, 'Connecting…', () => api('/api/packer/start-session', { warehouseId, stationQrToken }))
          : await api('/api/packer/start-session', { warehouseId, stationQrToken });
        const batches: PackBatchState[] = result?.batches ?? [];
        stopPolling();
        batchList = batches.map(toEntry);
        render();
        // Always polling from here on, not just while empty — a station stays
        // tapped in and new batches keep getting picked; freshly ready ones
        // just append rather than needing a "get next batch" click. See
        // HANDOFF.md.
        pollTimer = setInterval(pollForMore, 8000);
      } catch (err) {
        showError((err as Error).message);
        renderStationPrompt();
      }
    }

    async function pollForMore() {
      if (document.hidden) return;
      try {
        const result = await api('/api/packer/start-session', { warehouseId, stationQrToken: currentStationToken });
        const incoming: PackBatchState[] = result?.batches ?? [];
        const newOnes = incoming.filter((b) => !batchList.some((e) => e.pack.pickBatchId === b.pickBatchId));
        if (newOnes.length) {
          batchList.push(...newOnes.map(toEntry));
          render();
        }
      } catch {
        // Transient — ignore, the next tick retries.
      }
    }

    function render() {
      if (!batchList.length) {
        app.innerHTML = `
          <div class="stack" style="flex:1; justify-content:center; text-align:center;">
            <p>No orders waiting to pack — this checks automatically, or tap to check now.</p>
            <button class="btn" id="retry">Check again</button>
            <button class="btn btn-ghost" id="change-station">Switch station</button>
          </div>`;
        document.getElementById('retry')?.addEventListener('click', (e) => startSession(currentStationToken, e.currentTarget as HTMLButtonElement));
        document.getElementById('change-station')?.addEventListener('click', () => {
          stopPolling();
          renderStationPrompt();
        });
        return;
      }

      const totalOrders = new Set(batchList.flatMap((e) => e.pack.orders.map((o) => o.orderId))).size;
      const totalSkuLines = new Set(batchList.flatMap((e) => e.pack.items.map((i) => `${e.pack.pickBatchId}__${i.sku_code}`))).size;
      const remaining = batchList.filter((e) => e.phase !== 'done').length;

      app.innerHTML = `
        ${errorBanner()}
        <div class="stack" id="summary" style="flex-direction: row; gap: 16px; flex-wrap: wrap;">
          <span class="pill">${totalOrders} orders</span>
          <span class="pill">${totalSkuLines} SKU lines</span>
          ${batchList.length > 1 ? `<span class="pill">${batchList.length} batches</span>` : ''}
        </div>
        <div class="stack" id="batch-container" style="gap: 22px;"></div>`;

      const container = document.getElementById('batch-container')!;
      for (const entry of batchList) container.appendChild(renderBatchSection(entry));

      if (remaining === 0) {
        const banner = document.createElement('div');
        banner.className = 'banner banner-success';
        banner.textContent = 'All caught up — new batches will appear here automatically.';
        container.appendChild(banner);
      }
    }

    function renderBatchSection(entry: BatchEntry): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'stack';
      wrap.style.gap = '12px';

      const orderCount = entry.pack.orders.length;
      const header = document.createElement('div');
      header.className = 'row';
      header.style.justifyContent = 'space-between';
      header.style.alignItems = 'center';
      header.innerHTML = `<span class="eyebrow">Batch · ${orderCount} order${orderCount > 1 ? 's' : ''}</span>${
        entry.phase === 'done' ? '<span class="status-pill status-success">Done</span>' : entry.phase === 'labeling' ? '<span class="status-pill status-progress">Applying labels</span>' : ''
      }`;
      wrap.appendChild(header);

      if (entry.phase === 'done') {
        const banner = document.createElement('div');
        banner.className = 'banner banner-success';
        banner.textContent = 'All labels applied.';
        wrap.appendChild(banner);
        return wrap;
      }

      if (entry.phase === 'labeling') {
        wrap.appendChild(renderLabelCard(entry));
        return wrap;
      }

      wrap.appendChild(renderPackingCard(entry));
      return wrap;
    }

    // Bulk pack by SKU, not by order: every order in the batch needing the
    // same SKU collapses into one aggregate line, same pattern /picker uses
    // — pick the number up once (or edit it down if something's missing),
    // one "Mark done" tap. No barcode scan here — the warehouse's internal
    // SKU doesn't match Amazon's SellerSKU and products aren't individually
    // barcoded, same reason picking dropped scanning.
    function renderPackingCard(entry: BatchEntry): HTMLElement {
      const pack = entry.pack;
      const skuGroups: SkuGroup[] = [];
      for (const r of pack.items) {
        let sg = skuGroups.find((sg) => sg.sku_code === r.sku_code);
        if (!sg) {
          sg = { sku_code: r.sku_code, sku_name: r.sku_name, image_url: r.image_url, rows: [] };
          skuGroups.push(sg);
        }
        sg.rows.push(r);
      }
      // Matches the picked-and-arranged-on-the-table order (see HANDOFF.md
      // — boxes are physically laid out SKU-sorted, labels applied in that
      // same order), even though the server already returns items sorted
      // this way — defensive, cheap, and keeps the two in lockstep.
      skuGroups.sort((a, b) => a.sku_code.localeCompare(b.sku_code));

      const remainingCount = pack.items.filter((r) => r.quantity_packed < r.quantity_required).length;
      // An order can legitimately have nothing here at all — every one of
      // its items came back short/damaged during picking, so there's
      // nothing physically left to pack for it (it still needs a label).
      const nothingToPack = skuGroups.length === 0;

      const card = document.createElement('div');
      card.className = 'stack';
      card.style.gap = '10px';
      card.innerHTML = `
        <div class="row" style="gap: 16px; flex-wrap: wrap;">
          <span class="pill">${skuGroups.length} SKU lines</span>
          <span class="pill">${remainingCount} left</span>
        </div>
        ${nothingToPack ? '<p>Nothing to pack — every item on these orders came back short or damaged while picking. Apply their labels below.</p>' : ''}
        <div class="stack" id="groups-${pack.pickBatchId}"></div>
        ${pack.allPacked ? `<button class="btn btn-primary" data-action="finish-pack">Finish packing — apply labels</button>` : ''}`;

      const groupsEl = card.querySelector(`#groups-${pack.pickBatchId}`)!;
      for (const sg of skuGroups) groupsEl.appendChild(renderSkuGroup(entry, sg));
      card.querySelector('[data-action="finish-pack"]')?.addEventListener('click', () => finishPacking(entry));
      return card;
    }

    function renderSkuGroup(entry: BatchEntry, sg: SkuGroup): HTMLElement {
      const required = sg.rows.reduce((sum, r) => sum + r.quantity_required, 0);
      const packed = sg.rows.reduce((sum, r) => sum + r.quantity_packed, 0);
      const done = packed >= required;
      const remainingNeeded = required - packed;
      const orderCount = new Set(sg.rows.map((r) => r.external_order_id)).size;
      const orderBreakdown = sg.rows
        .map((r) => {
          const base = `${escapeHtml(r.external_order_id)} ×${r.quantity_required}`;
          return r.order_notes ? `${base} <strong style="color: var(--warning-fg);">— ${escapeHtml(r.order_notes)}</strong>` : base;
        })
        .join(' · ');

      const el = document.createElement('div');
      el.className = 'card';
      el.innerHTML = `
        <div class="row" style="align-items: center; gap: 12px;">
          ${sg.image_url ? `<img class="thumb" src="${sg.image_url}" alt="" />` : '<div class="thumb"></div>'}
          <div class="stack" style="gap: 2px; flex: 1; min-width: 0;">
            <span style="font-weight: 600;">${sg.sku_name}</span>
            <span style="font-size: 0.8rem; color: var(--muted);">${sg.sku_code} · ${orderCount} order${orderCount > 1 ? 's' : ''}</span>
          </div>
        </div>
        <div class="row" style="gap: 24px; margin-top: 10px;">
          <div class="stack" style="gap: 0;">
            <span style="font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted);">Required</span>
            <span class="qty" style="font-size: 1.15rem;">${required}</span>
          </div>
          <div class="stack" style="gap: 0;">
            <span style="font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted);">Packed</span>
            <span class="qty" style="font-size: 1.15rem;">${packed}</span>
          </div>
        </div>
        <div style="font-size: 0.72rem; color: var(--muted); margin-top: 6px;">${orderBreakdown}</div>
        ${
          done
            ? `<div class="banner banner-success" style="margin-top: 10px; padding: 8px 12px;">Packed</div>`
            : `<div class="row" style="margin-top: 10px; gap: 8px; align-items: center;">
                 <input type="number" class="qty-input" min="0" max="${remainingNeeded}" value="${remainingNeeded}" style="width: 90px; flex: 0 0 auto; min-height: 52px; text-align: center;" />
                 <button class="btn btn-primary" data-action="pack" style="flex: 1;">Mark done</button>
               </div>`
        }`;

      const orderItemIds = sg.rows.map((r) => r.order_item_id);
      el.querySelector('[data-action="pack"]')?.addEventListener('click', async () => {
        const input = el.querySelector('.qty-input') as HTMLInputElement;
        const qty = Number(input.value);
        await handleMarkPacked(entry, orderItemIds, qty);
      });
      return el;
    }

    // Mutates entry.pack.items and re-renders before the network call
    // resolves — the tap feels instant instead of waiting on a round trip.
    // Rolled back if the server disagrees.
    function applyOptimisticPack(items: PackBatchItem[], orderItemIds: string[], totalQuantity: number) {
      let remaining = totalQuantity;
      for (const id of orderItemIds) {
        const item = items.find((i) => i.order_item_id === id);
        if (!item) continue;
        const alloc = Math.min(remaining, item.quantity_required);
        remaining -= alloc;
        item.quantity_packed = alloc;
      }
    }

    async function handleMarkPacked(entry: BatchEntry, orderItemIds: string[], quantity: number) {
      const snapshot = entry.pack.items.map((i) => ({ ...i }));
      applyOptimisticPack(entry.pack.items, orderItemIds, quantity);
      lastError = '';
      render();
      try {
        entry.pack = await api('/api/packer/mark-item', { pickBatchId: entry.pack.pickBatchId, orderItemIds, quantity });
        render();
      } catch (err) {
        entry.pack.items = snapshot;
        lastError = (err as Error).message;
        render();
      }
    }

    async function finishPacking(entry: BatchEntry) {
      // Optimistic: entry.pack.orders is exactly what completePackingBatch
      // will hand back on success (it processes that set — the only way
      // this call fails is a real error, never a partial result), so move
      // straight to the label phase instead of waiting on the round trip.
      const previousPhase = entry.phase;
      entry.phase = 'labeling';
      entry.labelQueue = entry.pack.orders.slice();
      lastError = '';
      render();
      try {
        const { results } = await api('/api/packer/complete', { pickBatchId: entry.pack.pickBatchId });
        entry.labelQueue = (results as Array<{ orderId: string; packSessionId: string; outcome: string }>).map(
          (r) => entry.pack.orders.find((o) => o.orderId === r.orderId)!
        );
        if (entry.labelQueue.length === 0) entry.phase = 'done';
        render();
      } catch (err) {
        entry.phase = previousPhase;
        entry.labelQueue = [];
        lastError = (err as Error).message;
        render();
      }
    }

    function renderLabelCard(entry: BatchEntry): HTMLElement {
      const order = entry.labelQueue[0];
      const card = document.createElement('div');
      card.className = 'card stack';
      card.style.textAlign = 'center';
      card.innerHTML = `
        <span class="eyebrow">Apply label · ${entry.labelQueue.length} left</span>
        <div class="big-label">${escapeHtml(order.externalOrderId)}</div>
        ${order.notes ? `<div class="banner banner-warning">${escapeHtml(order.notes)}</div>` : ''}
        <p>Scan AWB</p>
        <video class="scanner" id="video-${entry.pack.pickBatchId}" style="display:none;"></video>
        <button class="btn btn-primary" data-action="scan-awb">Scan AWB barcode</button>
        <button class="btn btn-ghost" data-action="manual-awb">Enter AWB manually</button>`;

      card.querySelector('[data-action="scan-awb"]')?.addEventListener('click', async () => {
        const video = card.querySelector(`#video-${entry.pack.pickBatchId}`) as HTMLVideoElement;
        video.style.display = 'block';
        try {
          const text = await scanOnce(video);
          await handleAwb(entry, order, text);
        } catch {
          showError('Could not open camera — use manual entry.');
          render();
        }
      });
      card.querySelector('[data-action="manual-awb"]')?.addEventListener('click', () => {
        // No "correct" AWB to suggest (it's arbitrary carrier text) — offer a fresh unique one instead of making you invent a string each time.
        renderManualEntry(
          'AWB code',
          (code) => handleAwb(entry, order, code),
          () => render(),
          `TEST-AWB-${Math.random().toString(36).slice(2, 8).toUpperCase()}`
        );
      });
      return card;
    }

    async function handleAwb(entry: BatchEntry, order: PackBatchOrder, awbCode: string) {
      stopScanning();
      // Immediate feedback the moment a code is scanned/submitted — AWB
      // application is a hard-block safety check (duplicate/mismatch), so
      // the outcome itself can't be guessed optimistically, but the tap
      // shouldn't sit there looking inert while that check runs.
      lastError = '';
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center; text-align:center;">
          <span class="eyebrow">Apply label · ${entry.labelQueue.length} left</span>
          <div class="big-label">${escapeHtml(order.externalOrderId)}</div>
          <p>Checking ${escapeHtml(awbCode)}…</p>
        </div>`;
      try {
        await api('/api/packer/apply-awb', { packSessionId: order.packSessionId, awbCode });
        entry.labelQueue = entry.labelQueue.filter((o) => o.orderId !== order.orderId);
        if (entry.labelQueue.length === 0) entry.phase = 'done';
        render();
      } catch (err) {
        // Hard block — AWB mismatch/duplicate. Deliberately does not fall through to ready-to-ship.
        app.innerHTML = `
          <div class="stack" style="flex:1; justify-content:center; text-align:center;">
            <div class="banner banner-danger" style="font-size:1.2rem;">${escapeHtml((err as Error).message)}</div>
            <button class="btn" id="retry-awb">Try again</button>
          </div>`;
        document.getElementById('retry-awb')?.addEventListener('click', render);
      }
    }

    function errorBanner() {
      return lastError ? `<div class="banner banner-danger">${escapeHtml(lastError)}</div>` : '';
    }
    function showError(msg: string) {
      lastError = msg;
    }

    // window.prompt() is unreliable in PWA/standalone contexts on mobile —
    // this inline form is the real manual-entry fallback (§8). `suggested`,
    // when the app already knows the expected code, gives a one-tap fill
    // instead of retyping a long code.
    function renderManualEntry(label: string, onSubmit: (value: string) => void, onCancel: () => void, suggested?: string) {
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center;">
          <span class="eyebrow">${label}</span>
          ${suggested ? `<button class="btn btn-primary" id="manual-suggested">Use ${suggested}</button>` : ''}
          <input type="text" id="manual-input" autocomplete="off" autocapitalize="off" value="${suggested ?? ''}" />
          <button class="btn${suggested ? ' btn-ghost' : ' btn-primary'}" id="manual-submit">Submit</button>
          <button class="btn btn-ghost" id="manual-cancel">Cancel</button>
        </div>`;
      const input = document.getElementById('manual-input') as HTMLInputElement;
      input.focus();
      const submit = () => {
        if (input.value.trim()) onSubmit(input.value.trim());
      };
      document.getElementById('manual-suggested')?.addEventListener('click', () => onSubmit(suggested!));
      document.getElementById('manual-submit')?.addEventListener('click', submit);
      document.getElementById('manual-cancel')?.addEventListener('click', onCancel);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          submit();
        }
      });
    }

    boot();
  </script>
</Base>
