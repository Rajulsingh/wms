---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
---

<Base title="Packer">
  <div class="screen">
    <TopBar section="Packing" homeHref="/packer/home">
      <a href="/picker" class="pill tab-pill" style="text-decoration: none;">Pick<span class="badge-dot" id="badge-pick"></span></a>
      <a href="/packer" class="pill tab-pill active" style="text-decoration: none;">Pack<span class="badge-dot" id="badge-pack"></span></a>
      <span class="pill" id="user-pill">…</span>
    </TopBar>
    <div id="app" class="stack" style="flex: 1;">
      <p>Loading…</p>
    </div>
  </div>

  <script>
    import { scanOnce, stopScanning } from '../../lib/scanner-client';
    import { withLoading, escapeHtml } from '../../lib/ui';

    interface PackBatchItem {
      order_item_id: string;
      order_id: string;
      external_order_id: string;
      order_notes: string | null;
      sku_code: string;
      sku_name: string;
      image_url: string | null;
      quantity_required: number;
      quantity_packed: number;
    }
    interface PackBatchOrder {
      orderId: string;
      externalOrderId: string;
      packSessionId: string;
      allPacked: boolean;
      notes: string | null;
    }
    interface PackBatchState {
      pickBatchId: string;
      items: PackBatchItem[];
      orders: PackBatchOrder[];
      allPacked: boolean;
    }

    // Each entry is one order's own packing ticket (batching no longer
    // bundles several orders together — see HANDOFF.md). Labeling is NOT
    // per-entry any more: a packer marks orders packed one at a time as
    // they go, then a single page-level "Finish packing" action (see
    // finishAllReady below) completes every ready order at once and hands
    // off to one shared AWB-scanning queue — matches the real floor
    // workflow described by the user: pack several, then label the batch
    // of finished ones together, not one scan screen per order. See
    // HANDOFF.md.
    interface BatchEntry {
      pack: PackBatchState;
    }
    type SortMode = 'sku' | 'order';
    interface OrderRow {
      entry: BatchEntry;
      order: PackBatchOrder;
      items: PackBatchItem[];
    }

    const app = document.getElementById('app')!;
    const userPill = document.getElementById('user-pill')!;
    let warehouseId = '';
    let currentStationToken = '';
    let batchList: BatchEntry[] = [];
    let labelQueue: PackBatchOrder[] = [];
    let sortMode: SortMode = 'sku';
    let lastError = '';
    let pollTimer: ReturnType<typeof setInterval> | null = null;

    function stopPolling() {
      if (pollTimer !== null) {
        clearInterval(pollTimer);
        pollTimer = null;
      }
    }

    async function api(path: string, body?: unknown) {
      const res = await fetch(path, {
        method: body === undefined ? 'GET' : 'POST',
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    // Badge on the "Pick" tab so a packer knows work is waiting there without
    // switching over to check.
    function pollWorkBadge() {
      setInterval(async () => {
        if (document.hidden) return;
        try {
          const summary = await api(`/api/packer/work-summary?warehouseId=${warehouseId}`);
          document.getElementById('badge-pick')?.classList.toggle('show', summary.pickable > 0);
        } catch {
          // Badge is a convenience, not load-bearing — ignore transient failures.
        }
      }, 10000);
    }

    async function boot() {
      const me = await api('/api/auth/me');
      if (!me.user) {
        window.location.href = '/login';
        return;
      }
      if (me.user.role !== 'packer') {
        app.innerHTML = `<p>This account is a "${me.user.role}", not a packer.</p>`;
        return;
      }
      userPill.textContent = me.user.name;
      warehouseId = me.user.warehouseId;
      pollWorkBadge();
      renderStationPrompt();
    }

    async function renderStationPrompt() {
      stopPolling();
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center; text-align:center;">
          <span class="eyebrow">Packing station</span>
          <div class="big-label">Tap in</div>
          ${errorBanner()}
          <video class="scanner" id="video" style="display:none;"></video>
          <button class="btn btn-primary" id="scan-station">Scan station label</button>
          <div class="stack" id="station-list"></div>
          <button class="btn btn-ghost" id="manual-station">Enter station code</button>
        </div>`;
      document.getElementById('scan-station')?.addEventListener('click', async () => {
        const video = document.getElementById('video') as HTMLVideoElement;
        video.style.display = 'block';
        try {
          const text = await scanOnce(video);
          await startSession(text);
        } catch {
          showError('Could not open camera — use manual entry.');
          renderStationPrompt();
        }
      });
      document.getElementById('manual-station')?.addEventListener('click', () => {
        renderManualEntry('Station code', (code) => startSession(code), renderStationPrompt);
      });

      // Real fallback, not just a test shortcut — pick from the warehouse's own short list of stations instead of typing a code.
      try {
        const stations: Array<{ id: string; code: string; qr_token: string }> = await api(`/api/packer/stations?warehouseId=${warehouseId}`);
        const list = document.getElementById('station-list');
        if (list && stations.length) {
          list.innerHTML = stations.map((s) => `<button class="btn" data-token="${s.qr_token}">${s.code}</button>`).join('');
          list.querySelectorAll('button').forEach((btn) => {
            const button = btn as HTMLButtonElement;
            button.addEventListener('click', () => startSession(button.dataset.token!, button));
          });
        }
      } catch {
        // Station list is a convenience, not a requirement — scan/manual entry still work if this fails.
      }
    }

    function toEntry(pack: PackBatchState): BatchEntry {
      return { pack };
    }

    async function startSession(stationQrToken: string, btn?: HTMLButtonElement) {
      stopScanning();
      currentStationToken = stationQrToken;
      try {
        const result = btn
          ? await withLoading(btn, 'Connecting…', () => api('/api/packer/start-session', { warehouseId, stationQrToken }))
          : await api('/api/packer/start-session', { warehouseId, stationQrToken });
        const batches: PackBatchState[] = result?.batches ?? [];
        stopPolling();
        batchList = batches.map(toEntry);
        render();
        // Always polling from here on, not just while empty — a station stays
        // tapped in and new batches keep getting picked; freshly ready ones
        // just append rather than needing a "get next batch" click. See
        // HANDOFF.md.
        pollTimer = setInterval(pollForMore, 8000);
      } catch (err) {
        showError((err as Error).message);
        renderStationPrompt();
      }
    }

    async function pollForMore() {
      if (document.hidden) return;
      try {
        const result = await api('/api/packer/start-session', { warehouseId, stationQrToken: currentStationToken });
        const incoming: PackBatchState[] = result?.batches ?? [];
        const newOnes = incoming.filter((b) => !batchList.some((e) => e.pack.pickBatchId === b.pickBatchId));
        if (newOnes.length) {
          batchList.push(...newOnes.map(toEntry));
          render();
        }
      } catch {
        // Transient — ignore, the next tick retries.
      }
    }

    // Every order across every currently-open entry, flattened into one
    // list — same principle as picking's flat SKU list, just the other
    // axis. Grouped by order, not SKU: picking is "bring N of this SKU,
    // whichever orders it's for" (a floor task); by the pack station the
    // units for one order are already together and the job is "box up this
    // order", so the packer needs one order's full line list (every SKU it
    // needs, with its quantity) to know at a glance whether it's a
    // multi-quantity order.
    function flattenOrders(): OrderRow[] {
      return batchList.flatMap((entry) =>
        entry.pack.orders.map((order) => ({ entry, order, items: entry.pack.items.filter((i) => i.order_id === order.orderId) }))
      );
    }

    // "Nothing to pack" orders (every item came back short/damaged during
    // picking) sort last in SKU mode — there's no SKU to sort them by.
    function primarySkuCode(items: PackBatchItem[]): string {
      if (!items.length) return '￿';
      return items.reduce((min, i) => (i.sku_code < min ? i.sku_code : min), items[0].sku_code);
    }

    function sortRows(rows: OrderRow[]): OrderRow[] {
      const sorted = rows.slice();
      if (sortMode === 'sku') {
        sorted.sort((a, b) => primarySkuCode(a.items).localeCompare(primarySkuCode(b.items)) || a.order.externalOrderId.localeCompare(b.order.externalOrderId));
      } else {
        sorted.sort((a, b) => a.order.externalOrderId.localeCompare(b.order.externalOrderId));
      }
      return sorted;
    }

    function getReadyEntries(): BatchEntry[] {
      return batchList.filter((e) => e.pack.allPacked);
    }

    function render() {
      if (labelQueue.length) {
        renderLabelScreen();
        return;
      }

      if (!batchList.length) {
        app.innerHTML = `
          <div class="stack" style="flex:1; justify-content:center; text-align:center;">
            <p>No orders waiting to pack — this checks automatically, or tap to check now.</p>
            <button class="btn" id="retry">Check again</button>
            <button class="btn btn-ghost" id="change-station">Switch station</button>
          </div>`;
        document.getElementById('retry')?.addEventListener('click', (e) => startSession(currentStationToken, e.currentTarget as HTMLButtonElement));
        document.getElementById('change-station')?.addEventListener('click', () => {
          stopPolling();
          renderStationPrompt();
        });
        return;
      }

      const rows = sortRows(flattenOrders());
      const totalSkuLines = new Set(rows.flatMap((r) => r.items.map((i) => i.sku_code))).size;
      const readyEntries = getReadyEntries();
      const readyOrderCount = readyEntries.reduce((sum, e) => sum + e.pack.orders.length, 0);

      app.innerHTML = `
        ${errorBanner()}
        <div class="row" style="justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
          <div class="row" id="summary" style="width: auto; gap: 16px; flex-wrap: wrap;">
            <span class="pill">${rows.length} orders</span>
            <span class="pill">${totalSkuLines} SKU lines</span>
          </div>
          <select id="sort-select" style="width: auto;">
            <option value="sku">Sort by SKU</option>
            <option value="order">Sort by order ID</option>
          </select>
        </div>
        ${readyOrderCount > 0 ? `<button class="btn btn-primary" id="finish-all">Finish packing — apply labels (${readyOrderCount})</button>` : ''}
        <div class="stack" id="order-container" style="gap: 14px; margin-top: 6px;"></div>`;

      const select = document.getElementById('sort-select') as unknown as HTMLSelectElement;
      select.value = sortMode;
      select.addEventListener('change', () => {
        sortMode = select.value as SortMode;
        render();
      });
      document.getElementById('finish-all')?.addEventListener('click', finishAllReady);

      const container = document.getElementById('order-container')!;
      for (const row of rows) container.appendChild(renderOrderCard(row));
    }

    function renderOrderCard(row: OrderRow): HTMLElement {
      const { entry, order, items } = row;
      const totalRequired = items.reduce((sum, i) => sum + i.quantity_required, 0);
      const totalPacked = items.reduce((sum, i) => sum + i.quantity_packed, 0);
      // An order can legitimately have zero lines here — every one of its
      // items came back short/damaged during picking, so there's nothing
      // physically left to pack for it (it still needs a label).
      const nothingToPack = items.length === 0;
      // Flagged so a packer double-checks before boxing it up as if it were
      // a routine single-item order — easy to under-pack by habit otherwise.
      const isMultiItem = items.length > 1;
      const isMultiQty = items.some((i) => i.quantity_required > 1);

      const el = document.createElement('div');
      el.className = 'card';
      el.innerHTML = `
        <div class="row" style="justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap;">
          <div class="row" style="width: auto; gap: 6px; align-items: center;">
            <span style="font-weight: 700; font-variant-numeric: tabular-nums;">${escapeHtml(order.externalOrderId)}</span>
            ${isMultiItem ? '<span class="status-pill status-warning">Multi-item</span>' : ''}
            ${isMultiQty ? '<span class="status-pill status-warning">Multi-qty</span>' : ''}
          </div>
          ${order.allPacked ? '<span class="status-pill status-success">Packed</span>' : `<span class="status-pill status-neutral">${totalPacked}/${totalRequired}</span>`}
        </div>
        ${order.notes ? `<div class="banner banner-warning" style="margin-top: 6px; padding: 8px 12px;">${escapeHtml(order.notes)}</div>` : ''}
        ${nothingToPack ? '<p style="font-size: 0.8rem; margin: 8px 0 0;">Nothing to pack — every item on this order came back short or damaged while picking. It still needs a label.</p>' : ''}
        <div class="stack" id="lines-${order.packSessionId}" style="gap: 10px; margin-top: 10px;"></div>
        ${!order.allPacked && !nothingToPack ? `<button class="btn btn-primary" data-action="pack-order" style="margin-top: 10px;">Mark order packed</button>` : ''}`;

      const linesEl = el.querySelector(`#lines-${order.packSessionId}`)!;
      for (const item of items) linesEl.appendChild(renderOrderLine(item, order.allPacked));

      el.querySelector('[data-action="pack-order"]')?.addEventListener('click', async () => {
        const lines = items.map((item) => {
          const input = el.querySelector(`.qty-input[data-item="${item.order_item_id}"]`) as HTMLInputElement;
          return { orderItemId: item.order_item_id, quantity: Number(input.value) };
        });
        await handleMarkPacked(entry, order.orderId, lines);
      });
      return el;
    }

    // A multi-quantity line is visible right on the row (e.g. "×3") instead
    // of being buried in an aggregate SKU total — that's the whole point of
    // grouping by order. The quantity stays editable (defaulting to the full
    // required amount) so a packer can still lower it if something turns up
    // missing/broken at the table, same flexibility picking's short-pick
    // flow has, just scoped to one line instead of a cross-order pool.
    function renderOrderLine(item: PackBatchItem, orderDone: boolean): HTMLElement {
      const el = document.createElement('div');
      el.className = 'row';
      el.style.alignItems = 'center';
      el.style.gap = '12px';
      el.innerHTML = `
        ${item.image_url ? `<img class="thumb" src="${item.image_url}" alt="" />` : '<div class="thumb"></div>'}
        <div class="stack" style="gap: 2px; flex: 1; min-width: 0;">
          <span style="font-weight: 600;">${item.sku_name} <span style="color: var(--muted); font-weight: 400;">×${item.quantity_required}</span></span>
          <span style="font-size: 0.8rem; color: var(--muted);">${item.sku_code}</span>
        </div>
        ${
          orderDone
            ? `<span class="status-pill status-success">${item.quantity_packed}</span>`
            : `<input type="number" class="qty-input" data-item="${item.order_item_id}" min="0" max="${item.quantity_required}" value="${item.quantity_required}" style="width: 70px; flex: 0 0 auto; min-height: 44px; text-align: center;" />`
        }`;
      return el;
    }

    // Mutates entry.pack.items and re-renders before the network call
    // resolves — the tap feels instant instead of waiting on a round trip.
    // Rolled back if the server disagrees.
    function applyOptimisticPackOrder(items: PackBatchItem[], lines: Array<{ orderItemId: string; quantity: number }>) {
      for (const line of lines) {
        const item = items.find((i) => i.order_item_id === line.orderItemId);
        if (item) item.quantity_packed = line.quantity;
      }
    }

    async function handleMarkPacked(entry: BatchEntry, orderId: string, lines: Array<{ orderItemId: string; quantity: number }>) {
      const snapshot = entry.pack.items.map((i) => ({ ...i }));
      applyOptimisticPackOrder(entry.pack.items, lines);
      lastError = '';
      render();
      try {
        entry.pack = await api('/api/packer/mark-item', { pickBatchId: entry.pack.pickBatchId, orderId, lines });
        render();
      } catch (err) {
        entry.pack.items = snapshot;
        lastError = (err as Error).message;
        render();
      }
    }

    // The single, page-level "Finish packing" action: completes every
    // order that's currently packed-and-ready (across every entry, not just
    // one), removes those entries from the working list, and hands off to
    // one shared label-scanning queue — so a packer packs several orders
    // one at a time, then labels the finished batch of them together in one
    // continuous scan-and-go screen, instead of a separate scan screen
    // popping up after every single order. See HANDOFF.md.
    async function finishAllReady() {
      const readyEntries = getReadyEntries();
      if (!readyEntries.length) return;

      lastError = '';
      const queue: PackBatchOrder[] = [];
      const completed: BatchEntry[] = [];
      for (const entry of readyEntries) {
        try {
          const { results } = await api('/api/packer/complete', { pickBatchId: entry.pack.pickBatchId });
          for (const r of results as Array<{ orderId: string }>) {
            const order = entry.pack.orders.find((o) => o.orderId === r.orderId);
            if (order) queue.push(order);
          }
          completed.push(entry);
        } catch (err) {
          lastError = (err as Error).message;
        }
      }
      batchList = batchList.filter((e) => !completed.includes(e));
      labelQueue.push(...queue);
      render();
    }

    function renderLabelScreen() {
      const order = labelQueue[0];
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center; text-align:center;">
          <span class="eyebrow">Apply label · ${labelQueue.length} left</span>
          <div class="big-label">${escapeHtml(order.externalOrderId)}</div>
          ${order.notes ? `<div class="banner banner-warning">${escapeHtml(order.notes)}</div>` : ''}
          <p>Scan AWB</p>
          <video class="scanner" id="video" style="display:none;"></video>
          <button class="btn btn-primary" id="scan-awb">Scan AWB barcode</button>
          <button class="btn btn-ghost" id="manual-awb">Enter AWB manually</button>
        </div>`;

      document.getElementById('scan-awb')?.addEventListener('click', async () => {
        const video = document.getElementById('video') as HTMLVideoElement;
        video.style.display = 'block';
        try {
          const text = await scanOnce(video);
          await handleAwb(order, text);
        } catch {
          showError('Could not open camera — use manual entry.');
          render();
        }
      });
      document.getElementById('manual-awb')?.addEventListener('click', () => {
        // No "correct" AWB to suggest (it's arbitrary carrier text) — offer a fresh unique one instead of making you invent a string each time.
        renderManualEntry(
          'AWB code',
          (code) => handleAwb(order, code),
          () => render(),
          `TEST-AWB-${Math.random().toString(36).slice(2, 8).toUpperCase()}`
        );
      });
    }

    async function handleAwb(order: PackBatchOrder, awbCode: string) {
      stopScanning();
      // Immediate feedback the moment a code is scanned/submitted — AWB
      // application is a hard-block safety check (duplicate/mismatch), so
      // the outcome itself can't be guessed optimistically, but the tap
      // shouldn't sit there looking inert while that check runs.
      lastError = '';
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center; text-align:center;">
          <span class="eyebrow">Apply label · ${labelQueue.length} left</span>
          <div class="big-label">${escapeHtml(order.externalOrderId)}</div>
          <p>Checking ${escapeHtml(awbCode)}…</p>
        </div>`;
      try {
        await api('/api/packer/apply-awb', { packSessionId: order.packSessionId, awbCode });
        labelQueue = labelQueue.filter((o) => o.orderId !== order.orderId);
        render();
      } catch (err) {
        // Hard block — AWB mismatch/duplicate. Deliberately does not fall through to ready-to-ship.
        app.innerHTML = `
          <div class="stack" style="flex:1; justify-content:center; text-align:center;">
            <div class="banner banner-danger" style="font-size:1.2rem;">${escapeHtml((err as Error).message)}</div>
            <button class="btn" id="retry-awb">Try again</button>
          </div>`;
        document.getElementById('retry-awb')?.addEventListener('click', render);
      }
    }

    function errorBanner() {
      return lastError ? `<div class="banner banner-danger">${escapeHtml(lastError)}</div>` : '';
    }
    function showError(msg: string) {
      lastError = msg;
    }

    // window.prompt() is unreliable in PWA/standalone contexts on mobile —
    // this inline form is the real manual-entry fallback (§8). `suggested`,
    // when the app already knows the expected code, gives a one-tap fill
    // instead of retyping a long code.
    function renderManualEntry(label: string, onSubmit: (value: string) => void, onCancel: () => void, suggested?: string) {
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center;">
          <span class="eyebrow">${label}</span>
          ${suggested ? `<button class="btn btn-primary" id="manual-suggested">Use ${suggested}</button>` : ''}
          <input type="text" id="manual-input" autocomplete="off" autocapitalize="off" value="${suggested ?? ''}" />
          <button class="btn${suggested ? ' btn-ghost' : ' btn-primary'}" id="manual-submit">Submit</button>
          <button class="btn btn-ghost" id="manual-cancel">Cancel</button>
        </div>`;
      const input = document.getElementById('manual-input') as HTMLInputElement;
      input.focus();
      const submit = () => {
        if (input.value.trim()) onSubmit(input.value.trim());
      };
      document.getElementById('manual-suggested')?.addEventListener('click', () => onSubmit(suggested!));
      document.getElementById('manual-submit')?.addEventListener('click', submit);
      document.getElementById('manual-cancel')?.addEventListener('click', onCancel);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          submit();
        }
      });
    }

    boot();
  </script>
</Base>
