---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
---

<Base title="Packer">
  <div class="screen">
    <TopBar section="Packing">
      <a href="/picker" class="pill tab-pill" style="text-decoration: none;">Pick<span class="badge-dot" id="badge-pick"></span></a>
      <a href="/packer" class="pill tab-pill active" style="text-decoration: none;">Pack<span class="badge-dot" id="badge-pack"></span></a>
      <span class="pill" id="user-pill">…</span>
    </TopBar>
    <div id="app" class="stack" style="flex: 1; justify-content: center;">
      <p>Loading…</p>
    </div>
  </div>

  <script>
    import { scanOnce, stopScanning } from '../../lib/scanner-client';

    interface PackBatchItem {
      order_item_id: string;
      order_id: string;
      external_order_id: string;
      sku_code: string;
      sku_name: string;
      image_url: string | null;
      quantity_required: number;
      quantity_packed: number;
    }
    interface PackBatchOrder {
      orderId: string;
      externalOrderId: string;
      packSessionId: string;
      allPacked: boolean;
    }
    interface PackBatchState {
      pickBatchId: string;
      items: PackBatchItem[];
      orders: PackBatchOrder[];
      allPacked: boolean;
    }
    interface SkuGroup {
      sku_code: string;
      sku_name: string;
      image_url: string | null;
      rows: PackBatchItem[];
    }

    const app = document.getElementById('app')!;
    const userPill = document.getElementById('user-pill')!;
    let warehouseId = '';
    let currentStationToken = '';
    let state: PackBatchState | null = null;
    let awbQueue: PackBatchOrder[] = [];
    let lastError = '';
    let pollTimer: ReturnType<typeof setInterval> | null = null;

    // Orders keep arriving and get picked continuously — a packer already
    // tapped into a station with nothing waiting should see the next picked
    // batch show up on its own, not have to keep tapping "check again".
    function stopPolling() {
      if (pollTimer !== null) {
        clearInterval(pollTimer);
        pollTimer = null;
      }
    }

    async function api(path: string, body?: unknown) {
      const res = await fetch(path, {
        method: body === undefined ? 'GET' : 'POST',
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    // Badge on the "Pick" tab so a packer knows work is waiting there without
    // switching over to check.
    function pollWorkBadge() {
      setInterval(async () => {
        if (document.hidden) return;
        try {
          const summary = await api(`/api/packer/work-summary?warehouseId=${warehouseId}`);
          document.getElementById('badge-pick')?.classList.toggle('show', summary.pickable > 0);
        } catch {
          // Badge is a convenience, not load-bearing — ignore transient failures.
        }
      }, 10000);
    }

    async function boot() {
      const me = await api('/api/auth/me');
      if (!me.user) {
        window.location.href = '/login';
        return;
      }
      if (me.user.role !== 'packer') {
        app.innerHTML = `<p>This account is a "${me.user.role}", not a packer.</p>`;
        return;
      }
      userPill.textContent = me.user.name;
      warehouseId = me.user.warehouseId;
      pollWorkBadge();
      renderStationPrompt();
    }

    async function renderStationPrompt() {
      stopPolling();
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center; text-align:center;">
          <span class="eyebrow">Packing station</span>
          <div class="big-label">Tap in</div>
          ${errorBanner()}
          <video class="scanner" id="video" style="display:none;"></video>
          <button class="btn btn-primary" id="scan-station">Scan station label</button>
          <div class="stack" id="station-list"></div>
          <button class="btn btn-ghost" id="manual-station">Enter station code</button>
        </div>`;
      document.getElementById('scan-station')?.addEventListener('click', async () => {
        const video = document.getElementById('video') as HTMLVideoElement;
        video.style.display = 'block';
        try {
          const text = await scanOnce(video);
          await startSession(text);
        } catch {
          showError('Could not open camera — use manual entry.');
          renderStationPrompt();
        }
      });
      document.getElementById('manual-station')?.addEventListener('click', () => {
        renderManualEntry('Station code', (code) => startSession(code), renderStationPrompt);
      });

      // Real fallback, not just a test shortcut — pick from the warehouse's own short list of stations instead of typing a code.
      try {
        const stations: Array<{ id: string; code: string; qr_token: string }> = await api(`/api/packer/stations?warehouseId=${warehouseId}`);
        const list = document.getElementById('station-list');
        if (list && stations.length) {
          list.innerHTML = stations.map((s) => `<button class="btn" data-token="${s.qr_token}">${s.code}</button>`).join('');
          list.querySelectorAll('button').forEach((btn) => {
            btn.addEventListener('click', () => startSession((btn as HTMLButtonElement).dataset.token!));
          });
        }
      } catch {
        // Station list is a convenience, not a requirement — scan/manual entry still work if this fails.
      }
    }

    async function startSession(stationQrToken: string) {
      stopScanning();
      currentStationToken = stationQrToken;
      try {
        const result = await api('/api/packer/start-session', { warehouseId, stationQrToken });
        if (!result || !result.pickBatchId) {
          app.innerHTML = `
            <div class="stack" style="flex:1; justify-content:center; text-align:center;">
              <p>No orders waiting to pack — this checks automatically, or tap to check now.</p>
              <button class="btn" id="retry">Check again</button>
              <button class="btn btn-ghost" id="change-station">Switch station</button>
            </div>`;
          document.getElementById('retry')?.addEventListener('click', () => startSession(stationQrToken));
          document.getElementById('change-station')?.addEventListener('click', () => {
            stopPolling();
            renderStationPrompt();
          });
          stopPolling();
          pollTimer = setInterval(() => {
            if (document.hidden) return;
            startSession(stationQrToken);
          }, 8000);
          return;
        }
        stopPolling();
        state = result;
        renderPackBatch();
      } catch (err) {
        showError((err as Error).message);
        renderStationPrompt();
      }
    }

    // Bulk pack by SKU, not by order: every order in the batch needing the
    // same SKU collapses into one aggregate line, same pattern /picker uses
    // — pick the number up once (or edit it down if something's missing),
    // one "Mark done" tap. No barcode scan here — the warehouse's internal
    // SKU doesn't match Amazon's SellerSKU and products aren't individually
    // barcoded, same reason picking dropped scanning. Labels are applied in
    // a separate pass once every order in the batch is fully packed, not
    // one at a time as each order finishes — see HANDOFF.md.
    function renderPackBatch() {
      if (!state) return;
      lastError = '';

      const skuGroups: SkuGroup[] = [];
      for (const r of state.items) {
        let sg = skuGroups.find((sg) => sg.sku_code === r.sku_code);
        if (!sg) {
          sg = { sku_code: r.sku_code, sku_name: r.sku_name, image_url: r.image_url, rows: [] };
          skuGroups.push(sg);
        }
        sg.rows.push(r);
      }

      const remainingCount = state.items.filter((r) => r.quantity_packed < r.quantity_required).length;
      // An order can legitimately have nothing here at all — every one of
      // its items came back short/damaged during picking, so there's
      // nothing physically left to pack for it (it still needs a label).
      const nothingToPack = skuGroups.length === 0;
      app.innerHTML = `
        ${errorBanner()}
        <div class="stack" id="summary" style="flex-direction: row; gap: 16px; flex-wrap: wrap;">
          <span class="pill">${state.orders.length} orders</span>
          <span class="pill">${skuGroups.length} SKU lines</span>
          <span class="pill">${remainingCount} left</span>
        </div>
        ${nothingToPack ? '<p>Nothing to pack — every item on these orders came back short or damaged while picking. Apply their labels below.</p>' : ''}
        <div class="stack" id="groups"></div>
        ${state.allPacked ? `<button class="btn btn-primary" id="finish-pack">Finish packing — apply labels</button>` : ''}`;

      const groupsEl = document.getElementById('groups')!;
      for (const sg of skuGroups) groupsEl.appendChild(renderSkuGroup(sg));
      document.getElementById('finish-pack')?.addEventListener('click', finishPacking);
    }

    function renderSkuGroup(sg: SkuGroup): HTMLElement {
      const required = sg.rows.reduce((sum, r) => sum + r.quantity_required, 0);
      const packed = sg.rows.reduce((sum, r) => sum + r.quantity_packed, 0);
      const done = packed >= required;
      const remainingNeeded = required - packed;
      const orderCount = new Set(sg.rows.map((r) => r.external_order_id)).size;
      const orderBreakdown = sg.rows.map((r) => `${r.external_order_id} ×${r.quantity_required}`).join(' · ');

      const el = document.createElement('div');
      el.className = 'card';
      el.innerHTML = `
        <div class="row" style="align-items: center; gap: 12px;">
          ${sg.image_url ? `<img class="thumb" src="${sg.image_url}" alt="" />` : '<div class="thumb"></div>'}
          <div class="stack" style="gap: 2px; flex: 1;">
            <span style="font-weight: 600;">${sg.sku_name}</span>
            <span style="font-size: 0.8rem; color: var(--muted);">${sg.sku_code} · ${orderCount} order${orderCount > 1 ? 's' : ''}</span>
          </div>
          <span class="qty">${packed}/${required}</span>
        </div>
        <div style="font-size: 0.72rem; color: var(--muted); margin-top: 6px;">${orderBreakdown}</div>
        ${
          done
            ? `<div class="banner banner-success" style="margin-top: 10px; padding: 8px 12px;">Packed</div>`
            : `<div class="row" style="margin-top: 10px; gap: 8px; align-items: center;">
                 <input type="number" class="qty-input" min="0" max="${remainingNeeded}" value="${remainingNeeded}" style="width: 90px; flex: 0 0 auto; min-height: 52px; text-align: center;" />
                 <button class="btn btn-primary" data-action="pack" style="flex: 1;">Mark done</button>
               </div>`
        }`;

      const orderItemIds = sg.rows.map((r) => r.order_item_id);
      el.querySelector('[data-action="pack"]')?.addEventListener('click', async () => {
        const input = el.querySelector('.qty-input') as HTMLInputElement;
        const qty = Number(input.value);
        await handleMarkPacked(orderItemIds, qty);
      });
      return el;
    }

    async function handleMarkPacked(orderItemIds: string[], quantity: number) {
      try {
        state = await api('/api/packer/mark-item', { pickBatchId: state!.pickBatchId, orderItemIds, quantity });
        renderPackBatch();
      } catch (err) {
        lastError = (err as Error).message;
        renderPackBatch();
      }
    }

    async function finishPacking() {
      try {
        const { results } = await api('/api/packer/complete', { pickBatchId: state!.pickBatchId });
        awbQueue = (results as Array<{ orderId: string; packSessionId: string; outcome: string }>).map((r) => {
          const order = state!.orders.find((o) => o.orderId === r.orderId)!;
          return order;
        });
        renderApplyLabelsQueue();
      } catch (err) {
        lastError = (err as Error).message;
        renderPackBatch();
      }
    }

    function renderApplyLabelsQueue() {
      if (!awbQueue.length) {
        app.innerHTML = `
          <div class="stack" style="flex:1; justify-content:center; text-align:center;">
            <div class="banner banner-success">Batch complete</div>
            <div class="big-label">All labels applied</div>
            <button class="btn btn-primary" id="next-batch">Get next batch</button>
          </div>`;
        document.getElementById('next-batch')?.addEventListener('click', () => startSession(currentStationToken));
        return;
      }
      renderAwbScreen(awbQueue[0]);
    }

    function renderAwbScreen(order: PackBatchOrder) {
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center; text-align:center;">
          <span class="eyebrow">Apply label · ${awbQueue.length} left</span>
          <div class="big-label">${order.externalOrderId}</div>
          <p>Scan AWB</p>
          ${errorBanner()}
          <video class="scanner" id="video" style="display:none;"></video>
          <button class="btn btn-primary" id="scan-awb">Scan AWB barcode</button>
          <button class="btn btn-ghost" id="manual-awb">Enter AWB manually</button>
        </div>`;
      document.getElementById('scan-awb')?.addEventListener('click', async () => {
        const video = document.getElementById('video') as HTMLVideoElement;
        video.style.display = 'block';
        try {
          const text = await scanOnce(video);
          await handleAwb(order, text);
        } catch {
          showError('Could not open camera — use manual entry.');
          renderAwbScreen(order);
        }
      });
      document.getElementById('manual-awb')?.addEventListener('click', () => {
        // No "correct" AWB to suggest (it's arbitrary carrier text) — offer a fresh unique one instead of making you invent a string each time.
        renderManualEntry('AWB code', (code) => handleAwb(order, code), () => renderAwbScreen(order), `TEST-AWB-${Math.random().toString(36).slice(2, 8).toUpperCase()}`);
      });
    }

    async function handleAwb(order: PackBatchOrder, awbCode: string) {
      stopScanning();
      try {
        await api('/api/packer/apply-awb', { packSessionId: order.packSessionId, awbCode });
        awbQueue = awbQueue.filter((o) => o.orderId !== order.orderId);
        lastError = '';
        renderApplyLabelsQueue();
      } catch (err) {
        // Hard block — AWB mismatch/duplicate. Deliberately does not fall through to ready-to-ship.
        app.innerHTML = `
          <div class="stack" style="flex:1; justify-content:center; text-align:center;">
            <div class="banner banner-danger" style="font-size:1.2rem;">${(err as Error).message}</div>
            <button class="btn" id="retry-awb">Try again</button>
          </div>`;
        document.getElementById('retry-awb')?.addEventListener('click', () => renderAwbScreen(order));
      }
    }

    function errorBanner() {
      return lastError ? `<div class="banner banner-danger">${lastError}</div>` : '';
    }
    function showError(msg: string) {
      lastError = msg;
    }

    // window.prompt() is unreliable in PWA/standalone contexts on mobile —
    // this inline form is the real manual-entry fallback (§8). `suggested`,
    // when the app already knows the expected code, gives a one-tap fill
    // instead of retyping a long code.
    function renderManualEntry(label: string, onSubmit: (value: string) => void, onCancel: () => void, suggested?: string) {
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center;">
          <span class="eyebrow">${label}</span>
          ${suggested ? `<button class="btn btn-primary" id="manual-suggested">Use ${suggested}</button>` : ''}
          <input type="text" id="manual-input" autocomplete="off" autocapitalize="off" value="${suggested ?? ''}" />
          <button class="btn${suggested ? ' btn-ghost' : ' btn-primary'}" id="manual-submit">Submit</button>
          <button class="btn btn-ghost" id="manual-cancel">Cancel</button>
        </div>`;
      const input = document.getElementById('manual-input') as HTMLInputElement;
      input.focus();
      const submit = () => {
        if (input.value.trim()) onSubmit(input.value.trim());
      };
      document.getElementById('manual-suggested')?.addEventListener('click', () => onSubmit(suggested!));
      document.getElementById('manual-submit')?.addEventListener('click', submit);
      document.getElementById('manual-cancel')?.addEventListener('click', onCancel);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          submit();
        }
      });
    }

    boot();
  </script>
</Base>
