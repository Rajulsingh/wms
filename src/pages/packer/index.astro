---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import PackerSidebar from '../../components/PackerSidebar.astro';
import { getDb } from '../../lib/db';
import { getCurrentUser, toClientUser } from '../../lib/auth';
import { getMyPackBatches } from '../../lib/packer';

// Resolved server-side — see toClientUser in lib/auth.ts.
const db = getDb();
const user = await getCurrentUser(Astro, db);
if (!user) return Astro.redirect('/login');
const serverUser = toClientUser(user);

// Same query the client's boot()/startSession() used to make over the wire
// via POST /api/packer/start-session, run here instead so the first paint
// already has real batches — see HANDOFF.md's "tab switch is a full MPA
// nav" entry. getMyPackBatches is safe to call repeatedly (the client's own
// 8s poll already does), so calling it once more here isn't a new side
// effect. Skipped when there's no station — the client shows a different
// "no station assigned" message for that case and never calls this either.
const initialBatches = user.role === 'packer' && user.station_id ? (await getMyPackBatches(db, user.id, user.station_id, user.warehouse_id ?? '')).batches : null;
---

<Base title="Packer">
  <div class="screen">
    <PackerSidebar current="pack" />
    <TopBar section="Packing" homeHref="/packer/home">
      <a href="/picker" class="pill tab-pill" style="text-decoration: none;">Pick<span class="badge-dot" id="badge-pick"></span></a>
      <a href="/packer" class="pill tab-pill active" style="text-decoration: none;">Pack<span class="badge-dot" id="badge-pack"></span></a>
      <a href="/packer/scan" class="pill tab-pill" style="text-decoration: none;">Scan</a>
      <a href="/dashboard" class="pill tab-pill" style="text-decoration: none;">Today</a>
    </TopBar>
    <div id="app" class="stack" style="flex: 1;">
      <p>Loading…</p>
    </div>
  </div>

  <script define:vars={{ serverUser, initialBatches }}>
    window.__serverUser = serverUser;
    window.__initialBatches = initialBatches;
  </script>
  <script>
    import { withLoading, escapeHtml, qtyStepperHtml, wireQtySteppers } from '../../lib/ui';

    interface PackBatchItem {
      order_item_id: string;
      order_id: string;
      external_order_id: string;
      order_notes: string | null;
      sku_code: string;
      sku_name: string;
      msku: string | null;
      image_url: string | null;
      quantity_required: number;
      quantity_packed: number;
    }
    interface PackBatchOrder {
      orderId: string;
      externalOrderId: string;
      packSessionId: string;
      allPacked: boolean;
      notes: string | null;
    }
    interface PackBatchState {
      pickBatchId: string;
      items: PackBatchItem[];
      orders: PackBatchOrder[];
      allPacked: boolean;
    }

    // Each entry is one order's own packing ticket (batching no longer
    // bundles several orders together — see HANDOFF.md). Labeling happens
    // entirely on the separate /packer/scan page now — "Finish packing"
    // here just completes the pack session(s) and removes them from this
    // list; scanning/labeling is a later, decoupled step a packer does from
    // a pile of already-packed boxes, not something this page walks them
    // through inline. See HANDOFF.md.
    interface BatchEntry {
      pack: PackBatchState;
    }
    type SortMode = 'sku' | 'order';
    interface OrderRow {
      entry: BatchEntry;
      order: PackBatchOrder;
      items: PackBatchItem[];
    }

    const app = document.getElementById('app')!;
    let warehouseId = '';
    let batchList: BatchEntry[] = [];
    let sortMode: SortMode = 'sku';
    let selectedOrderIds = new Set<string>();
    let lastError = '';
    let lastSuccess = '';
    let pollTimer: ReturnType<typeof setInterval> | null = null;

    function stopPolling() {
      if (pollTimer !== null) {
        clearInterval(pollTimer);
        pollTimer = null;
      }
    }

    async function api(path: string, body?: unknown) {
      const res = await fetch(path, {
        method: body === undefined ? 'GET' : 'POST',
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    // Badge on the "Pick" tab so a packer knows work is waiting there without
    // switching over to check.
    function pollWorkBadge() {
      setInterval(async () => {
        if (document.hidden) return;
        try {
          const summary = await api(`/api/packer/work-summary?warehouseId=${warehouseId}`);
          document.getElementById('badge-pick')?.classList.toggle('show', summary.pickable > 0);
        } catch {
          // Badge is a convenience, not load-bearing — ignore transient failures.
        }
      }, 10000);
    }

    async function boot() {
      const user = (window as any).__serverUser;
      if (user.role !== 'packer') {
        app.innerHTML = `<p>This account is a "${user.role}", not a packer.</p>`;
        return;
      }
      warehouseId = user.warehouseId;
      pollWorkBadge();

      if (!user.stationId) {
        app.innerHTML = `
          <div class="stack" style="flex:1; justify-content:center; text-align:center;">
            <p>No packing station is assigned to your account yet — ask an admin to assign one in
            <a href="/admin/users">Users</a>.</p>
          </div>`;
        return;
      }
      const initial = (window as any).__initialBatches;
      if (initial) {
        batchList = initial.map(toEntry);
        render();
        pollTimer = setInterval(pollForMore, 8000);
      } else {
        await startSession();
      }
    }

    function toEntry(pack: PackBatchState): BatchEntry {
      return { pack };
    }

    // Station is a fixed property of the logged-in packer's account now
    // (users.station_id, assigned once by admin) — nothing to tap/scan into
    // here, so this just loads whatever's open for them and starts polling.
    async function startSession(btn?: HTMLButtonElement) {
      try {
        const result = btn
          ? await withLoading(btn, 'Checking…', () => api('/api/packer/start-session', { warehouseId }))
          : await api('/api/packer/start-session', { warehouseId });
        const batches: PackBatchState[] = result?.batches ?? [];
        stopPolling();
        batchList = batches.map(toEntry);
        render();
        // Always polling from here on, not just while empty — new batches
        // keep getting picked; freshly ready ones just append rather than
        // needing a "get next batch" click. See HANDOFF.md.
        pollTimer = setInterval(pollForMore, 8000);
      } catch (err) {
        showError((err as Error).message);
        render();
      }
    }

    async function pollForMore() {
      if (document.hidden) return;
      try {
        const result = await api('/api/packer/start-session', { warehouseId });
        const incoming: PackBatchState[] = result?.batches ?? [];
        const newOnes = incoming.filter((b) => !batchList.some((e) => e.pack.pickBatchId === b.pickBatchId));
        if (newOnes.length) {
          batchList.push(...newOnes.map(toEntry));
          render();
        }
      } catch {
        // Transient — ignore, the next tick retries.
      }
    }

    // Every order across every currently-open entry, flattened into one
    // list — same principle as picking's flat SKU list, just the other
    // axis. Grouped by order, not SKU: picking is "bring N of this SKU,
    // whichever orders it's for" (a floor task); by the pack station the
    // units for one order are already together and the job is "box up this
    // order", so the packer needs one order's full line list (every SKU it
    // needs, with its quantity) to know at a glance whether it's a
    // multi-quantity order.
    function flattenOrders(): OrderRow[] {
      return batchList.flatMap((entry) =>
        entry.pack.orders.map((order) => ({ entry, order, items: entry.pack.items.filter((i) => i.order_id === order.orderId) }))
      );
    }

    // "Nothing to pack" orders (every item came back short/damaged during
    // picking) sort last in SKU mode — there's no SKU to sort them by.
    function primarySkuCode(items: PackBatchItem[]): string {
      if (!items.length) return '￿';
      return items.reduce((min, i) => (i.sku_code < min ? i.sku_code : min), items[0].sku_code);
    }

    function sortRows(rows: OrderRow[]): OrderRow[] {
      const sorted = rows.slice();
      if (sortMode === 'sku') {
        sorted.sort((a, b) => primarySkuCode(a.items).localeCompare(primarySkuCode(b.items)) || a.order.externalOrderId.localeCompare(b.order.externalOrderId));
      } else {
        sorted.sort((a, b) => a.order.externalOrderId.localeCompare(b.order.externalOrderId));
      }
      return sorted;
    }

    interface SkuGroup {
      key: string;
      skuLabel: string;
      skuName: string;
      imageUrl: string | null;
      rows: OrderRow[];
    }

    // A single-item order has exactly one SKU to group it under; a
    // multi-item order doesn't (it needs its own full line list, same as
    // today), so those never group.
    function groupKeyFor(items: PackBatchItem[]): string | null {
      if (items.length !== 1) return null;
      return items[0].msku || items[0].sku_code;
    }

    // Same-SKU single-item orders are the packer's most repetitive work —
    // "25 orders, all just one of the same SKU" — so cluster them under one
    // header with a single "mark all packed" action instead of 25 separate
    // cards to scroll and tap through individually. A lone order for a SKU
    // stays an ordinary card rather than becoming a one-row "group" that
    // adds nothing. Only applies in SKU sort mode — order-ID mode stays the
    // classic flat per-order list with its own quantity stepper, for a
    // packer who needs to short-pack one specific order.
    function buildSkuGroups(rows: OrderRow[]): { groups: SkuGroup[]; rest: OrderRow[] } {
      const byKey = new Map<string, OrderRow[]>();
      const rest: OrderRow[] = [];
      for (const row of rows) {
        const key = groupKeyFor(row.items);
        if (!key) {
          rest.push(row);
          continue;
        }
        const list = byKey.get(key) ?? [];
        list.push(row);
        byKey.set(key, list);
      }

      const groups: SkuGroup[] = [];
      for (const [key, groupRows] of byKey) {
        if (groupRows.length < 2) {
          rest.push(...groupRows);
          continue;
        }
        const first = groupRows[0].items[0];
        groups.push({ key, skuLabel: first.msku || first.sku_code, skuName: first.sku_name, imageUrl: first.image_url, rows: groupRows });
      }
      groups.sort((a, b) => a.skuLabel.localeCompare(b.skuLabel));
      return { groups, rest };
    }

    function getReadyEntries(): BatchEntry[] {
      return batchList.filter((e) => e.pack.allPacked);
    }

    function render() {
      if (!batchList.length) {
        app.innerHTML = `
          <div class="stack" style="flex:1; justify-content:center; text-align:center;">
            ${lastSuccess ? `<div class="banner banner-success">${escapeHtml(lastSuccess)}</div>` : ''}
            <p>No orders waiting to pack — this checks automatically, or tap to check now.</p>
            <button class="btn" id="retry">Check again</button>
            <a class="btn btn-ghost" href="/packer/scan" style="text-decoration: none;">Go to Scan</a>
          </div>`;
        document.getElementById('retry')?.addEventListener('click', (e) => startSession(e.currentTarget as HTMLButtonElement));
        return;
      }

      const rows = sortRows(flattenOrders());
      const totalSkuLines = new Set(rows.flatMap((r) => r.items.map((i) => i.sku_code))).size;
      const readyEntries = getReadyEntries();
      const readyOrderCount = readyEntries.reduce((sum, e) => sum + e.pack.orders.length, 0);

      // Drop any selected id that's no longer selectable (already packed by
      // now, or vanished from the list) so the count shown never lags reality.
      const selectableIds = new Set(rows.filter((r) => !r.order.allPacked && r.items.length > 0).map((r) => r.order.orderId));
      for (const id of selectedOrderIds) if (!selectableIds.has(id)) selectedOrderIds.delete(id);

      app.innerHTML = `
        ${errorBanner()}
        ${lastSuccess ? `<div class="banner banner-success">${escapeHtml(lastSuccess)}</div>` : ''}
        <div class="row" style="justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
          <div class="row" id="summary" style="width: auto; gap: 16px; flex-wrap: wrap;">
            <span class="pill">${rows.length} orders</span>
            <span class="pill">${totalSkuLines} SKU lines</span>
          </div>
          <select id="sort-select" style="width: auto;">
            <option value="sku">Sort by SKU</option>
            <option value="order">Sort by order ID</option>
          </select>
        </div>
        ${
          selectedOrderIds.size > 0
            ? `<div class="row" style="justify-content: space-between; align-items: center; gap: 10px; background: var(--surface-2); padding: 10px 14px; border-radius: var(--radius); margin-top: 10px;">
                 <span style="font-weight: 600; font-size: 0.85rem;">${selectedOrderIds.size} selected</span>
                 <div class="row" style="width: auto; gap: 8px;">
                   <button class="btn btn-ghost" id="clear-selection" style="width: auto;">Clear</button>
                   <button class="btn btn-primary" id="bulk-pack" style="width: auto;">Mark ${selectedOrderIds.size} packed</button>
                 </div>
               </div>`
            : ''
        }
        ${readyOrderCount > 0 ? `<button class="btn btn-primary" id="finish-all" style="margin-top: 10px;">Finish packing (${readyOrderCount})</button>` : ''}
        <div class="stack" id="order-container" style="gap: 14px; margin-top: 6px;"></div>`;

      const select = document.getElementById('sort-select') as unknown as HTMLSelectElement;
      select.value = sortMode;
      select.addEventListener('change', () => {
        sortMode = select.value as SortMode;
        render();
      });
      document.getElementById('finish-all')?.addEventListener('click', finishAllReady);
      document.getElementById('bulk-pack')?.addEventListener('click', handleBulkMarkPacked);
      document.getElementById('clear-selection')?.addEventListener('click', () => {
        selectedOrderIds.clear();
        render();
      });

      const { groups, rest } = sortMode === 'sku' ? buildSkuGroups(rows) : { groups: [] as SkuGroup[], rest: rows };
      const container = document.getElementById('order-container')!;
      for (const group of groups) container.appendChild(renderSkuGroupCard(group));
      for (const row of rest) container.appendChild(renderOrderCard(row));
    }

    // One header per same-SKU cluster (see buildSkuGroups) with a single
    // "mark all packed" action, plus a compact row per order underneath —
    // not a full card each, since the whole point is fitting 25 of them on
    // screen at once instead of 25 scrolls.
    function renderSkuGroupCard(group: SkuGroup): HTMLElement {
      const unpackedRows = group.rows.filter((r) => !r.order.allPacked);
      const packedCount = group.rows.length - unpackedRows.length;

      const el = document.createElement('div');
      el.className = 'card';

      const header = document.createElement('div');
      header.className = 'row';
      header.style.cssText = 'justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap;';
      header.innerHTML = `
        <div class="row" style="width: auto; gap: 10px; align-items: center;">
          ${group.imageUrl ? `<img class="thumb" src="${group.imageUrl}" alt="" />` : '<div class="thumb"></div>'}
          <div class="stack" style="gap: 2px;">
            <span style="font-weight: 700;">${escapeHtml(group.skuLabel)}</span>
            <span style="font-size: 0.78rem; color: var(--muted);">${escapeHtml(group.skuName)} · ${group.rows.length} orders</span>
          </div>
        </div>
        <div class="row" style="width: auto; gap: 8px; align-items: center;">
          <span class="status-pill ${unpackedRows.length ? 'status-neutral' : 'status-success'}">${packedCount}/${group.rows.length} packed</span>
          ${unpackedRows.length ? `<button class="btn btn-primary" data-action="pack-group" style="width: auto;">Mark all ${unpackedRows.length} packed</button>` : ''}
        </div>`;
      el.appendChild(header);

      const rowsEl = document.createElement('div');
      rowsEl.className = 'stack';
      rowsEl.style.cssText = 'gap: 0; margin-top: 10px;';
      for (const row of group.rows) rowsEl.appendChild(renderGroupOrderRow(row));
      el.appendChild(rowsEl);

      header.querySelector('[data-action="pack-group"]')?.addEventListener('click', async (e) => {
        await withLoading(e.currentTarget as HTMLButtonElement, 'Packing…', () => packRows(unpackedRows));
      });

      return el;
    }

    function renderGroupOrderRow(row: OrderRow): HTMLElement {
      const { order, items } = row;
      const qty = items.reduce((sum, i) => sum + i.quantity_required, 0);
      const el = document.createElement('div');
      el.className = 'row';
      el.style.cssText = 'justify-content: space-between; align-items: center; gap: 10px; padding: 6px 0; border-top: 1px solid var(--border);';
      el.innerHTML = `
        <span style="font-size: 0.85rem; font-variant-numeric: tabular-nums;">${escapeHtml(order.externalOrderId)}${qty > 1 ? ` <span style="color: var(--muted);">×${qty}</span>` : ''}</span>
        ${
          order.allPacked
            ? '<span class="status-pill status-success" style="font-size: 0.72rem;">Packed</span>'
            : '<button class="btn btn-ghost" data-action="pack-one" style="width: auto; padding: 4px 12px; font-size: 0.78rem; min-height: 32px;">Pack</button>'
        }`;

      el.querySelector('[data-action="pack-one"]')?.addEventListener('click', async (e) => {
        await withLoading(e.currentTarget as HTMLButtonElement, '…', () => packRows([row]));
      });
      return el;
    }

    function renderOrderCard(row: OrderRow): HTMLElement {
      const { entry, order, items } = row;
      const totalRequired = items.reduce((sum, i) => sum + i.quantity_required, 0);
      const totalPacked = items.reduce((sum, i) => sum + i.quantity_packed, 0);
      // An order can legitimately have zero lines here — every one of its
      // items came back short/damaged during picking, so there's nothing
      // physically left to pack for it (it still needs a label).
      const nothingToPack = items.length === 0;
      // Flagged so a packer double-checks before boxing it up as if it were
      // a routine single-item order — easy to under-pack by habit otherwise.
      const isMultiItem = items.length > 1;
      const isMultiQty = items.some((i) => i.quantity_required > 1);
      // Selectable for the bulk "mark packed" action below — same
      // eligibility as the individual button (not already packed, has
      // something to pack).
      const selectable = !order.allPacked && !nothingToPack;

      const el = document.createElement('div');
      el.className = 'card';
      el.innerHTML = `
        <div class="row" style="justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap;">
          <div class="row" style="width: auto; gap: 10px; align-items: center;">
            ${selectable ? `<input type="checkbox" class="order-select" style="width: 20px; height: 20px; flex-shrink: 0;" ${selectedOrderIds.has(order.orderId) ? 'checked' : ''} />` : ''}
            <span style="font-weight: 700; font-variant-numeric: tabular-nums;">${escapeHtml(order.externalOrderId)}</span>
            ${isMultiItem ? '<span class="status-pill status-warning">Multi-item</span>' : ''}
            ${isMultiQty ? '<span class="status-pill status-warning">Multi-qty</span>' : ''}
          </div>
          ${order.allPacked ? '<span class="status-pill status-success">Packed</span>' : `<span class="status-pill status-neutral">${totalPacked}/${totalRequired}</span>`}
        </div>
        ${order.notes ? `<div class="banner banner-warning" style="margin-top: 6px; padding: 8px 12px;">${escapeHtml(order.notes)}</div>` : ''}
        ${nothingToPack ? '<p style="font-size: 0.8rem; margin: 8px 0 0;">Nothing to pack — every item on this order came back short or damaged while picking. It still needs a label.</p>' : ''}
        <div class="stack" id="lines-${order.packSessionId}" style="gap: 10px; margin-top: 10px;"></div>
        ${selectable ? `<button class="btn btn-primary" data-action="pack-order" style="margin-top: 10px;">Mark order packed</button>` : ''}`;

      const linesEl = el.querySelector(`#lines-${order.packSessionId}`)!;
      for (const item of items) linesEl.appendChild(renderOrderLine(item, order.allPacked));
      wireQtySteppers(el);

      el.querySelector('.order-select')?.addEventListener('change', () => {
        if (selectedOrderIds.has(order.orderId)) selectedOrderIds.delete(order.orderId);
        else selectedOrderIds.add(order.orderId);
        render();
      });

      el.querySelector('[data-action="pack-order"]')?.addEventListener('click', async () => {
        const lines = items.map((item) => {
          const input = el.querySelector(`.qty-input[data-item="${item.order_item_id}"]`) as HTMLInputElement;
          return { orderItemId: item.order_item_id, quantity: Number(input.value) };
        });
        await handleMarkPacked(entry, order.orderId, lines);
      });
      return el;
    }

    // A multi-quantity line is visible right on the row (e.g. "×3") instead
    // of being buried in an aggregate SKU total — that's the whole point of
    // grouping by order. The quantity stays editable (defaulting to the full
    // required amount) so a packer can still lower it if something turns up
    // missing/broken at the table, same flexibility picking's short-pick
    // flow has, just scoped to one line instead of a cross-order pool.
    function renderOrderLine(item: PackBatchItem, orderDone: boolean): HTMLElement {
      const el = document.createElement('div');
      el.className = 'row';
      el.style.alignItems = 'center';
      el.style.gap = '12px';
      el.innerHTML = `
        ${item.image_url ? `<img class="thumb thumb-lg" src="${item.image_url}" alt="" />` : '<div class="thumb thumb-lg"></div>'}
        <div class="stack" style="gap: 2px; flex: 1; min-width: 0;">
          <span class="qty" style="font-size: 1.05rem;">${escapeHtml(item.msku || item.sku_code)} <span style="color: var(--muted); font-weight: 400; font-size: 0.9rem;">×${item.quantity_required}</span></span>
          <span style="font-size: 0.78rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${escapeHtml(item.sku_name)}</span>
        </div>
        ${
          orderDone
            ? `<span class="status-pill status-success">${item.quantity_packed}</span>`
            : qtyStepperHtml(
                `<input type="number" class="qty-input" data-item="${item.order_item_id}" min="0" max="${item.quantity_required}" value="${item.quantity_required}" style="width: 56px; flex: 0 0 auto; min-height: 44px; text-align: center;" />`
              )
        }`;
      return el;
    }

    // Mutates entry.pack.items and re-renders before the network call
    // resolves — the tap feels instant instead of waiting on a round trip.
    // Rolled back if the server disagrees.
    function applyOptimisticPackOrder(items: PackBatchItem[], lines: Array<{ orderItemId: string; quantity: number }>) {
      for (const line of lines) {
        const item = items.find((i) => i.order_item_id === line.orderItemId);
        if (item) item.quantity_packed = line.quantity;
      }
    }

    async function handleMarkPacked(entry: BatchEntry, orderId: string, lines: Array<{ orderItemId: string; quantity: number }>) {
      const snapshot = entry.pack.items.map((i) => ({ ...i }));
      applyOptimisticPackOrder(entry.pack.items, lines);
      lastError = '';
      render();
      try {
        entry.pack = await api('/api/packer/mark-item', { pickBatchId: entry.pack.pickBatchId, orderId, lines });
        render();
      } catch (err) {
        entry.pack.items = snapshot;
        lastError = (err as Error).message;
        render();
      }
    }

    // Shared by the manual-selection bulk bar and a SKU group's "mark all
    // packed" button — every given order at once, each submitted at its own
    // full required quantity (no per-line adjustment here; a packer who
    // needs to short-pack one specific order does that individually via its
    // own "Mark order packed"/"Pack" instead). Failures across the batch are
    // collected into one message rather than each order's own attempt
    // clobbering the last, since there's no single call to fail or succeed
    // here — many independent ones.
    async function packRows(rows: OrderRow[]) {
      lastError = '';
      const failed: string[] = [];
      for (const row of rows) {
        if (row.order.allPacked || !row.items.length) continue;
        const snapshot = row.entry.pack.items.map((i) => ({ ...i }));
        const lines = row.items.map((i) => ({ orderItemId: i.order_item_id, quantity: i.quantity_required }));
        applyOptimisticPackOrder(row.entry.pack.items, lines);
        render();
        try {
          row.entry.pack = await api('/api/packer/mark-item', { pickBatchId: row.entry.pack.pickBatchId, orderId: row.order.orderId, lines });
        } catch {
          row.entry.pack.items = snapshot;
          failed.push(row.order.externalOrderId);
        }
      }
      if (failed.length) lastError = `Could not mark packed: ${failed.join(', ')}`;
      render();
    }

    async function handleBulkMarkPacked() {
      const ids = [...selectedOrderIds];
      if (!ids.length) return;
      const rows = flattenOrders().filter((r) => ids.includes(r.order.orderId) && !r.order.allPacked && r.items.length > 0);
      await packRows(rows);
      selectedOrderIds.clear();
      render();
    }

    // The single, page-level "Finish packing" action: completes every
    // order that's currently packed-and-ready (across every entry, not just
    // one) and removes those entries from the working list. Labeling is a
    // separate, later step on /packer/scan — this just marks the pack
    // session done so the order becomes visible there. See HANDOFF.md.
    async function finishAllReady() {
      const readyEntries = getReadyEntries();
      if (!readyEntries.length) return;

      lastError = '';
      lastSuccess = '';
      let completedCount = 0;
      const completed: BatchEntry[] = [];
      for (const entry of readyEntries) {
        try {
          const { results } = await api('/api/packer/complete', { pickBatchId: entry.pack.pickBatchId });
          completedCount += (results as Array<{ orderId: string }>).length;
          completed.push(entry);
        } catch (err) {
          lastError = (err as Error).message;
        }
      }
      batchList = batchList.filter((e) => !completed.includes(e));
      if (completedCount > 0) {
        lastSuccess = `${completedCount} order${completedCount > 1 ? 's' : ''} completed — head to Scan to label ${completedCount > 1 ? 'them' : 'it'}.`;
      }
      render();
    }

    function errorBanner() {
      return lastError ? `<div class="banner banner-danger">${escapeHtml(lastError)}</div>` : '';
    }
    function showError(msg: string) {
      lastError = msg;
    }

    boot();
  </script>
</Base>
