---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
---

<Base title="Scan">
  <div class="screen">
    <TopBar section="Scan" homeHref="/packer/home">
      <a href="/picker" class="pill tab-pill" style="text-decoration: none;">Pick<span class="badge-dot" id="badge-pick"></span></a>
      <a href="/packer" class="pill tab-pill" style="text-decoration: none;">Pack<span class="badge-dot" id="badge-pack"></span></a>
      <a href="/packer/scan" class="pill tab-pill active" style="text-decoration: none;">Scan</a>
      <a href="/dashboard" class="pill tab-pill" style="text-decoration: none;">Today</a>
    </TopBar>
    <div id="app" class="stack" style="flex: 1;">
      <p>Loading…</p>
    </div>
  </div>

  <script>
    import { startContinuousScan, stopScanning } from '../../lib/scanner-client';
    import { escapeHtml } from '../../lib/ui';

    interface PendingLabelOrder {
      orderId: string;
      externalOrderId: string;
      notes: string | null;
      imageUrl: string | null;
      skuSummary: string;
      unitCount: number;
    }
    interface ScanLogRow {
      awbCode: string;
      orderId: string;
      externalOrderId: string;
      scannedAt: string;
      imageUrl: string | null;
      skuSummary: string;
      unitCount: number;
    }

    const app = document.getElementById('app')!;
    let warehouseId = '';
    let pending: PendingLabelOrder[] = [];
    let scans: ScanLogRow[] = [];
    let scanning = false;
    let lastFlash: { kind: 'success' | 'danger'; message: string } | null = null;

    async function api(path: string, body?: unknown) {
      const res = await fetch(path, {
        method: body === undefined ? 'GET' : 'POST',
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    function pollWorkBadge() {
      setInterval(async () => {
        if (document.hidden) return;
        try {
          const summary = await api(`/api/packer/work-summary?warehouseId=${warehouseId}`);
          document.getElementById('badge-pick')?.classList.toggle('show', summary.pickable > 0);
          document.getElementById('badge-pack')?.classList.toggle('show', summary.packable > 0);
        } catch {
          // Badge is a convenience, not load-bearing — ignore transient failures.
        }
      }, 10000);
    }

    async function boot() {
      const me = await api('/api/auth/me');
      if (!me.user) {
        window.location.href = '/login';
        return;
      }
      if (me.user.role !== 'packer') {
        app.innerHTML = `<p>This account is a "${me.user.role}", not a packer.</p>`;
        return;
      }
      warehouseId = me.user.warehouseId;
      pollWorkBadge();
      await refresh();
      renderFull();
      // Keeps "waiting" and the table current even while not actively
      // scanning — another packer's scans, or freshly finished packing,
      // should show up here without a manual reload. Skipped entirely
      // while scanning (see renderFull vs renderResults below) so it never
      // touches — let alone rebuilds — the live camera element.
      setInterval(async () => {
        if (document.hidden || scanning) return;
        await refresh();
        renderFull();
      }, 8000);
    }

    async function refresh() {
      try {
        const status = await api(`/api/packer/scan-status?warehouseId=${warehouseId}`);
        pending = status.pending ?? [];
        scans = status.todayScans ?? [];
      } catch {
        // Transient — keep whatever we already had, next tick retries.
      }
    }

    function formatTime(iso: string): string {
      return new Date(iso).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
    }

    function pendingListHtml(): string {
      if (!pending.length) return '';
      return `<div class="stack" style="gap: 8px; margin-top: 14px;">
        <span class="eyebrow">Next up, oldest first</span>
        ${pending
          .slice(0, 8)
          .map(
            (o) => `<div class="item-row">
              ${o.imageUrl ? `<img class="thumb" src="${o.imageUrl}" alt="" />` : '<div class="thumb"></div>'}
              <div class="stack" style="gap: 2px; flex: 1; min-width: 0;">
                <span style="font-weight: 700; font-variant-numeric: tabular-nums;">${escapeHtml(o.externalOrderId)}</span>
                <span style="font-size: 0.78rem; color: var(--muted);">${escapeHtml(o.skuSummary)} · ${o.unitCount} unit${o.unitCount > 1 ? 's' : ''}</span>
              </div>
            </div>`
          )
          .join('')}
        ${pending.length > 8 ? `<p style="font-size: 0.78rem; color: var(--muted); margin: 0;">+${pending.length - 8} more waiting</p>` : ''}
      </div>`;
    }

    function scanRowHtml(s: ScanLogRow): string {
      return `<tr>
        <td>${s.imageUrl ? `<img class="table-thumb" src="${s.imageUrl}" alt="" />` : ''}</td>
        <td style="font-weight: 700; font-variant-numeric: tabular-nums;">${escapeHtml(s.externalOrderId)}</td>
        <td>${escapeHtml(s.skuSummary)}</td>
        <td>${s.unitCount}</td>
        <td style="font-size: 0.8rem; color: var(--muted);">${escapeHtml(s.awbCode)}</td>
        <td>${formatTime(s.scannedAt)}</td>
      </tr>`;
    }

    function resultsHtml(): string {
      return `
        ${pendingListHtml()}
        <div class="stack" style="gap: 10px; margin-top: 16px;">
          <span class="eyebrow">Scanned today — ready to ship</span>
          ${
            scans.length
              ? `<div class="table-scroll"><table>
                   <thead><tr><th></th><th>Order ID</th><th>Product</th><th>Units</th><th>AWB</th><th>Time</th></tr></thead>
                   <tbody>${scans.map((s) => scanRowHtml(s)).join('')}</tbody>
                 </table></div>`
              : `<p>Nothing scanned yet today.</p>`
          }
        </div>`;
    }

    // Called after every scan while the camera is running. Only touches
    // #waiting-count and #results — the live <video> lives in #scan-area,
    // built once by renderFull() when scanning starts and never rebuilt
    // again until "Stop scanning". Rebuilding the whole page per scan (via
    // innerHTML) would tear down and reopen the camera every single time —
    // exactly the per-box friction this page exists to remove.
    function renderResults() {
      const waiting = document.getElementById('waiting-count');
      if (waiting) waiting.textContent = `${pending.length} waiting to be scanned`;
      const flash = document.getElementById('flash');
      if (flash) flash.outerHTML = flashHtml();
      const results = document.getElementById('results-area');
      if (results) results.innerHTML = resultsHtml();
    }

    function flashHtml(): string {
      return lastFlash ? `<div class="banner banner-${lastFlash.kind}" id="flash">${escapeHtml(lastFlash.message)}</div>` : '<div id="flash"></div>';
    }

    // Full rebuild — safe to call whenever scanning is NOT active (boot,
    // background poll, right after "Stop scanning").
    function renderFull() {
      app.innerHTML = `
        ${flashHtml()}
        <div class="row" style="justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
          <span class="pill" id="waiting-count">${pending.length} waiting to be scanned</span>
          <button class="btn btn-primary" id="start-scan" style="width: auto;">Start scanning</button>
        </div>
        <div id="scan-area"></div>
        <div id="results-area">${resultsHtml()}</div>`;

      document.getElementById('start-scan')?.addEventListener('click', beginScanning);
    }

    function beginScanning() {
      scanning = true;
      lastFlash = null;
      const scanArea = document.getElementById('scan-area')!;
      scanArea.innerHTML = `
        <video class="scanner" id="video" style="margin-top: 10px;"></video>
        <div class="row" style="margin-top: 10px; gap: 8px;">
          <input type="text" id="manual-awb" placeholder="Or type/scan an AWB code and press Enter" autocomplete="off" autocapitalize="off" />
        </div>`;
      const startBtn = document.getElementById('start-scan') as HTMLButtonElement;
      startBtn.textContent = 'Stop scanning';
      startBtn.className = 'btn btn-ghost';
      startBtn.replaceWith(startBtn.cloneNode(true)); // drop the old listener
      document.getElementById('start-scan')?.addEventListener('click', endScanning);

      document.getElementById('manual-awb')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const input = e.currentTarget as HTMLInputElement;
          const code = input.value.trim();
          if (code) {
            input.value = '';
            handleScannedCode(code);
          }
        }
      });

      const video = document.getElementById('video') as HTMLVideoElement;
      startContinuousScan(video, handleScannedCode, () => {
        scanning = false;
        lastFlash = { kind: 'danger', message: 'Could not open camera — use the text field to enter codes instead.' };
        renderResults();
      });
    }

    function endScanning() {
      stopScanning();
      scanning = false;
      renderFull();
    }

    // The whole point: no click needed per box. Every detected/typed code
    // is submitted immediately and the result flashes briefly while the
    // camera keeps running, untouched, for the next one. See
    // applyAwbByScan in lib/packer.ts for why matching is deliberately
    // simple (pure record-keeping via FIFO, not verification).
    async function handleScannedCode(awbCode: string) {
      try {
        const result = await api('/api/packer/scan-awb', { warehouseId, awbCode });
        lastFlash = { kind: 'success', message: `Scanned ${awbCode} → ${result.externalOrderId} (${result.skuSummary}) — ready to ship.` };
        await refresh();
      } catch (err) {
        lastFlash = { kind: 'danger', message: (err as Error).message };
      }
      renderResults();
    }

    boot();
  </script>
</Base>
