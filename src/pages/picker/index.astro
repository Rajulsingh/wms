---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
---

<Base title="Pick list">
  <div class="screen">
    <TopBar section="Picking">
      <a href="/picker" class="pill tab-pill active" style="text-decoration: none;">Pick<span class="badge-dot" id="badge-pick"></span></a>
      <a href="/packer" class="pill tab-pill" style="text-decoration: none;">Pack<span class="badge-dot" id="badge-pack"></span></a>
      <span class="pill" id="user-pill">…</span>
    </TopBar>

    <div id="app" class="stack" style="flex: 1;">
      <p>Loading…</p>
    </div>
  </div>

  <script>
    interface Row {
      pick_task_id: string;
      zone_name: string | null;
      location_code: string;
      sku_code: string;
      sku_name: string;
      image_url: string | null;
      external_order_id: string;
      order_source: string;
      quantity_required: number;
      quantity_picked: number;
      status: string;
    }

    const app = document.getElementById('app')!;
    const userPill = document.getElementById('user-pill')!;
    let warehouseId = '';
    let batchId: string | null = null;
    let rows: Row[] = [];
    let lastError = '';
    let pollTimer: ReturnType<typeof setInterval> | null = null;

    // Orders keep arriving and admin keeps creating batches — a picker sitting
    // on the "no batches"/"picking complete" screen should see new work show up
    // on its own, not have to keep tapping "check again".
    function stopPolling() {
      if (pollTimer !== null) {
        clearInterval(pollTimer);
        pollTimer = null;
      }
    }

    function pollForBatch() {
      stopPolling();
      pollTimer = setInterval(async () => {
        if (document.hidden) return;
        const claimed = await api('/api/picker/claim-batch', { warehouseId });
        if (claimed.batchId) {
          stopPolling();
          batchId = claimed.batchId;
          rows = claimed.rows ?? [];
          render();
        }
      }, 8000);
    }

    // Badge on the "Pack" tab so a picker knows work is waiting there without
    // switching over to check — packers never see price here or on that tab.
    function pollWorkBadge() {
      setInterval(async () => {
        if (document.hidden) return;
        try {
          const summary = await api(`/api/packer/work-summary?warehouseId=${warehouseId}`);
          document.getElementById('badge-pack')?.classList.toggle('show', summary.packable > 0);
        } catch {
          // Badge is a convenience, not load-bearing — ignore transient failures.
        }
      }, 10000);
    }

    async function api(path: string, body?: unknown) {
      const res = await fetch(path, {
        method: body === undefined ? 'GET' : 'POST',
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    async function boot() {
      const me = await api('/api/auth/me');
      if (!me.user) {
        window.location.href = '/login';
        return;
      }
      if (me.user.role !== 'packer') {
        app.innerHTML = `<p>This account is a "${me.user.role}" — picking needs a packer login.</p>`;
        return;
      }
      userPill.textContent = me.user.name;
      warehouseId = me.user.warehouseId;
      pollWorkBadge();

      const claimed = await api('/api/picker/claim-batch', { warehouseId });
      batchId = claimed.batchId;
      rows = claimed.rows ?? [];
      if (!batchId) {
        renderNoBatch();
        return;
      }
      stopPolling();
      render();
    }

    function renderNoBatch() {
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center; text-align:center;">
          <div class="big-label">No batches</div>
          <p>Nothing assigned right now — this checks automatically, or tap to check now.</p>
          <button class="btn" id="retry">Check again</button>
        </div>`;
      document.getElementById('retry')?.addEventListener('click', boot);
      pollForBatch();
    }

    function render() {
      lastError = '';
      const remaining = rows.filter((r) => r.status === 'pending');

      if (!remaining.length) {
        app.innerHTML = `
          <div class="stack" style="flex:1; justify-content:center; text-align:center;">
            <div class="banner banner-success">Picking complete</div>
            <div class="big-label">Go to packing station</div>
            <button class="btn" id="new-batch">Get next batch</button>
          </div>`;
        document.getElementById('new-batch')?.addEventListener('click', boot);
        return;
      }

      // Group into zone/bin sections, in the order the list already comes sorted (by location sequence).
      const groups: Array<{ key: string; zone: string; bin: string; rows: Row[] }> = [];
      for (const r of rows) {
        const key = `${r.zone_name ?? '—'}__${r.location_code}`;
        let group = groups.find((g) => g.key === key);
        if (!group) {
          group = { key, zone: r.zone_name ?? '—', bin: r.location_code, rows: [] };
          groups.push(group);
        }
        group.rows.push(r);
      }

      app.innerHTML = `
        ${errorBanner()}
        <div class="stack" id="summary" style="flex-direction: row; gap: 16px;">
          <span class="pill">${new Set(rows.map((r) => r.external_order_id)).size} orders</span>
          <span class="pill">${rows.length} lines</span>
          <span class="pill">${remaining.length} left</span>
        </div>
        <div class="stack" id="groups"></div>`;

      const groupsEl = document.getElementById('groups')!;
      for (const group of groups) {
        const section = document.createElement('div');
        section.className = 'stack';
        section.style.gap = '8px';
        section.innerHTML = `<div class="eyebrow">Zone ${group.zone} · Bin ${group.bin}</div>`;
        for (const r of group.rows) {
          section.appendChild(renderRow(r));
        }
        groupsEl.appendChild(section);
      }
    }

    function renderRow(r: Row): HTMLElement {
      const el = document.createElement('div');
      el.className = 'card';
      const done = r.status !== 'pending';
      el.innerHTML = `
        <div class="row" style="align-items: center; gap: 12px;">
          ${r.image_url ? `<img class="thumb" src="${r.image_url}" alt="" />` : '<div class="thumb"></div>'}
          <div class="stack" style="gap: 2px; flex: 1;">
            <span style="font-weight: 600;">${r.sku_name}</span>
            <span style="font-size: 0.8rem; color: var(--muted);">${r.sku_code} · Order ${r.external_order_id}</span>
          </div>
          <span class="qty">${r.quantity_picked}/${r.quantity_required}</span>
        </div>
        ${
          done
            ? `<div class="banner ${r.status === 'picked' ? 'banner-success' : 'banner-warning'}" style="margin-top: 10px; padding: 8px 12px;">${r.status === 'picked' ? 'Picked' : r.status === 'damaged' ? 'Damaged' : 'Short'}</div>`
            : `<div class="row" style="margin-top: 10px; gap: 8px;">
                 <button class="btn btn-primary" data-action="pick" data-id="${r.pick_task_id}" data-qty="${r.quantity_required}">Picked</button>
                 <button class="btn btn-ghost" data-action="issue" data-id="${r.pick_task_id}" data-qty="${r.quantity_required}">Report issue</button>
               </div>`
        }`;

      el.querySelector('[data-action="pick"]')?.addEventListener('click', async () => {
        await handleMarkPicked(r.pick_task_id, r.quantity_required);
      });
      el.querySelector('[data-action="issue"]')?.addEventListener('click', () => {
        renderIssueSheet(r);
      });
      return el;
    }

    async function handleMarkPicked(pickTaskId: string, quantity: number) {
      try {
        const res = await api('/api/picker/mark-picked', { batchId, pickTaskId, quantity });
        rows = res.rows;
        render();
      } catch (err) {
        lastError = (err as Error).message;
        render();
      }
    }

    function renderIssueSheet(r: Row) {
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center; text-align:center;">
          <span class="eyebrow">${r.sku_name}</span>
          <p>Required: ${r.quantity_required}</p>
          <div class="stack">
            <button class="btn btn-danger" id="damaged">Damaged — none usable</button>
          </div>
          <div class="stack" style="gap: 6px;">
            <label for="short-qty">Picked only this many (short pick)</label>
            <input type="number" id="short-qty" min="0" max="${r.quantity_required}" value="0" />
            <button class="btn" id="short-submit">Confirm short pick</button>
          </div>
          <button class="btn btn-ghost" id="cancel">Cancel</button>
        </div>`;

      document.getElementById('damaged')?.addEventListener('click', async () => {
        try {
          rows = await api('/api/picker/report-damaged', { batchId, pickTaskId: r.pick_task_id });
          render();
        } catch (err) {
          lastError = (err as Error).message;
          render();
        }
      });
      document.getElementById('short-submit')?.addEventListener('click', async () => {
        const qty = Number((document.getElementById('short-qty') as HTMLInputElement).value);
        await handleMarkPicked(r.pick_task_id, qty);
      });
      document.getElementById('cancel')?.addEventListener('click', render);
    }

    function errorBanner() {
      return lastError ? `<div class="banner banner-danger">${lastError}</div>` : '';
    }

    boot();
  </script>
</Base>
