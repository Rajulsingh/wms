---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import { getDb } from '../../lib/db';
import { getCurrentUser, toClientUser } from '../../lib/auth';
import { getMyBatches } from '../../lib/picker';

// Resolved server-side — see toClientUser in lib/auth.ts.
const db = getDb();
const user = await getCurrentUser(Astro, db);
if (!user) return Astro.redirect('/login');
const serverUser = toClientUser(user);

// Same query the client's boot() used to make over the wire via
// POST /api/picker/claim-batch, run here instead so the first paint already
// has real batches — see HANDOFF.md's "tab switch is a full MPA nav" entry.
// getMyBatches is safe to call repeatedly (the client's own 8s poll already
// does), so calling it once more here isn't a new side effect.
const initialBatches = user.role === 'packer' && user.warehouse_id ? await getMyBatches(db, user.warehouse_id, user.id) : null;
---

<Base title="Pick list">
  <div class="screen">
    <TopBar section="Picking" homeHref="/packer/home">
      <a href="/picker" class="pill tab-pill active" style="text-decoration: none;">Pick<span class="badge-dot" id="badge-pick"></span></a>
      <a href="/packer" class="pill tab-pill" style="text-decoration: none;">Pack<span class="badge-dot" id="badge-pack"></span></a>
      <a href="/packer/scan" class="pill tab-pill" style="text-decoration: none;">Scan</a>
      <a href="/dashboard" class="pill tab-pill" style="text-decoration: none;">Today</a>
    </TopBar>

    <div id="app" class="stack" style="flex: 1;">
      <p>Loading…</p>
    </div>
  </div>

  <script define:vars={{ serverUser, initialBatches }}>
    window.__serverUser = serverUser;
    window.__initialBatches = initialBatches;
  </script>
  <script>
    import { escapeHtml, qtyStepperHtml, wireQtySteppers, withLoading } from '../../lib/ui';

    interface Row {
      pick_task_id: string;
      zone_name: string | null;
      location_code: string;
      sku_code: string;
      sku_name: string;
      image_url: string | null;
      external_order_id: string;
      order_source: string;
      order_notes: string | null;
      quantity_required: number;
      quantity_picked: number;
      status: string;
    }

    interface BatchEntry {
      batchId: string;
      status: string;
      shipByDate: string | null;
      rows: Row[];
    }

    // Gates the picker into each ship-by-date's own list instead of dropping
    // them straight into everything the instant the page loads — the lists
    // themselves are still assembled fully automatically in the background
    // (claim-batch below runs on every boot with no admin step required),
    // this only adds a deliberate "I'm ready" tap before work starts for
    // that date, and a second explicit "go" before the picker is actually
    // looking at rack instructions for it. A picker with both a "ship by
    // today" and a "ship by tomorrow" picklist sees two independent gates —
    // activating one never touches the other, and once both are started
    // they sit as two clearly-labeled sections on the same continuous page
    // (see dateGroups/render below), not merged into one list, so a picker
    // can move between them without losing which is which.
    const startedDates = new Set<string>();

    function istDateString(d: Date): string {
      return d.toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
    }

    function dateLabel(date: string): string {
      if (date === 'unscheduled') return 'No ship-by date';
      const todayIst = istDateString(new Date());
      const tomorrowIst = istDateString(new Date(Date.now() + 24 * 60 * 60 * 1000));
      if (date === todayIst) return 'Ship by today';
      if (date === tomorrowIst) return 'Ship by tomorrow';
      const [y, m, d] = date.split('-').map(Number);
      return `Ship by ${new Date(y, m - 1, d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' })}`;
    }

    interface DateGroup {
      date: string;
      batches: BatchEntry[];
      activated: boolean;
      started: boolean;
    }

    // One card per ship-by date currently among this picker's batches, but
    // only for today and tomorrow — the floor only ever needs to work
    // today's and tomorrow's picklists; a far-future order (like the
    // original Sept 27 one) stays reserved and stock-locked exactly as
    // before, it just doesn't get its own card cluttering this screen until
    // its date actually rolls into the window. Nothing needs to "release"
    // it — this filter is recomputed against the real clock on every
    // render, so a 3-day-out order becomes tomorrow's card on its own the
    // moment the calendar catches up, no separate job needed. Oldest date
    // first — mirrors admin's own ship-by grouping (see shipByDate in
    // admin/index.astro) so "today"/"tomorrow" mean the same thing
    // everywhere in the app. `activated` mirrors the original global
    // isActivated check, just scoped to this date's own batches; a batch
    // freshly swept in mid-walk for a date the picker already activated
    // inherits that date's activated state immediately (same reasoning as
    // markBatchStarted in lib/picker.ts — proof of work already underway on
    // this date is what matters, not each individual batch's own status).
    function dateGroups(): DateGroup[] {
      const map = new Map<string, BatchEntry[]>();
      for (const b of batchList) {
        const key = b.shipByDate ?? 'unscheduled';
        const list = map.get(key) ?? [];
        list.push(b);
        map.set(key, list);
      }
      const todayIst = istDateString(new Date());
      const tomorrowIst = istDateString(new Date(Date.now() + 24 * 60 * 60 * 1000));
      return [...map.entries()]
        .filter(([date]) => date === 'unscheduled' || date === todayIst || date === tomorrowIst)
        .sort(([a], [b]) => (a === 'unscheduled' ? 1 : b === 'unscheduled' ? -1 : a.localeCompare(b)))
        .map(([date, batches]) => {
          const activated = batches.some((b) => b.status === 'in_progress' || b.status === 'completed');
          const hasStarted = batches.some((b) => b.rows.some((r) => r.status !== 'pending'));
          return { date, batches, activated, started: activated && (hasStarted || startedDates.has(date)) };
        });
    }

    function groupSummary(batches: BatchEntry[]): { orders: number; lines: number; units: number } {
      const rows = batches.flatMap((b) => b.rows);
      return {
        orders: new Set(rows.map((r) => r.external_order_id)).size,
        lines: new Set(rows.map((r) => `${r.location_code}__${r.sku_code}`)).size,
        units: rows.reduce((sum, r) => sum + r.quantity_required, 0)
      };
    }

    interface LocationGroup {
      key: string;
      zone: string;
      bin: string;
      rows: Row[];
    }

    interface SkuGroup {
      sku_code: string;
      sku_name: string;
      image_url: string | null;
      rows: Row[];
    }

    const app = document.getElementById('app')!;
    let warehouseId = '';
    let batchList: BatchEntry[] = [];
    let lastError = '';

    // Keyed by `${locationCode}__${skuCode}` — a SKU group that's mid-way
    // through the "why was this short" flow. A SKU group is no longer
    // scoped to one batch (see render() below), so batch id has no place in
    // this key any more — the same SKU at the same bin across two different
    // batches is one card, one action, one reason.
    const pendingReasonFor: Record<string, { pickTaskIds: string[]; quantity: number }> = {};

    async function api(path: string, body?: unknown) {
      const res = await fetch(path, {
        method: body === undefined ? 'GET' : 'POST',
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    async function boot() {
      const user = (window as any).__serverUser;
      if (user.role !== 'packer') {
        app.innerHTML = `<p>This account is a "${user.role}" — picking needs a packer login.</p>`;
        return;
      }
      warehouseId = user.warehouseId;
      pollWorkBadge();

      const initial = (window as any).__initialBatches;
      batchList = initial ?? (await api('/api/picker/claim-batch', { warehouseId })).batches ?? [];
      render();

      // Batches keep arriving — admin assigning one directly, a fresh
      // auto-sweep once everything currently shown is finished, or a brand
      // new ship-by date showing up for the first time — so this never
      // stops polling. Only actually re-renders when something new shows
      // up, so an open "why was this short" panel elsewhere on the page
      // survives a quiet tick. render() itself is stage-aware per date (see
      // dateGroups above), so a poll can safely add a new gate card for one
      // date while leaving another date's in-progress work undisturbed.
      setInterval(pollForMore, 8000);
    }

    async function pollForMore() {
      if (document.hidden) return;
      try {
        const data = await api('/api/picker/claim-batch', { warehouseId });
        const incoming: BatchEntry[] = data.batches ?? [];
        const newOnes = incoming.filter((b) => !batchList.some((e) => e.batchId === b.batchId));
        if (!newOnes.length) return;
        batchList.push(...newOnes);
        render();
      } catch {
        // Transient — ignore, the next tick retries.
      }
    }

    function renderGateCard(g: DateGroup): HTMLElement {
      const { orders, lines, units } = groupSummary(g.batches);
      const el = document.createElement('div');
      el.className = 'card stack';
      el.style.gap = '10px';
      el.innerHTML = `
        <div class="eyebrow">${escapeHtml(dateLabel(g.date))}</div>
        <p style="margin: 0;">${orders} order${orders === 1 ? '' : 's'} · ${lines} SKU line${lines === 1 ? '' : 's'} · ${units} unit${units === 1 ? '' : 's'}</p>
        <button class="btn btn-primary activate-btn" style="width: auto; align-self: flex-start;">Activate pick list</button>`;
      const btn = el.querySelector('.activate-btn') as HTMLButtonElement;
      btn.addEventListener('click', () => activate(g.date, btn));
      return el;
    }

    function renderReadyCard(g: DateGroup): HTMLElement {
      const { orders, lines, units } = groupSummary(g.batches);
      const el = document.createElement('div');
      el.className = 'card stack';
      el.style.gap = '10px';
      el.innerHTML = `
        <div class="eyebrow">${escapeHtml(dateLabel(g.date))}</div>
        <div class="banner banner-success" style="display: inline-block; width: fit-content;">Pick list activated</div>
        <p style="margin: 0;">${orders} order${orders === 1 ? '' : 's'} · ${lines} SKU line${lines === 1 ? '' : 's'} · ${units} unit${units === 1 ? '' : 's'} ready to go.</p>
        <button class="btn btn-primary start-btn" style="width: auto; align-self: flex-start;">Start picking</button>`;
      el.querySelector('.start-btn')?.addEventListener('click', () => {
        startedDates.add(g.date);
        render();
      });
      return el;
    }

    // Re-fetches (rather than reusing what render() already has) so
    // "activate" genuinely reflects the current pick list — anything
    // assigned in the seconds between landing on this screen and tapping
    // the button is included, not just whatever existed at page load. The
    // optimized getMyBatches (lib/picker.ts) fetches every batch's rows in
    // one query instead of looping per batch, so this stays fast even with
    // a full cart of small orders.
    //
    // The actual persistence happens server-side (activate-batches, scoped
    // to this one shipByDate — before the re-fetch) — this is what makes
    // activation survive a reload instead of living only in this file's own
    // state, and what keeps it from ever touching a picker's other,
    // not-yet-activated date. See activateBatches in lib/picker.ts.
    async function activate(shipByDate: string, btn: HTMLButtonElement) {
      try {
        await withLoading(btn, 'Activating…', async () => {
          await api('/api/picker/activate-batches', { warehouseId, shipByDate });
          const data = await api('/api/picker/claim-batch', { warehouseId });
          batchList = data.batches ?? [];
        });
        lastError = '';
      } catch (err) {
        lastError = (err as Error).message;
      }
      render();
    }

    // Badge on the "Pack" tab so a picker knows work is waiting there without
    // switching over to check — packers never see price here or on that tab.
    function pollWorkBadge() {
      setInterval(async () => {
        if (document.hidden) return;
        try {
          const summary = await api(`/api/packer/work-summary?warehouseId=${warehouseId}`);
          document.getElementById('badge-pack')?.classList.toggle('show', summary.packable > 0);
        } catch {
          // Badge is a convenience, not load-bearing — ignore transient failures.
        }
      }, 10000);
    }

    function renderNoBatch() {
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center; text-align:center;">
          <div class="big-label">No batches</div>
          <p>Nothing assigned right now — this checks automatically, or tap to check now.</p>
          <button class="btn" id="retry">Check again</button>
        </div>`;
      document.getElementById('retry')?.addEventListener('click', boot);
    }

    // One section per ship-by date the picker has actually started (tapped
    // "Start picking", or resumed mid-walk — see dateGroups above). Every
    // pick_task within *that date* collapses into one flat list, grouped by
    // location then SKU — never by batch and never by order, same as
    // before. Two batches needing the same SKU at the same bin merge into a
    // single card and a single "Mark done" tap covers both, but only within
    // one date — the same SKU needed for both today and tomorrow renders as
    // two separate cards, one per section, since picking tomorrow's stock
    // into today's box (or the reverse) is exactly the mistake keeping
    // dates visually distinct is meant to prevent. See HANDOFF.md.
    function renderWorkingSection(g: DateGroup): HTMLElement {
      const rows = g.batches.flatMap((b) => b.rows);
      const remaining = rows.filter((r) => r.status === 'pending').length;
      const totalOrders = new Set(rows.map((r) => r.external_order_id)).size;
      const totalSkuLines = new Set(rows.map((r) => `${r.location_code}__${r.sku_code}`)).size;
      // "today"/"tomorrow"/"27 Sept" for the done banner's "All orders
      // picked for ___" — dateLabel always starts with "Ship by " except
      // for the no-ship-by-date bucket, which reads better with no date
      // phrase at all than literally "for No ship-by date".
      const dateWord = g.date === 'unscheduled' ? '' : ` for ${dateLabel(g.date).replace(/^Ship by /, '')}`;

      const section = document.createElement('div');
      section.className = 'stack';
      section.style.gap = '14px';

      // Once every order for this date is picked, the whole point is a
      // clean "you're done" signal rather than a screen of already-"Done"
      // cards to scroll past — real gap found live: this section used to
      // just vanish outright once finished (a reload dropped it entirely,
      // since a completed pick_batch no longer counts as "active" — see
      // getMyBatches in lib/picker.ts), leaving no confirmation on screen
      // that today's picking was actually done.
      if (remaining === 0) {
        section.innerHTML = `
          <div class="stack" style="gap: 8px;">
            <span class="big-label" style="font-size: 1.1rem;">${escapeHtml(dateLabel(g.date))}</span>
          </div>
          <div class="banner banner-success">All orders picked${escapeHtml(dateWord)} — new orders will appear here automatically.</div>`;
        return section;
      }

      section.innerHTML = `
        <div class="stack" style="gap: 8px;">
          <span class="big-label" style="font-size: 1.1rem;">${escapeHtml(dateLabel(g.date))}</span>
          <div class="stack" style="flex-direction: row; gap: 16px; flex-wrap: wrap;">
            <span class="pill">${totalOrders} orders</span>
            <span class="pill">${totalSkuLines} SKU lines</span>
            <span class="pill">${remaining} of ${rows.length} left</span>
          </div>
        </div>
        <div class="stack" style="gap: 22px;" data-locations></div>`;

      const container = section.querySelector('[data-locations]') as HTMLElement;
      for (const locGroup of groupByLocation(rows)) container.appendChild(renderLocationSection(locGroup));

      return section;
    }

    function render() {
      const groups = dateGroups();
      if (!groups.length) {
        renderNoBatch();
        return;
      }

      const gateGroups = groups.filter((g) => !g.activated);
      const readyGroups = groups.filter((g) => g.activated && !g.started);
      const workingGroups = groups.filter((g) => g.started);

      let html = lastError ? `<div class="banner banner-danger">${escapeHtml(lastError)}</div>` : '';
      if (gateGroups.length || readyGroups.length) html += `<div class="stack" id="picklists-panel" style="gap: 12px;"></div>`;
      if (workingGroups.length) html += `<div class="stack" id="working-panel" style="gap: 32px; margin-top: 8px;"></div>`;
      app.innerHTML = html;

      const panel = document.getElementById('picklists-panel');
      if (panel) {
        for (const g of gateGroups) panel.appendChild(renderGateCard(g));
        for (const g of readyGroups) panel.appendChild(renderReadyCard(g));
      }

      const working = document.getElementById('working-panel');
      if (working) {
        for (const g of workingGroups) working.appendChild(renderWorkingSection(g));
      }
    }

    function groupByLocation(rows: Row[]): LocationGroup[] {
      const groups: LocationGroup[] = [];
      for (const r of rows) {
        const key = `${r.zone_name ?? '—'}__${r.location_code}`;
        let g = groups.find((g) => g.key === key);
        if (!g) {
          g = { key, zone: r.zone_name ?? '—', bin: r.location_code, rows: [] };
          groups.push(g);
        }
        g.rows.push(r);
      }
      return groups;
    }

    function renderLocationSection(locGroup: LocationGroup): HTMLElement {
      const section = document.createElement('div');
      section.className = 'stack';
      section.style.gap = '8px';
      section.innerHTML = `<div class="eyebrow">Zone ${locGroup.zone} · Bin ${locGroup.bin}</div>`;

      const skuGroups: SkuGroup[] = [];
      for (const r of locGroup.rows) {
        let sg = skuGroups.find((sg) => sg.sku_code === r.sku_code);
        if (!sg) {
          sg = { sku_code: r.sku_code, sku_name: r.sku_name, image_url: r.image_url, rows: [] };
          skuGroups.push(sg);
        }
        sg.rows.push(r);
      }
      for (const sg of skuGroups) {
        const groupKey = `${locGroup.bin}__${sg.sku_code}`;
        section.appendChild(renderSkuGroup(sg, groupKey));
      }
      return section;
    }

    function renderSkuGroup(sg: SkuGroup, groupKey: string): HTMLElement {
      const required = sg.rows.reduce((sum, r) => sum + r.quantity_required, 0);
      const picked = sg.rows.reduce((sum, r) => sum + r.quantity_picked, 0);
      const pendingRows = sg.rows.filter((r) => r.status === 'pending');
      const done = pendingRows.length === 0;
      // NOT required - picked: if an earlier round already resolved one of
      // this card's order-lines as a short pick (quantity_picked left at 0,
      // status no longer 'pending'), that line's full quantity_required
      // still counts toward `required` above but contributes nothing to
      // `picked` — so required-picked overstates what's still actually
      // pickable through this button. pendingIds (submitted below) only
      // ever covers pendingRows, so the input's own ceiling has to match
      // that same subset or the server's real total-required check (which
      // sums quantity_required over exactly those pending tasks) rejects a
      // quantity the picker was correctly shown as "still needed".
      const remainingNeeded = pendingRows.reduce((sum, r) => sum + r.quantity_required, 0);
      const reasonState = pendingReasonFor[groupKey];

      // Which orders need this SKU, collapsed into a count instead of
      // listing every order id — a card for a popular SKU could otherwise
      // list a dozen order numbers a picker has no use for. "Multi" here
      // means multiple units of *this* SKU on that order, not multiple
      // distinct products (that's a packing-side concept). Multi-unit orders
      // get their own highlighted badges (one per order, "N×") instead of
      // folding into the plain-text count — a picker needs to know exactly
      // how many to set aside for each one, not just that some exist.
      const singleUnitCount = sg.rows.filter((r) => r.quantity_required === 1).length;
      const multiUnitQtys = sg.rows.filter((r) => r.quantity_required > 1).map((r) => r.quantity_required).sort((a, b) => b - a);
      const singleUnitText = singleUnitCount ? `${singleUnitCount} single-unit order${singleUnitCount > 1 ? 's' : ''}` : '';
      const multiUnitBadges = multiUnitQtys.map((q) => `<span class="status-pill status-warning">${q}×</span>`).join(' ');

      // Notes are the exception worth naming an order for — everything
      // routine stays in the aggregate count above.
      const notedRows = sg.rows.filter((r) => r.order_notes);
      const notesHtml = notedRows
        .map((r) => `<strong style="color: var(--warning-fg);">${escapeHtml(r.external_order_id)} — ${escapeHtml(r.order_notes!)}</strong>`)
        .join(' · ');

      let actionHtml: string;
      if (done) {
        const short = picked < required;
        if (short) {
          // A short/damaged outcome is exactly when knowing *which* order(s)
          // matters — named here even though the routine line above stays aggregate.
          const shortRows = sg.rows.filter((r) => r.status !== 'pending' && r.quantity_picked < r.quantity_required);
          const shortDetail = shortRows.map((r) => `${escapeHtml(r.external_order_id)} (got ${r.quantity_picked}/${r.quantity_required})`).join(' · ');
          actionHtml = `<div class="banner banner-warning" style="margin-top: 10px; padding: 8px 12px;">Short — ${required - picked} unresolved${shortDetail ? `<div style="font-size: 0.72rem; margin-top: 4px; font-weight: 400;">${shortDetail}</div>` : ''}</div>`;
        } else {
          actionHtml = `<div class="banner banner-success" style="margin-top: 10px; padding: 8px 12px;">Done</div>`;
        }
      } else if (reasonState) {
        actionHtml = `
          <div class="stack" style="margin-top: 10px; gap: 8px; border-top: 1px dashed var(--border); padding-top: 10px;">
            <span style="font-size: 0.85rem; font-weight: 600;">
              ${reasonState.quantity > 0 ? `Picking ${reasonState.quantity} of ${remainingNeeded} — why not the rest?` : `Reporting all ${remainingNeeded} — why?`}
            </span>
            <select class="reason-select">
              <option value="damaged">Damaged — none usable</option>
              <option value="low_stock">Low stock — not enough available</option>
              <option value="other">Other</option>
            </select>
            <input type="text" class="reason-note" placeholder="Add a note (optional)" style="display:none;" />
            <div class="row" style="gap: 8px;">
              <button class="btn btn-ghost" data-action="cancel-reason" style="flex:1;">Cancel</button>
              <button class="btn btn-primary" data-action="submit-reason" style="flex:1;">Submit</button>
            </div>
          </div>`;
      } else {
        actionHtml = `
          <div class="row" style="margin-top: 10px; gap: 8px; align-items: center;">
            ${qtyStepperHtml(`<input type="number" class="qty-input" min="0" max="${remainingNeeded}" value="${remainingNeeded}" style="width: 64px; flex: 0 0 auto; min-height: 44px; text-align: center;" />`)}
            <button class="btn btn-primary" data-action="pick" style="flex: 1;">Picked</button>
          </div>
          <p style="font-size: 0.72rem; margin: 4px 0 0;">If you didn't get the full amount, lower the number before marking done — you'll be asked why.</p>
          <button class="btn btn-ghost" data-action="issue" style="margin-top: 4px;">Report issue</button>`;
      }

      const el = document.createElement('div');
      el.className = 'card';
      el.innerHTML = `
        <div class="row" style="align-items: center; gap: 14px;">
          ${sg.image_url ? `<img class="thumb thumb-lg" src="${sg.image_url}" alt="" />` : '<div class="thumb thumb-lg"></div>'}
          <div class="stack" style="gap: 2px; flex: 1; min-width: 0;">
            <span class="qty" style="font-size: 1.05rem;">${escapeHtml(sg.sku_code)}</span>
            <span style="font-size: 0.78rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${escapeHtml(sg.sku_name)}</span>
          </div>
        </div>
        <div class="row" style="gap: 24px; margin-top: 10px;">
          <div class="stack" style="gap: 0;">
            <span style="font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted);">Required</span>
            <span class="qty" style="font-size: 1.15rem;">${required}</span>
          </div>
          <div class="stack" style="gap: 0;">
            <span style="font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted);">Picked</span>
            <span class="qty" style="font-size: 1.15rem; ${done && picked < required ? 'color: var(--danger);' : ''}">${picked}</span>
          </div>
        </div>
        ${singleUnitText ? `<div style="font-size: 0.72rem; color: var(--muted); margin-top: 6px;">${singleUnitText}</div>` : ''}
        ${multiUnitBadges ? `<div class="row" style="gap: 4px; flex-wrap: wrap; align-items: center; margin-top: 6px;"><span style="font-size: 0.72rem; color: var(--muted);">Multi-unit:</span> ${multiUnitBadges}</div>` : ''}
        ${notesHtml ? `<div style="font-size: 0.72rem; margin-top: 4px;">${notesHtml}</div>` : ''}
        ${actionHtml}`;

      const pendingIds = pendingRows.map((r) => r.pick_task_id);

      wireQtySteppers(el);

      if (!done && !reasonState) {
        el.querySelector('[data-action="pick"]')?.addEventListener('click', () => {
          const input = el.querySelector('.qty-input') as HTMLInputElement;
          const qty = Number(input.value);
          if (qty < remainingNeeded) {
            pendingReasonFor[groupKey] = { pickTaskIds: pendingIds, quantity: qty };
            render();
          } else {
            submitPick(pendingIds, qty);
          }
        });
        el.querySelector('[data-action="issue"]')?.addEventListener('click', () => {
          pendingReasonFor[groupKey] = { pickTaskIds: pendingIds, quantity: 0 };
          render();
        });
      } else if (reasonState) {
        const select = el.querySelector('.reason-select') as unknown as HTMLSelectElement;
        const noteInput = el.querySelector('.reason-note') as HTMLInputElement;
        select.addEventListener('change', () => {
          noteInput.style.display = select.value === 'other' ? 'block' : 'none';
        });
        el.querySelector('[data-action="cancel-reason"]')?.addEventListener('click', () => {
          delete pendingReasonFor[groupKey];
          render();
        });
        el.querySelector('[data-action="submit-reason"]')?.addEventListener('click', () => {
          const reasonValue = select.value;
          const note = noteInput.value.trim();
          const { pickTaskIds, quantity } = reasonState;
          delete pendingReasonFor[groupKey];

          // "Damaged — none usable" only takes the destructive full
          // write-off path when nothing was actually picked — if some units
          // were picked (quantity > 0) the reason is just an annotation on
          // an otherwise ordinary short pick, not an inventory damage claim.
          if (reasonValue === 'damaged' && quantity === 0) {
            submitDamaged(pickTaskIds, note ? `Damaged — none usable: ${note}` : 'Damaged — none usable');
          } else {
            const label =
              reasonValue === 'damaged'
                ? note ? `Damaged (partial): ${note}` : 'Damaged (partial)'
                : reasonValue === 'low_stock'
                  ? note ? `Low stock — not enough available: ${note}` : 'Low stock — not enough available'
                  : note ? `Other: ${note}` : 'Other';
            submitPick(pickTaskIds, quantity, label);
          }
        });
      }

      return el;
    }

    // A pick_task_id is unique across every batch this picker has, so this
    // just needs to find whichever entry currently holds it — the caller
    // never needs to know (or care) which batch that is.
    function findRow(pickTaskId: string): Row | null {
      for (const entry of batchList) {
        const row = entry.rows.find((r) => r.pick_task_id === pickTaskId);
        if (row) return row;
      }
      return null;
    }

    function snapshotAll(): Map<string, Row[]> {
      return new Map(batchList.map((e) => [e.batchId, e.rows.map((r) => ({ ...r }))]));
    }

    function restoreSnapshot(snapshot: Map<string, Row[]>) {
      for (const entry of batchList) {
        const snap = snapshot.get(entry.batchId);
        if (snap) entry.rows = snap;
      }
    }

    function applyBatchUpdates(batches: Array<{ batchId: string; rows: Row[] }>) {
      for (const b of batches) {
        const entry = batchList.find((e) => e.batchId === b.batchId);
        if (entry) entry.rows = b.rows;
      }
    }

    // Mutates whichever rows these ids point to (which may span more than
    // one batch — see render()) and re-renders BEFORE the network call
    // resolves, so the tap feels instant. Rolled back on failure.
    function applyOptimisticPick(ids: string[], totalQuantity: number) {
      let remaining = totalQuantity;
      for (const id of ids) {
        const row = findRow(id);
        if (!row) continue;
        const alloc = Math.min(remaining, row.quantity_required);
        remaining -= alloc;
        row.quantity_picked = alloc;
        row.status = alloc >= row.quantity_required ? 'picked' : 'short';
      }
    }

    function applyOptimisticDamaged(ids: string[]) {
      for (const id of ids) {
        const row = findRow(id);
        if (row) row.status = 'damaged';
      }
    }

    async function submitPick(pickTaskIds: string[], quantity: number, reason?: string) {
      const snapshot = snapshotAll();
      applyOptimisticPick(pickTaskIds, quantity);
      lastError = '';
      render();
      try {
        const res = await api('/api/picker/mark-picked', { pickTaskIds, quantity, reason });
        applyBatchUpdates(res.batches ?? []);
        render();
      } catch (err) {
        restoreSnapshot(snapshot);
        lastError = (err as Error).message;
        render();
      }
    }

    async function submitDamaged(pickTaskIds: string[], notes: string) {
      const snapshot = snapshotAll();
      applyOptimisticDamaged(pickTaskIds);
      lastError = '';
      render();
      try {
        const res = await api('/api/picker/report-damaged', { pickTaskIds, notes });
        applyBatchUpdates(res.batches ?? []);
        render();
      } catch (err) {
        restoreSnapshot(snapshot);
        lastError = (err as Error).message;
        render();
      }
    }

    boot();
  </script>
</Base>
