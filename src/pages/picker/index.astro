---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
---

<Base title="Pick list">
  <div class="screen">
    <TopBar section="Picking">
      <a href="/picker" class="pill tab-pill active" style="text-decoration: none;">Pick<span class="badge-dot" id="badge-pick"></span></a>
      <a href="/packer" class="pill tab-pill" style="text-decoration: none;">Pack<span class="badge-dot" id="badge-pack"></span></a>
      <span class="pill" id="user-pill">…</span>
    </TopBar>

    <div id="app" class="stack" style="flex: 1;">
      <p>Loading…</p>
    </div>
  </div>

  <script>
    interface Row {
      pick_task_id: string;
      zone_name: string | null;
      location_code: string;
      sku_code: string;
      sku_name: string;
      image_url: string | null;
      external_order_id: string;
      order_source: string;
      quantity_required: number;
      quantity_picked: number;
      status: string;
    }

    interface SkuGroup {
      sku_code: string;
      sku_name: string;
      image_url: string | null;
      rows: Row[];
    }

    const app = document.getElementById('app')!;
    const userPill = document.getElementById('user-pill')!;
    let warehouseId = '';
    let batchId: string | null = null;
    let rows: Row[] = [];
    let lastError = '';
    let pollTimer: ReturnType<typeof setInterval> | null = null;

    // Orders keep arriving and admin keeps creating batches — a picker sitting
    // on the "no batches"/"picking complete" screen should see new work show up
    // on its own, not have to keep tapping "check again".
    function stopPolling() {
      if (pollTimer !== null) {
        clearInterval(pollTimer);
        pollTimer = null;
      }
    }

    function pollForBatch() {
      stopPolling();
      pollTimer = setInterval(async () => {
        if (document.hidden) return;
        const claimed = await api('/api/picker/claim-batch', { warehouseId });
        if (claimed.batchId) {
          stopPolling();
          batchId = claimed.batchId;
          rows = claimed.rows ?? [];
          render();
        }
      }, 8000);
    }

    // Badge on the "Pack" tab so a picker knows work is waiting there without
    // switching over to check — packers never see price here or on that tab.
    function pollWorkBadge() {
      setInterval(async () => {
        if (document.hidden) return;
        try {
          const summary = await api(`/api/packer/work-summary?warehouseId=${warehouseId}`);
          document.getElementById('badge-pack')?.classList.toggle('show', summary.packable > 0);
        } catch {
          // Badge is a convenience, not load-bearing — ignore transient failures.
        }
      }, 10000);
    }

    async function api(path: string, body?: unknown) {
      const res = await fetch(path, {
        method: body === undefined ? 'GET' : 'POST',
        headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      });
      const data: any = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
      return data;
    }

    async function boot() {
      const me = await api('/api/auth/me');
      if (!me.user) {
        window.location.href = '/login';
        return;
      }
      if (me.user.role !== 'packer') {
        app.innerHTML = `<p>This account is a "${me.user.role}" — picking needs a packer login.</p>`;
        return;
      }
      userPill.textContent = me.user.name;
      warehouseId = me.user.warehouseId;
      pollWorkBadge();

      const claimed = await api('/api/picker/claim-batch', { warehouseId });
      batchId = claimed.batchId;
      rows = claimed.rows ?? [];
      if (!batchId) {
        renderNoBatch();
        return;
      }
      stopPolling();
      render();
    }

    function renderNoBatch() {
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center; text-align:center;">
          <div class="big-label">No batches</div>
          <p>Nothing assigned right now — this checks automatically, or tap to check now.</p>
          <button class="btn" id="retry">Check again</button>
        </div>`;
      document.getElementById('retry')?.addEventListener('click', boot);
      pollForBatch();
    }

    // Bulk-pick by SKU, not by order: within one bin, every order that needs
    // the same SKU collapses into one aggregate line ("KTN3 required 7,
    // picked 0/7") instead of one card per order. Zone/bin sectioning is
    // still the outer walking order (unavoidable — the picker can only be in
    // one bin at a time), but the fragmentation this replaces was never
    // about location, it was the same SKU at the same bin showing up once
    // per order. See HANDOFF.md.
    function render() {
      lastError = '';
      const remaining = rows.filter((r) => r.status === 'pending');

      if (!remaining.length) {
        app.innerHTML = `
          <div class="stack" style="flex:1; justify-content:center; text-align:center;">
            <div class="banner banner-success">Picking complete</div>
            <div class="big-label">Go to packing station</div>
            <button class="btn" id="new-batch">Get next batch</button>
          </div>`;
        document.getElementById('new-batch')?.addEventListener('click', boot);
        return;
      }

      const locGroups: Array<{ key: string; zone: string; bin: string; rows: Row[] }> = [];
      for (const r of rows) {
        const key = `${r.zone_name ?? '—'}__${r.location_code}`;
        let g = locGroups.find((g) => g.key === key);
        if (!g) {
          g = { key, zone: r.zone_name ?? '—', bin: r.location_code, rows: [] };
          locGroups.push(g);
        }
        g.rows.push(r);
      }

      const skuLineCount = new Set(rows.map((r) => `${r.location_code}__${r.sku_code}`)).size;
      app.innerHTML = `
        ${errorBanner()}
        <div class="stack" id="summary" style="flex-direction: row; gap: 16px; flex-wrap: wrap;">
          <span class="pill">${new Set(rows.map((r) => r.external_order_id)).size} orders</span>
          <span class="pill">${skuLineCount} SKU lines</span>
          <span class="pill">${remaining.length} of ${rows.length} left</span>
        </div>
        <div class="stack" id="groups"></div>`;

      const groupsEl = document.getElementById('groups')!;
      for (const locGroup of locGroups) {
        const section = document.createElement('div');
        section.className = 'stack';
        section.style.gap = '8px';
        section.innerHTML = `<div class="eyebrow">Zone ${locGroup.zone} · Bin ${locGroup.bin}</div>`;

        const skuGroups: SkuGroup[] = [];
        for (const r of locGroup.rows) {
          let sg = skuGroups.find((sg) => sg.sku_code === r.sku_code);
          if (!sg) {
            sg = { sku_code: r.sku_code, sku_name: r.sku_name, image_url: r.image_url, rows: [] };
            skuGroups.push(sg);
          }
          sg.rows.push(r);
        }
        for (const sg of skuGroups) section.appendChild(renderSkuGroup(sg));
        groupsEl.appendChild(section);
      }
    }

    function renderSkuGroup(sg: SkuGroup): HTMLElement {
      const required = sg.rows.reduce((sum, r) => sum + r.quantity_required, 0);
      const picked = sg.rows.reduce((sum, r) => sum + r.quantity_picked, 0);
      const pendingRows = sg.rows.filter((r) => r.status === 'pending');
      const done = pendingRows.length === 0;
      const remainingNeeded = required - picked;
      const orderCount = new Set(sg.rows.map((r) => r.external_order_id)).size;

      const orderBreakdown = sg.rows
        .map((r) => `${r.external_order_id} ×${r.quantity_required}${r.status !== 'pending' ? ` (got ${r.quantity_picked}, ${r.status})` : ''}`)
        .join(' · ');

      const el = document.createElement('div');
      el.className = 'card';
      el.innerHTML = `
        <div class="row" style="align-items: center; gap: 12px;">
          ${sg.image_url ? `<img class="thumb" src="${sg.image_url}" alt="" />` : '<div class="thumb"></div>'}
          <div class="stack" style="gap: 2px; flex: 1;">
            <span style="font-weight: 600;">${sg.sku_name}</span>
            <span style="font-size: 0.8rem; color: var(--muted);">${sg.sku_code} · ${orderCount} order${orderCount > 1 ? 's' : ''}</span>
          </div>
          <span class="qty">${picked}/${required}</span>
        </div>
        <div style="font-size: 0.72rem; color: var(--muted); margin-top: 6px;">${orderBreakdown}</div>
        ${
          done
            ? `<div class="banner banner-success" style="margin-top: 10px; padding: 8px 12px;">Done</div>`
            : `<div class="row" style="margin-top: 10px; gap: 8px; align-items: center;">
                 <input type="number" class="qty-input" min="0" max="${remainingNeeded}" value="${remainingNeeded}" style="width: 90px; flex: 0 0 auto; min-height: 52px; text-align: center;" />
                 <button class="btn btn-primary" data-action="pick" style="flex: 1;">Mark done</button>
               </div>
               <button class="btn btn-ghost" data-action="issue" style="margin-top: 8px;">Report issue</button>`
        }`;

      const pendingIds = pendingRows.map((r) => r.pick_task_id);
      el.querySelector('[data-action="pick"]')?.addEventListener('click', async () => {
        const input = el.querySelector('.qty-input') as HTMLInputElement;
        const qty = Number(input.value);
        await handleMarkPicked(pendingIds, qty);
      });
      el.querySelector('[data-action="issue"]')?.addEventListener('click', () => {
        renderIssueSheet(sg, pendingIds, remainingNeeded);
      });
      return el;
    }

    async function handleMarkPicked(pickTaskIds: string[], quantity: number) {
      try {
        const res = await api('/api/picker/mark-picked', { batchId, pickTaskIds, quantity });
        rows = res.rows;
        render();
      } catch (err) {
        lastError = (err as Error).message;
        render();
      }
    }

    function renderIssueSheet(sg: SkuGroup, pendingIds: string[], remainingNeeded: number) {
      app.innerHTML = `
        <div class="stack" style="flex:1; justify-content:center; text-align:center;">
          <span class="eyebrow">${sg.sku_name}</span>
          <p>Needed: ${remainingNeeded}</p>
          <p>If only some units are damaged, cancel this and enter how many you actually got in the quantity box instead — the rest is automatically logged as short.</p>
          <div class="stack">
            <button class="btn btn-danger" id="damaged">Damaged — none usable</button>
          </div>
          <button class="btn btn-ghost" id="cancel">Cancel</button>
        </div>`;

      document.getElementById('damaged')?.addEventListener('click', async () => {
        try {
          rows = await api('/api/picker/report-damaged', { batchId, pickTaskIds: pendingIds });
          render();
        } catch (err) {
          lastError = (err as Error).message;
          render();
        }
      });
      document.getElementById('cancel')?.addEventListener('click', render);
    }

    function errorBanner() {
      return lastError ? `<div class="banner banner-danger">${lastError}</div>` : '';
    }

    boot();
  </script>
</Base>
