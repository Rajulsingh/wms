---
import Base from '../../layouts/Base.astro';
import { getDb } from '../../lib/db';
import { getAccountBySetupToken } from '../../lib/org-accounts';

const db = getDb();
const token = Astro.url.searchParams.get('token') ?? '';
const account = token ? await getAccountBySetupToken(db, token) : null;
---

<Base title="Set your password">
  <div class="auth-shell">
    <div class="auth-card stack" style="max-width: 440px;">
      <h1 class="big-label" style="font-size: 1.5rem;">Set your password</h1>
      {
        !account ? (
          <p>This setup link is invalid or has expired. Ask whoever set up your account for a new one.</p>
        ) : (
          <>
            <p style="margin-top: -8px;">For {account.email} — this finishes setting up your ecomglider WMS account.</p>
            <form id="password-form" class="stack">
              <div class="stack" style="gap: 6px;">
                <label for="password">Password</label>
                <input id="password" type="password" autocomplete="new-password" minlength="8" required />
              </div>
              <div id="error" class="banner banner-danger" style="display: none;"></div>
              <button type="submit" class="btn btn-primary">Set password and continue</button>
            </form>
          </>
        )
      }
    </div>
  </div>

  {
    account && (
      <script define:vars={{ token }}>
        const form = document.getElementById('password-form');
        const errorBox = document.getElementById('error');

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errorBox.style.display = 'none';
          const password = document.getElementById('password').value;

          const res = await fetch('/api/onboarding/set-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token, password })
          });

          if (!res.ok) {
            const data = await res.json().catch(() => ({ error: 'Could not set password' }));
            errorBox.textContent = data.error ?? 'Could not set password';
            errorBox.style.display = 'block';
            return;
          }

          window.location.href = '/onboarding/warehouse';
        });
      </script>
    )
  }
</Base>
