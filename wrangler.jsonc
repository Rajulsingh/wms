{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-18",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "wms",
	"main": "src/worker.ts",
	// Runs automatically before `wrangler deploy`/`wrangler dev` — added after
	// a real incident: several passes' worth of work (schedule-pickup, the
	// packer station-assignment change, the picker over-pick fix) were
	// "deployed" via `wrangler deploy` alone, which bundles `main` fresh but
	// does NOT rebuild `./dist` — so the deploy silently kept serving
	// whatever `astro build` had last produced, missing everything newer.
	// This makes a stale build structurally impossible instead of relying on
	// remembering to run `astro build` first every time. See HANDOFF.md.
	"build": {
		"command": "npm run build"
	},
	// Cloudflare Cron Triggers always run in UTC — there's no timezone
	// setting. The warehouse only does live picking/packing ~9:00 AM-2:00 PM
	// IST (Amazon Easy Ship's own cutoff), so checking Amazon every 5 minutes
	// outside that window is pure waste. The precise window needed 3 cron
	// expressions (IST = UTC+5:30 doesn't land on a whole hour), but the
	// account's Workers Free plan caps cron triggers at 5 *total, shared
	// across every Worker on the account* — 3 new ones alone exceeded it
	// (confirmed by a real failed deploy, not assumed). Collapsed to one
	// expression, hours 3-8 UTC = 8:30 AM-2:30 PM IST — slightly wider than
	// asked (30 min earlier/later on each end) rather than narrower, so nothing
	// near the cutoff gets missed. An order placed overnight isn't missed
	// either way — the sync job's own 24h lookback (sync-job.ts) picks it up
	// on the first run. Revisit with the 3-expression version (see git log)
	// if the account ever moves to Workers Paid (1,000 cron trigger limit).
	// See HANDOFF.md.
	"triggers": {
		"crons": ["*/5 3-8 * * *"]
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wms-db",
			"database_id": "d71d4717-e454-4fb6-ad12-34811583b577"
		}
	],
	// Returns intake photos (label + product, see lib/returns.ts) — private,
	// served back out through an auth-gated API route, never a public bucket
	// URL. Needs R2 enabled on the Cloudflare account once (Dashboard -> R2)
	// before `wrangler r2 bucket create wms-returns` can run — see HANDOFF.md.
	"r2_buckets": [
		{
			"binding": "RETURNS_IMAGES",
			"bucket_name": "wms-returns"
		}
	]
}